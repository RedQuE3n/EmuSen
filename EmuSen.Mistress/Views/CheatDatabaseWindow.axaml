<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Mistress.Views.CheatDatabaseWindow"
        Title="Cheat Database"
        Width="820" Height="620"
        MinWidth="640" MinHeight="480">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="EmuSen ships no cheat data. Point this at a cheat folder you already have - a RetroArch cheats folder works as-is - or download one."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="Cheat Folder" FontWeight="Bold" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <TextBox x:Name="DirectoryBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="(default)" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseClick" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ActiveCheatsButton" Content="Active Cheats..." Click="OnActiveCheatsClick" />
                    <!-- Two-stage on purpose: the first click only reports
                         what would go - see EmuSen_Settings_Reference.md §4.16. -->
                    <Button x:Name="PruneButton" Content="Prune Unsupported" Click="OnPruneClick" />
                    <Button x:Name="DownloadButton" Content="Download from libretro" Click="OnDownloadClick" />
                    <Button Content="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CC BY-SA 4.0 requires attribution, and the codes were
             aggregated from elsewhere - both belong in front of the user
             before they download, not buried in a doc. -->
        <Border DockPanel.Dock="Bottom"
                Padding="10"
                Margin="0,12,0,0"
                CornerRadius="4"
                Background="{DynamicResource SystemChromeLowColor}">
            <TextBlock x:Name="AttributionText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="Gray" />
        </Border>

        <!-- Systems on the left, that system's games on the right - see
             EmuSen_Settings_Reference.md §4.14. -->
        <Grid ColumnDefinitions="2*,12,3*">

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Installed" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox x:Name="SystemsList" SelectionChanged="OnSystemSelected" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="GamesHeaderText" Text="Games" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Top"
                         x:Name="GameFilterBox"
                         PlaceholderText="Filter games..."
                         Margin="0,0,0,6" />
                <Button DockPanel.Dock="Bottom"
                        x:Name="LoadGameButton"
                        Content="Load into Active Cheats"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,6,0,0"
                        IsEnabled="False"
                        Click="OnLoadGameClick" />
                <ListBox x:Name="GamesList"
                         SelectionChanged="OnGameSelected"
                         DoubleTapped="OnGameActivated" />
            </DockPanel>

        </Grid>

    </DockPanel>

</Window>
