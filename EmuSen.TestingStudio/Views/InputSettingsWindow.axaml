<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.TestingStudio.Views.InputSettingsWindow"
        Title="Controller Settings"
        Width="520" Height="480"
        CanResize="False">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="Click Rebind Key then press a keyboard key, or Rebind Pad then press a button on your controller. Escape cancels a key rebind in progress."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Reset to Defaults" Click="OnResetClick" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel x:Name="BindingsPanel" Spacing="6" />
        </ScrollViewer>

    </DockPanel>

</Window>
