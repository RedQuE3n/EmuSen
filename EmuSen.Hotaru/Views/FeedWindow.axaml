<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Hotaru.Views.FeedWindow"
        Title="DianaOS feed"
        Width="512" Height="480"
        MinWidth="256" MinHeight="240"
        Background="{DynamicResource LunaVoid}">

    <Image x:Name="FeedImage"
           Stretch="Uniform"
           RenderOptions.BitmapInterpolationMode="None" />

</Window>
