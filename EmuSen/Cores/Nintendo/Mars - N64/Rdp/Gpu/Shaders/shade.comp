#version 450

// One invocation per pixel of the multiple, walking its tile's rows in the order they were drawn - see Mars_Gpu.md §5 and §6.
// Every stage is Rdp's C# restated; the names in comments are the methods ported. Integers only, and they wrap.
layout(local_size_x = 8, local_size_y = 8) in;

// The memory at the multiple in sixteen-bit words of console order: the word in the low half, its two hidden bits above it.
layout(std430, set = 0, binding = 0) buffer Memory { uint memory[]; };
layout(std430, set = 0, binding = 1) readonly buffer Primitives { uint primitives[]; };
layout(std430, set = 0, binding = 2) readonly buffer Rows { uint rows[]; };
layout(std430, set = 0, binding = 3) readonly buffer TileOffsets { uint tileOffsets[]; };
layout(std430, set = 0, binding = 4) readonly buffer TileRows { uint tileRows[]; };
layout(std430, set = 0, binding = 5) readonly buffer TextureMemory { uint tmem[]; };
layout(std430, set = 0, binding = 6) readonly buffer Tiles { uint tiles[]; };
layout(std430, set = 0, binding = 7) readonly buffer Divide { int divideTable[]; };

layout(push_constant) uniform Push
{
    uint imageWord;
    uint width;
    uint pixelWords;
    uint memoryWords;
    uint tileX0;
    uint tileY0;
    uint tilesWide;
    uint tilesHigh;
    uint depthWord;
} push;

const uint PRIMITIVE_WORDS = 80;
const uint ROW_WORDS = 32;
const uint TMEM_WORDS = 2048u;
const uint TILE_WORDS = 32u;
const uint KIND_ONE_CYCLE = 0;
const uint KIND_TWO_CYCLE = 1;
const uint KIND_COPY = 2;
const uint KIND_FILL = 3;

// Primitive record, as GpuRasteriser lays it out.
const uint P_KIND = 0, P_FILL = 1, P_FLAGS = 2, P_MODES = 3, P_COMBINE = 4, P_BLEND = 5;
const uint P_PRIMITIVE = 6, P_ENVIRONMENT = 10, P_BLEND_COLOR = 14, P_FOG = 18, P_KEY_CENTER = 22, P_KEY_SCALE = 26, P_KEY_WIDTH = 30;
const uint P_K4 = 33, P_K5 = 34, P_PRIMITIVE_LOD = 35, P_PRIMITIVE_Z = 36, P_DELTA_Z = 37, P_DELTA_Z_ENCODED = 38;
const uint P_TEXTURE = 39;
const uint P_STEPS = 40, P_SHADE_DX = 48, P_SHADE_DY = 52, P_DEPTH_DX = 56, P_DEPTH_DY = 57;
const uint P_TMEM = 58, P_TILES = 59, P_TILE = 60, P_MAXLEVEL = 61, P_MINLEVEL = 62, P_K0 = 64;
const uint P_COMBINE1 = 68, P_BLEND2 = 69, P_TEXEL_LEVEL = 70, P_DOWNSTEP = 72;

const uint T_TEXEL0 = 1u << 0, T_TEXEL1 = 1u << 1, T_PERSPECTIVE = 1u << 2, T_SAMPLE_FOUR = 1u << 3, T_PALETTE = 1u << 4;
const uint T_PALETTE_IA = 1u << 5, T_MID_TEXEL = 1u << 6, T_BILINEAR = 1u << 7, T_DETAIL = 1u << 8, T_SHARPEN = 1u << 9;
const uint T_LOD = 1u << 10, T_CONVERT_ONE = 1u << 11, T_LOD_FRACTION = 1u << 12;
const uint T_BILINEAR2 = 1u << 13;

const uint ATTRIBUTE_S = 5u, ATTRIBUTE_T = 6u, ATTRIBUTE_W = 7u;

const uint F_KEY = 1u << 0, F_COVERAGE_TIMES_ALPHA = 1u << 1, F_ALPHA_FROM_COVERAGE = 1u << 2, F_ALPHA_COMPARE = 1u << 3;
const uint F_DITHER_ALPHA = 1u << 4, F_ANTIALIAS = 1u << 5, F_COLOR_ON_COVERAGE = 1u << 6, F_FORCE_BLEND = 1u << 7;
const uint F_IMAGE_READ = 1u << 8, F_DEPTH_UPDATE = 1u << 9, F_DEPTH_COMPARE = 1u << 10, F_PRIMITIVE_DEPTH = 1u << 11;
const uint F_SCISSOR_FIELD = 1u << 12, F_MAJOR_ON_LEFT = 1u << 13, F_DITHER = 1u << 14, F_BLEND_SHIFTS = 1u << 15;

// Row record.
const uint R_PRIMITIVE = 0, R_Y = 1, R_LEFT = 2, R_RIGHT = 3, R_VALUES = 4, R_EDGE_LEFT = 12, R_EDGE_RIGHT = 16, R_INVALID = 20;
const uint R_NEXT = 21, R_SPAN = 24;
const uint S_NEXT_ROW_DRAWN = 1u << 0, S_LONG_SPAN = 1u << 1, S_MID_SPAN = 1u << 2, S_ONE_BEFORE_MID = 1u << 3, S_LENGTH_THREE = 1u << 4;

const int MAGIC_SQUARE[16] = int[16](0, 6, 1, 7, 4, 2, 5, 3, 3, 5, 2, 4, 7, 1, 6, 0);
const int BAYER[16] = int[16](0, 4, 1, 5, 4, 0, 5, 1, 3, 7, 2, 6, 7, 3, 6, 2);

uint pb;
uint rb;

// What the stages share, as the C# keeps them in fields.
ivec4 shade;
ivec4 combined;
ivec4 texel0;
ivec4 texel1;
int lodFraction;
uint tmemBase;
uint tileBase;
uint texture_;
bool tflag(uint f) { return (texture_ & f) != 0u; }
ivec4 pixel;
ivec4 memoryColor;
int blenderShadeAlpha;
int blendShiftA;
int blendShiftB;

uint flags;
bool flag(uint f) { return (flags & f) != 0u; }
int pint(uint i) { return int(primitives[pb + i]); }
ivec4 pcolor(uint i) { return ivec4(pint(i), pint(i + 1u), pint(i + 2u), pint(i + 3u)); }

// Rdp.FillPixel: a word takes the half of the fill colour its address holds, and its hidden bits follow its low bit.
uint filled(uint word, uint color)
{
    uint value = (word & 1u) == 0u ? color >> 16 : color & 0xFFFFu;
    return value | ((value & 1u) * 3u) << 16;
}

// Rdp.RowCoverage for one column.
int coverageMask(int x, int left, int right)
{
    int mask = 0xFF;
    uint invalid = rows[rb + R_INVALID];

    for (int sub = 0; sub < 4; sub++)
    {
        int samples = 0xA >> (sub & 1);
        int shift = (sub - 2) & 4;
        int cleared = ~(samples << shift) & 0xFF;

        if ((invalid & (1u << sub)) != 0u) { mask &= cleared; continue; }

        int leftEdge = int(rows[rb + R_EDGE_LEFT + uint(sub)]), rightEdge = int(rows[rb + R_EDGE_RIGHT + uint(sub)]);
        int leftPixel = leftEdge >> 3, rightPixel = rightEdge >> 3;

        if (x <= leftPixel) mask &= cleared;
        if (x >= rightPixel) mask &= cleared;

        int leftSamples = (0x0F >> (((leftEdge & 7) + 1) >> 1)) & samples;
        int rightSamples = (0xF0 >> (((rightEdge & 7) + 1) >> 1)) & samples;

        if (rightPixel > leftPixel)
        {
            if (x == leftPixel) mask |= (leftSamples << shift) & 0xFF;
            if (x == rightPixel) mask |= (rightSamples << shift) & 0xFF;
        }
        else if (rightPixel == leftPixel && x == leftPixel)
        {
            mask |= ((leftSamples & rightSamples) << shift) & 0xFF;
        }
    }

    return mask;
}

// Rdp.BuildCoverageOffsets, computed where the C# tabulates.
ivec2 coverageOffset(int mask)
{
    int samples = (mask & 0x5) | ((mask & 0x5A) << 4) | ((mask & 0xA0) << 8);

    int row = 0;
    while (row < 3 && (samples & (0xF000 >> (row * 4))) == 0) row++;
    if ((samples & (0xF000 >> (row * 4))) == 0) row = 0;

    int columns = (samples >> (12 - row * 4)) & 0xF;
    int column = columns == 0 ? 0 : 3 - findMSB(columns);
    return ivec2(column, row);
}

int clamp9(int value)
{
    int top = (value >> 7) & 3;
    return top == 2 ? 0xFF : top == 3 ? 0 : value & 0xFF;
}

int extend9(int value) { return (value & 0x180) == 0x180 ? value | ~0x1FF : value & 0x1FF; }
int signedMultiplier(int value) { return value | -(value & 0x100); }

int correctShade(int value, int dx, int dy, ivec2 offset, int coverage)
{
    int corrected = coverage == 8 ? value >> 2 : ((value << 2) + offset.x * dx + offset.y * dy) >> 4;
    return clamp9(corrected & 0x1FF);
}

int correctDepth(int z, int dx, int dy, ivec2 offset, int coverage)
{
    int corrected = coverage == 8 ? z >> 3 : ((z << 2) + offset.x * dx + offset.y * dy) >> 5;
    int top = (corrected & 0x60000) >> 17;
    return top == 2 ? 0x3FFFF : top == 3 ? 0 : corrected & 0x3FFFF;
}

// Rdp.TextureMemory as sixteen-bit words; a byte index is masked by the caller, as the C# masks it.
int tmemByte(int at) { uint w = tmem[tmemBase + uint((at >> 1) & 0x7FF)]; return (at & 1) == 0 ? int(w >> 8) & 0xFF : int(w) & 0xFF; }
int tmemWord(int at) { return int(tmem[tmemBase + uint(at & 0x7FF)]); }

// Rdp.TextureTile, packed four words to a tile by Rdp.RecordTiles.
int tileWord(int tile, uint w) { return int(tiles[tileBase + uint(tile) * 4u + w]); }
int tileFormat(int tile) { return tileWord(tile, 0u) & 7; }
int tileSize(int tile) { return (tileWord(tile, 0u) >> 3) & 3; }
int tileLine(int tile) { return (tileWord(tile, 0u) >> 5) & 0x1FF; }
int tileMemory(int tile) { return (tileWord(tile, 0u) >> 14) & 0x1FF; }
int tilePalette(int tile) { return (tileWord(tile, 0u) >> 23) & 0xF; }
int tileMaskS(int tile) { return (tileWord(tile, 1u) >> 4) & 0xF; }
int tileShiftS(int tile) { return (tileWord(tile, 1u) >> 8) & 0xF; }
int tileMaskT(int tile) { return (tileWord(tile, 1u) >> 12) & 0xF; }
int tileShiftT(int tile) { return (tileWord(tile, 1u) >> 16) & 0xF; }
bool tileMirrorS(int tile) { return (tileWord(tile, 1u) & 2) != 0; }
bool tileMirrorT(int tile) { return (tileWord(tile, 1u) & 8) != 0; }
bool tileClampsS(int tile) { return (tileWord(tile, 1u) & 1) != 0 || tileMaskS(tile) == 0; }
bool tileClampsT(int tile) { return (tileWord(tile, 1u) & 4) != 0 || tileMaskT(tile) == 0; }
int tileSL(int tile) { return tileWord(tile, 2u) & 0xFFF; }
int tileTL(int tile) { return (tileWord(tile, 2u) >> 12) & 0xFFF; }
int tileSH(int tile) { return tileWord(tile, 3u) & 0xFFF; }
int tileTH(int tile) { return (tileWord(tile, 3u) >> 12) & 0xFFF; }
int tileMirrorBitS(int tile) { int m = tileMaskS(tile); return m <= 10 ? m : 10; }
int tileMirrorBitT(int tile) { int m = tileMaskT(tile); return m <= 10 ? m : 10; }
int tileClampLimitS(int tile) { return ((tileSH(tile) >> 2) - (tileSL(tile) >> 2)) & 0x3FF; }
int tileClampLimitT(int tile) { return ((tileTH(tile) >> 2) - (tileTL(tile) >> 2)) & 0x3FF; }

int short_(int v) { return (v << 16) >> 16; }
int fiveToEight(int v) { return ((v << 3) | ((v >> 2) & 7)) & 0xFF; }
ivec4 gray(int v) { return ivec4(v & 0xFF); }

// Rdp.FetchTexel: each format and size from its place in texture memory, formats past four as intensity.
ivec4 fetchTexel(int s, int row, int tile)
{
    int line = tileLine(tile) * row + tileMemory(tile);
    bool odd = (row & 1) != 0;
    int byteSwap = odd ? 4 : 0, wordSwap = odd ? 2 : 0;

    int format = min(tileFormat(tile), 4), size = tileSize(tile);
    int key = (format << 2) | size;

    if (key == 0x0 || key == 0x10)
    {
        int at = (((line << 4) + s) >> 1) ^ byteSwap;
        int v = tmemByte(at & 0xFFF);
        v = (s & 1) != 0 ? v & 0xF : v >> 4;
        return gray(v | (v << 4));
    }
    if (key == 0x1 || key == 0x9 || key == 0x11) return gray(tmemByte(((line << 3) + s ^ byteSwap) & 0xFFF));
    if (key == 0x2)
    {
        int v = tmemWord(((line << 2) + s ^ wordSwap) & 0x7FF);
        return ivec4(fiveToEight(v >> 11), fiveToEight((v >> 6) & 0x1F), fiveToEight((v >> 1) & 0x1F), (v & 1) != 0 ? 0xFF : 0);
    }
    if (key == 0x3)
    {
        int index = ((line << 2) + s ^ wordSwap) & 0x3FF;
        int first = tmemWord(index), second = tmemWord(index | 0x400);
        return ivec4(first >> 8, first & 0xFF, second >> 8, second & 0xFF);
    }
    if (key == 0x4 || key == 0x5)
    {
        int v = tmemByte(((line << 3) + s ^ byteSwap) & 0x7FF);
        if (size == 0) v = (v & 0xF0) | ((v & 0xF0) >> 4);
        return ivec4(v - 0x80, v - 0x80, v, v);
    }
    if (key == 0x6 || key == 0x7)
    {
        int bytes = (line << 3) + s;
        int chroma = tmemWord(((bytes >> 1) ^ wordSwap) & 0x3FF);
        ivec4 t = ivec4((chroma >> 8) - 0x80, (chroma & 0xFF) - 0x80, 0, 0);

        if (size == 2 || (s & 1) != 0) { t.b = t.a = tmemByte(((bytes ^ byteSwap) & 0x7FF) | 0x800); }
        else
        {
            int luma = tmemWord(((((bytes >> 1) ^ wordSwap) & 0x3FF) | 0x400));
            t.b = luma >> 8;
            t.a = ((luma >> 8) & 0xF) | (luma & 0xF0);
        }
        return t;
    }
    if (key == 0x8)
    {
        int at = (((line << 4) + s) >> 1) ^ byteSwap;
        int v = tmemByte(at & 0xFFF);
        v = (s & 1) != 0 ? v & 0xF : v >> 4;
        return gray((tilePalette(tile) << 4) | v);
    }
    if (key == 0xC)
    {
        int at = (((line << 4) + s) >> 1) ^ byteSwap;
        int v = tmemByte(at & 0xFFF);
        v = (s & 1) != 0 ? v & 0xF : v >> 4;
        int intensity = ((v & 0xE) << 4 | (v & 0xE) << 1 | (v & 0xE) >> 2) & 0xFF;
        return ivec4(intensity, intensity, intensity, (v & 1) != 0 ? 0xFF : 0);
    }
    if (key == 0xD)
    {
        int v = tmemByte(((line << 3) + s ^ byteSwap) & 0xFFF);
        int intensity = (v & 0xF0) | ((v & 0xF0) >> 4);
        return ivec4(intensity, intensity, intensity, ((v & 0xF) << 4) | (v & 0xF));
    }
    if (key == 0xE)
    {
        int v = tmemWord(((line << 2) + s ^ wordSwap) & 0x7FF);
        return ivec4(v >> 8, v >> 8, v >> 8, v & 0xFF);
    }

    int v = tmemWord(((line << 2) + s ^ wordSwap) & 0x7FF);
    return ivec4(v >> 8, v & 0xFF, v >> 8, v & 0xFF);
}

ivec4 signedNine(ivec4 c) { return ivec4((c.r << 23) >> 23, (c.g << 23) >> 23, (c.b << 23) >> 23, c.a); }

// Rdp.Converted: the luma plus the chroma through the four conversion constants.
ivec4 converted(ivec4 chroma, int luma)
{
    int k0 = pint(P_K0), k1 = pint(P_K0 + 1u), k2 = pint(P_K0 + 2u), k3 = pint(P_K0 + 3u);
    return ivec4(
        (luma + ((k0 * chroma.g + 0x80) >> 8)) & 0x1FF,
        (luma + ((k1 * chroma.r + k2 * chroma.g + 0x80) >> 8)) & 0x1FF,
        (luma + ((k3 * chroma.r + 0x80) >> 8)) & 0x1FF,
        luma & 0x1FF);
}

int shiftedCoordinate(int c, int sh) { return sh < 11 ? short_(c) >> sh : short_(c << (16 - sh)); }

int clampedCoordinate(int c, bool clamps, bool beyond, int limit)
{
    if (!clamps) return c >> 5;
    if (beyond) return limit;
    return (c & 0x10000) == 0 ? c >> 5 : 0;
}

int maskedCoordinate(int c, int mask, bool mirror, int mirrorBit)
{
    if (mirror && ((c >> mirrorBit) & 1) != 0) c = ~c;
    return c & (0xFFFF >> (16 - mask)) & 0x3FF;
}

// Rdp.PointTexel, after Rdp.Texel has shifted the coordinates and made them relative to the tile.
ivec4 pointTexel(int s, int t, bool beyondS, bool beyondT, int tile, bool bilinear)
{
    s = clampedCoordinate(s, tileClampsS(tile), beyondS, tileClampLimitS(tile));
    t = clampedCoordinate(t, tileClampsT(tile), beyondT, tileClampLimitT(tile));

    if (tileMaskS(tile) != 0) s = maskedCoordinate(s, tileMaskS(tile), tileMirrorS(tile), tileMirrorBitS(tile));
    if (tileMaskT(tile) != 0) t = maskedCoordinate(t, tileMaskT(tile), tileMirrorT(tile), tileMirrorBitT(tile));

    ivec4 texel = fetchTexel(s, t & 0xFF, tile);
    return bilinear ? texel : converted(texel, texel.b);
}

// Rdp.Wrapped: masked and mirrored as for one texel, and the step to the next.
int wrapped(inout int c, int mask, bool mirror, int mirrorBit, int wrapBits)
{
    if (mask == 0) return 1;

    int bits = (0xFFFF >> (16 - mask)) & 0x3FF;
    if (mirror)
    {
        int wrap = (c >> mirrorBit) & 1;
        c = (c ^ -wrap) & bits;
        return ((c - wrap) & bits) == bits ? 0 : 1 - (wrap << 1);
    }

    c &= bits;
    return c == bits ? -(c & wrapBits) : 1;
}

// Rdp.Interpolated: three texels weighted by the triangle the fraction lies in, or all four at the mid-texel.
int interpolated(int t0, int t1, int t2, int t3, int sFraction, int tFraction, bool upper, bool center)
{
    if (center) return (t0 + t1 + t2 + t3 + 2) >> 2;
    if (upper) return t3 + (((0x20 - sFraction) * (t2 - t3) + (0x20 - tFraction) * (t1 - t3) + 0x10) >> 5);
    return t0 + ((sFraction * (t1 - t0) + tFraction * (t2 - t0) + 0x10) >> 5);
}

// Rdp.PaletteIndex: a nibble with the tile's palette number, a byte, or a word's high byte.
int paletteIndex(int s, int row, int tile)
{
    int line = tileLine(tile) * row + tileMemory(tile);
    bool odd = (row & 1) != 0;
    int byteSwap = odd ? 4 : 0, wordSwap = odd ? 2 : 0;
    bool yuv = tileFormat(tile) == 1;
    int size = tileSize(tile);

    if (size == 0 && !yuv)
    {
        int value = tmemByte(((((line << 4) + s) >> 1) ^ byteSwap) & 0x7FF);
        return (tilePalette(tile) << 4) | ((s & 1) != 0 ? value & 0xF : value >> 4);
    }

    if (size >= 2 && !yuv) return tmemWord(((line << 2) + s ^ wordSwap) & 0x3FF) >> 8;

    int bytes = tmemByte(((line << 3) + s ^ byteSwap) & 0x7FF);
    return size == 0 ? (tilePalette(tile) << 4) | (bytes >> 4) : bytes;
}

// Rdp.PaletteColor: the palette's upper half of texture memory, its bank reversed in the upper chroma triangle.
ivec4 paletteColor(int entry, bool upperRg)
{
    int value = tmemWord(0x400 | (upperRg ? entry ^ 3 : entry));
    if (tflag(T_PALETTE_IA)) return ivec4(value >> 8, value >> 8, value >> 8, value & 0xFF);
    return ivec4(fiveToEight(value >> 11), fiveToEight((value >> 6) & 0x1F), fiveToEight((value >> 1) & 0x1F), (value & 1) != 0 ? 0xFF : 0);
}

// Rdp.FourTexels without the second cycle's conversion, which the one-cycle mode never asks for.
ivec4 fourTexels(int s, int t, bool beyondS, bool beyondT, int tile, bool bilinear)
{
    bool clampsS = tileClampsS(tile), clampsT = tileClampsT(tile);
    int sFraction = clampsS && (beyondS || (s & 0x10000) != 0) ? 0 : s & 0x1F;
    int tFraction = clampsT && (beyondT || (t & 0x10000) != 0) ? 0 : t & 0x1F;

    s = clampedCoordinate(s, clampsS, beyondS, tileClampLimitS(tile));
    t = clampedCoordinate(t, clampsT, beyondT, tileClampLimitT(tile));
    int sStep = wrapped(s, tileMaskS(tile), tileMirrorS(tile), tileMirrorBitS(tile), -1);
    int tStep = wrapped(t, tileMaskT(tile), tileMirrorT(tile), tileMirrorBitT(tile), 0xFF);

    int format = tileFormat(tile), size = tileSize(tile);
    bool upper = ((sFraction + tFraction) & 0x20) != 0;
    int sFractionRg = format == 1 ? (sFraction >> 1) | ((s & 1) << 4) : sFraction;
    bool upperRg = ((sFractionRg + tFraction) & 0x20) != 0;

    ivec4 tx[4];
    int row0 = t & 0xFF, row1 = row0 + tStep;

    if (!tflag(T_SAMPLE_FOUR))
    {
        // Rdp.NearestPaletteTexels: one texel's palette entry from all four banks.
        int entry = paletteIndex(s, t, tile) << 2;
        for (int bank = 0; bank < 4; bank++) tx[bank] = paletteColor(entry | bank, upperRg);
    }
    else if (tflag(T_PALETTE))
    {
        // Rdp.PaletteTexels.
        int s1 = s + (format == 1 ? sStep << 1 : sStep);
        tx[0] = paletteColor(paletteIndex(s, row0, tile) << 2, upperRg);
        tx[1] = paletteColor((paletteIndex(s1, row0, tile) << 2) | 1, upperRg);
        tx[2] = paletteColor((paletteIndex(s, row1, tile) << 2) | 2, upperRg);
        tx[3] = paletteColor((paletteIndex(s1, row1, tile) << 2) | 3, upperRg);
    }
    else
    {
        // Rdp.Texels: YUV reads chroma a further step along, and at sixteen bits and above takes luma from the texel itself.
        int s1 = s + sStep;
        tx[0] = fetchTexel(s, row0, tile);
        tx[2] = fetchTexel(s, row1, tile);

        if (format != 1)
        {
            tx[1] = fetchTexel(s1, row0, tile);
            tx[3] = fetchTexel(s1, row1, tile);
        }
        else
        {
            tx[1] = fetchTexel(s1 + sStep, row0, tile);
            tx[3] = fetchTexel(s1 + sStep, row1, tile);
            if (size >= 2)
            {
                ivec4 luma1 = fetchTexel(s1, row0, tile), luma3 = fetchTexel(s1, row1, tile);
                tx[1].ba = luma1.ba;
                tx[3].ba = luma3.ba;
            }
        }
    }

    // Luma crosses to the other corner when the two triangles differ.
    if (upper != upperRg && ((format == 1 && size < 2) || tflag(T_PALETTE)))
    {
        ivec2 a = tx[0].ba, b = tx[1].ba;
        tx[0].ba = tx[3].ba; tx[3].ba = a;
        tx[1].ba = tx[2].ba; tx[2].ba = b;
    }

    if (!bilinear) return converted(upperRg ? tx[3] : tx[0], (upper ? tx[3] : tx[0]).b);

    bool center = tflag(T_MID_TEXEL) && sFraction == 0x10 && tFraction == 0x10;
    bool centerRg = tflag(T_MID_TEXEL) && sFractionRg == 0x10 && tFraction == 0x10;

    return ivec4(
        interpolated(tx[0].r, tx[1].r, tx[2].r, tx[3].r, sFractionRg, tFraction, upperRg, centerRg),
        interpolated(tx[0].g, tx[1].g, tx[2].g, tx[3].g, sFractionRg, tFraction, upperRg, centerRg),
        interpolated(tx[0].b, tx[1].b, tx[2].b, tx[3].b, sFraction, tFraction, upper, center),
        interpolated(tx[0].a, tx[1].a, tx[2].a, tx[3].a, sFraction, tFraction, upper, center));
}

// Rdp.Texel: shifted and made relative to the tile's corner, then sampled at one texel, or at four when filtering or a palette asks.
ivec4 texelAt(int s, int t, int tile, bool bilinear)
{
    s = shiftedCoordinate(s, tileShiftS(tile));
    t = shiftedCoordinate(t, tileShiftT(tile));
    bool beyondS = (s >> 3) >= tileSH(tile), beyondT = (t >> 3) >= tileTH(tile);

    s -= tileSL(tile) << 3;
    t -= tileTL(tile) << 3;

    return tflag(T_SAMPLE_FOUR) || tflag(T_PALETTE) ? fourTexels(s, t, beyondS, beyondT, tile, bilinear) : pointTexel(s, t, beyondS, beyondT, tile, bilinear);
}

// Rdp.Divided.
int divided(int product, int shift)
{
    int range = ((1 << 30) - 1) & -((1 << 29) >> shift);
    int outside = product & range;

    int scaled;
    if (shift != 0xE) { product >>= 13 - shift; scaled = product; }
    else scaled = product << 1;

    int f = (outside == range || outside == 0) ? 0 : ((product & (1 << 29)) == 0 ? 2 << 17 : 1 << 17);
    return (scaled & 0x1FFFF) | f;
}

// Rdp.DividedCoordinates: s and t over w to seventeen bits and two overflow flags.
ivec2 dividedCoordinates(int s, int t, int w)
{
    s >>= 16; t >>= 16; w >>= 16;
    if (!tflag(T_PERSPECTIVE)) return ivec2(short_(s) & 0x1FFFF, short_(t) & 0x1FFFF);

    int f = short_(w) <= 0 ? 2 << 17 : 0;
    int entry = divideTable[w & 0x7FFF];
    int reciprocal = entry >> 4, shift = entry & 0xF;
    return ivec2(divided(short_(s) * reciprocal, shift) | f, divided(short_(t) * reciprocal, shift) | f);
}

int clampCoordinate(int v)
{
    if ((v & 0x40000) != 0) return 0x7FFF;
    if ((v & 0x20000) != 0) return 0x8000;
    int top = v & 0x18000;
    return top == 0x8000 ? 0x7FFF : top == 0x10000 ? 0x8000 : v & 0xFFFF;
}

ivec2 textureCoordinates(int s, int t, int w)
{
    ivec2 d = dividedCoordinates(s, t, w);
    return ivec2(clampCoordinate(d.x), clampCoordinate(d.y));
}

// Rdp.Movement: seventeen-bit coordinates subtracted, a negative difference taken as its complement rather than negated.
int movement(int from, int to)
{
    int difference = ((to << 15) >> 15) - ((from << 15) >> 15);
    return (difference & 0x20000) != 0 ? ~difference & 0x1FFFF : difference;
}

int saturated(int m) { return (m & 0x7FFF) | ((m & 0x1C000) != 0 ? 0x4000 : 0); }

// Rdp.BuildLog2, computed where the C# tabulates it.
int log2of(int i) { return i <= 0 ? 0 : findMSB(i); }

// Rdp.LevelSignals, as level, magnify, distant and fraction.
ivec4 levelSignals(int lod, bool overflow, int maxLevel)
{
    bool plain = !tflag(T_SHARPEN) && !tflag(T_DETAIL);

    if ((lod & 0x4000) != 0 || overflow) return ivec4(0, 0, 1, 0xFF);

    if (lod < 32)
    {
        bool magnifiedDistant = maxLevel == 0;
        int magnified = plain ? (magnifiedDistant ? 0xFF : 0) : ((max(lod, pint(P_MINLEVEL)) << 3) | (tflag(T_SHARPEN) ? 0x100 : 0));
        return ivec4(0, 1, magnifiedDistant ? 1 : 0, magnified);
    }

    int level = log2of((lod >> 5) & 0xFF);
    bool distant = maxLevel == 0 || (lod & 0x6000) != 0 || level >= maxLevel;
    return ivec4(level, 0, distant ? 1 : 0, (plain && distant) ? 0xFF : ((lod << 3) >> level) & 0xFF);
}

// Rdp.LevelOfDetail: the larger of s's and t's movement gives the tile and the fraction.
ivec2 levelOfDetail(int nearS, int nearT, int nearW, int farS, int farT, int farW, int tile, int maxLevel)
{
    ivec2 n = dividedCoordinates(nearS, nearT, nearW);
    ivec2 f = dividedCoordinates(farS, farT, farW);

    bool overflow = ((n.x | n.y | f.x | f.y) & 0x60000) != 0;
    int lod = overflow ? 0 : saturated(max(movement(n.x, f.x), movement(n.y, f.y)));

    ivec4 signals = levelSignals(lod, overflow, maxLevel);
    if (!tflag(T_LOD)) return ivec2(tile, signals.w);

    int level = signals.z != 0 ? maxLevel : signals.x;
    return ivec2((tile + level + ((tflag(T_DETAIL) && signals.y == 0) ? 1 : 0)) & 7, signals.w);
}

// The three coordinates the next drawn row starts from, which a span's last pixel measures against.
ivec3 rowStart() { return ivec3(int(rows[rb + R_NEXT]), int(rows[rb + R_NEXT + 1u]), int(rows[rb + R_NEXT + 2u])); }

// Rdp.PixelLevelOfDetail: the next pixel against the one after, or near a span's end the one before, or the next row's.
ivec2 pixelLevelOfDetail(int s, int t, int w, int ds, int dt, int dw, bool nextRowDrawn, bool end, bool beforeEnd, bool longSpan, bool midSpan, int tile, int maxLevel)
{
    if (nextRowDrawn && end && longSpan)
    {
        ivec3 r = rowStart();
        return levelOfDetail(r.x, r.y, r.z, r.x + ds, r.y + dt, r.z + dw, tile, maxLevel);
    }

    if (nextRowDrawn && ((beforeEnd && longSpan) || (end && midSpan)))
        return levelOfDetail(s + ds, t + dt, w + dw, s - ds, t - dt, w - dw, tile, maxLevel);

    return levelOfDetail(s + ds, t + dt, w + dw, s + (ds << 1), t + (dt << 1), w + (dw << 1), tile, maxLevel);
}

// Rdp.AfterSpanTile: the tile of a span's last texel 1, measured from the pixel after the span.
int afterSpanTile(int s, int t, int w, int ds, int dt, int dw, bool nextRowDrawn, bool longSpan, bool midSpan, bool oneBeforeMid, int tile, int maxLevel)
{
    if (nextRowDrawn && (longSpan || midSpan))
    {
        ivec3 r = rowStart();
        if (longSpan) r += ivec3(ds, dt, dw);
        return levelOfDetail(r.x, r.y, r.z, r.x + ds, r.y + dt, r.z + dw, tile, maxLevel).x;
    }

    if (nextRowDrawn && oneBeforeMid) return levelOfDetail(s + ds, t + dt, w + dw, s - ds, t - dt, w - dw, tile, maxLevel).x;
    return levelOfDetail(s + ds, t + dt, w + dw, s + (ds << 1), t + (dt << 1), w + (dw << 1), tile, maxLevel).x;
}

// Rdp.DownStep: a texture coordinate's step down one row, with its low fifteen bits cleared.
int downStep(uint c) { return pint(P_DOWNSTEP + c); }

// Rdp.TwoCycleLevelOfDetail: measured from the pixel itself, across to the next and down to the next row, for two tiles.
ivec3 twoCycleLevelOfDetail(int s, int t, int w, int ds, int dt, int dw, int tile, int maxLevel)
{
    ivec2 c = dividedCoordinates(s, t, w);
    ivec2 x = dividedCoordinates(s + ds, t + dt, w + dw);
    ivec2 y = dividedCoordinates(s + downStep(0u), t + downStep(1u), w + downStep(2u));

    bool overflow = ((c.x | c.y | x.x | x.y | y.x | y.y) & 0x60000) != 0;
    int lod = 0;
    if (!overflow)
    {
        lod = saturated(max(movement(c.x, x.x), movement(c.y, x.y)));
        lod = saturated(max(lod, max(movement(c.x, y.x), movement(c.y, y.y))));
    }

    ivec4 signals = levelSignals(lod, overflow, maxLevel);
    if (!tflag(T_LOD)) return ivec3(tile, (tile + 1) & 7, signals.w);

    int level = signals.z != 0 ? maxLevel : signals.x;
    bool magnify = signals.y != 0, distant = signals.z != 0;

    if (!tflag(T_DETAIL))
    {
        int first = (tile + level) & 7;
        return ivec3(first, (distant || (!tflag(T_SHARPEN) && magnify)) ? first : (first + 1) & 7, signals.w);
    }

    return ivec3((tile + level + (magnify ? 0 : 1)) & 7, (tile + level + ((!distant && !magnify) ? 2 : 1)) & 7, signals.w);
}

// Rdp.NextRowLevelOfDetail: past a row's end, the next row's first pixel measured down alone, and also across.
ivec3 nextRowLevelOfDetail(int ds, int dt, int dw, int tile, int maxLevel)
{
    ivec3 r = rowStart();
    ivec2 c = dividedCoordinates(r.x, r.y, r.z);
    ivec2 y = dividedCoordinates(r.x + downStep(0u), r.y + downStep(1u), r.z + downStep(2u));

    bool overflow = ((c.x | c.y | y.x | y.y) & 0x60000) != 0;
    int lod = overflow ? 0 : saturated(max(movement(c.x, y.x), movement(c.y, y.y)));

    ivec4 signals = levelSignals(lod, overflow, maxLevel);
    if (!tflag(T_LOD)) return ivec3(tile, tile, signals.w);

    int first = (tile + (signals.z != 0 ? maxLevel : signals.x) + ((tflag(T_DETAIL) && signals.y == 0) ? 1 : 0)) & 7;

    ivec2 x = dividedCoordinates(r.x + ds, r.y + dt, r.z + dw);
    overflow = overflow || ((x.x | x.y) & 0x60000) != 0;
    if (!overflow) lod = saturated(max(lod, max(movement(c.x, x.x), movement(c.y, x.y))));

    signals = levelSignals(lod, overflow, maxLevel);
    int second = (tile + (signals.z != 0 ? maxLevel : signals.x) + ((tflag(T_DETAIL) && signals.y == 0) ? 1 : 0)) & 7;
    return ivec3(first, second, signals.w);
}

// The inputs that read the previous pixel's result never reach here: the host keeps such primitives back - see §6.
ivec4 colorA(int s) { return s == 0 ? combined : s == 1 ? texel0 : s == 2 ? texel1 : s == 3 ? pcolor(P_PRIMITIVE) : s == 4 ? shade : s == 5 ? pcolor(P_ENVIRONMENT) : s == 6 ? ivec4(0x100, 0x100, 0x100, 0) : ivec4(0); }

ivec4 colorB(int s)
{
    if (s == 6) return pcolor(P_KEY_CENTER);
    if (s == 7) return ivec4(pint(P_K4), pint(P_K4), pint(P_K4), 0);
    return s == 0 ? combined : s == 1 ? texel0 : s == 2 ? texel1 : s == 3 ? pcolor(P_PRIMITIVE) : s == 4 ? shade : s == 5 ? pcolor(P_ENVIRONMENT) : ivec4(0);
}

ivec4 colorC(int s)
{
    switch (s)
    {
        case 0: return combined;
        case 7: return ivec4(combined.a);
        case 1: return texel0;
        case 2: return texel1;
        case 3: return pcolor(P_PRIMITIVE);
        case 4: return shade;
        case 5: return pcolor(P_ENVIRONMENT);
        case 6: return pcolor(P_KEY_SCALE);
        case 8: return ivec4(texel0.a);
        case 9: return ivec4(texel1.a);
        case 10: return ivec4(pint(P_PRIMITIVE + 3u));
        case 11: return ivec4(shade.a);
        case 12: return ivec4(pint(P_ENVIRONMENT + 3u));
        case 13: return ivec4(lodFraction);
        case 14: return ivec4(pint(P_PRIMITIVE_LOD));
        case 15: return ivec4(pint(P_K5));
        default: return ivec4(0);
    }
}

int alphaABD(int s) { return s == 0 ? combined.a : s == 1 ? texel0.a : s == 2 ? texel1.a : s == 3 ? pint(P_PRIMITIVE + 3u) : s == 4 ? shade.a : s == 5 ? pint(P_ENVIRONMENT + 3u) : s == 6 ? 0x100 : 0; }
int alphaC(int s) { return s == 0 ? lodFraction : s == 1 ? texel0.a : s == 2 ? texel1.a : s == 3 ? pint(P_PRIMITIVE + 3u) : s == 4 ? shade.a : s == 5 ? pint(P_ENVIRONMENT + 3u) : s == 6 ? pint(P_PRIMITIVE_LOD) : 0; }

int colorEquation(int a, int b, int c, int d) { return ((extend9(a) - extend9(b)) * signedMultiplier(c) + (extend9(d) << 8) + 0x80) & 0x1FFFF; }
int alphaEquation(int a, int b, int c, int d) { return (((extend9(a) - extend9(b)) * signedMultiplier(c) + (extend9(d) << 8) + 0x80) >> 8) & 0x1FF; }

// Rdp.ChromaKey and Distance.
int keyDistance(int channel, int width)
{
    int value = (channel << 15) >> 15;
    if (value > 0) value = (value & 0xF) == 8 ? 0x10 - value : -value;
    return (width << 4) + value;
}

// Rdp.CombinerEquations for one cycle's packed selectors.
ivec4 combinerEquations(int c)
{
    int sa = c & 0xF, sb = (c >> 4) & 0xF, sc = (c >> 8) & 0x1F, sd = (c >> 13) & 0x7;
    ivec4 a = colorA(sa), b = colorB(sb), m = colorC(sc), d = colorA(sd);

    return ivec4(
        colorEquation(a.r, b.r, m.r, d.r),
        colorEquation(a.g, b.g, m.g, d.g),
        colorEquation(a.b, b.b, m.b, d.b),
        alphaEquation(alphaABD((c >> 16) & 7), alphaABD((c >> 19) & 7), alphaC((c >> 22) & 7), alphaABD((c >> 25) & 7)));
}

// Rdp.CombineFirstCycle: the combined colour the second cycle reads, and the alpha the pixel's alpha compare tests.
int combineFirstCycle(int ditherAlpha, int coverage)
{
    ivec4 e = combinerEquations(pint(P_COMBINE1));

    int compareAlpha = 0;
    if (flag(F_ALPHA_COMPARE))
    {
        compareAlpha = clamp9(e.a);
        if (compareAlpha == 0xFF) compareAlpha = 0x100;

        if (!flag(F_ALPHA_FROM_COVERAGE))
        {
            compareAlpha += ditherAlpha;
            if ((compareAlpha & 0x100) != 0) compareAlpha = 0xFF;
        }
        else
        {
            compareAlpha = flag(F_COVERAGE_TIMES_ALPHA) ? (compareAlpha * coverage + 4) >> 3 : coverage << 5;
            if (compareAlpha > 0xFF) compareAlpha = 0xFF;
        }
    }

    combined = ivec4(e.r >> 8, e.g >> 8, e.b >> 8, e.a);

    blenderShadeAlpha = shade.a + ditherAlpha;
    if ((blenderShadeAlpha & 0x100) != 0) blenderShadeAlpha = 0xFF;

    return compareAlpha;
}

// Rdp.CombineSecondCycle; returns the coverage it may have scaled.
int combine(int ditherAlpha, int coverage)
{
    int c = pint(P_COMBINE);
    ivec4 e = combinerEquations(c);
    int red = e.r, green = e.g, blue = e.b, alpha = e.a;

    // This cycle's own result becomes COMBINED before the key reads its first input back, so a key whose first
    // input is COMBINED passes through this cycle's colour, not the one before it - see Mars_Gpu.md §10.2.
    combined = ivec4(red >> 8, green >> 8, blue >> 8, alpha);

    int keyAlpha = 0;
    if (flag(F_KEY))
    {
        keyAlpha = clamp(min(keyDistance(red, pint(P_KEY_WIDTH)), min(keyDistance(green, pint(P_KEY_WIDTH + 1u)), keyDistance(blue, pint(P_KEY_WIDTH + 2u)))), 0, 0xFF);
        ivec4 through = colorA(c & 0xF);
        pixel = ivec4(clamp9(through.r), clamp9(through.g), clamp9(through.b), 0);
    }
    else
    {
        pixel = ivec4(clamp9(red >> 8), clamp9(green >> 8), clamp9(blue >> 8), 0);
    }

    int pixelAlpha = clamp9(alpha);
    if (pixelAlpha == 0xFF) pixelAlpha = 0x100;

    int scaled = 0;
    if (flag(F_COVERAGE_TIMES_ALPHA))
    {
        scaled = (pixelAlpha * coverage + 4) >> 3;
        coverage = (scaled >> 5) & 0xF;
    }

    if (!flag(F_ALPHA_FROM_COVERAGE))
    {
        if (flag(F_KEY)) pixelAlpha = keyAlpha;
        else
        {
            pixelAlpha += ditherAlpha;
            if ((pixelAlpha & 0x100) != 0) pixelAlpha = 0xFF;
        }
    }
    else
    {
        pixelAlpha = flag(F_COVERAGE_TIMES_ALPHA) ? scaled : coverage << 5;
        if (pixelAlpha > 0xFF) pixelAlpha = 0xFF;
    }

    pixel.a = pixelAlpha;

    blenderShadeAlpha = shade.a + ditherAlpha;
    if ((blenderShadeAlpha & 0x100) != 0) blenderShadeAlpha = 0xFF;
    return coverage;
}

// Rdp.ReadMemory on the invocation's own words; returns the stored coverage.
int readMemory(uint word, uint first, uint second)
{
    int modes = pint(P_MODES);
    int size = (modes >> 8) & 3, format = (modes >> 10) & 7;
    memoryColor = ivec4(0, 0, 0, 0xE0);

    if (size == 2)
    {
        int value = int(first & 0xFFFFu), hidden = int(first >> 16) & 3;
        if (format == 0) memoryColor.rgb = ivec3((value >> 8) & 0xF8, (value & 0x7C0) >> 3, (value & 0x3E) << 2);
        else memoryColor.rgb = ivec3(value >> 8);

        if (!flag(F_IMAGE_READ)) return 7;

        int stored = format == 0 ? ((value & 1) << 2) | hidden : (value >> 5) & 7;
        memoryColor.a = stored << 5;
        return stored;
    }

    bool valid = word + 1u < push.memoryWords;
    int high = valid ? int(first & 0xFFFFu) : 0, low = valid ? int(second & 0xFFFFu) : 0;
    memoryColor.rgb = ivec3(high >> 8, high & 0xFF, low >> 8);
    memoryColor.a = flag(F_IMAGE_READ) ? low & 0xE0 : 0xE0;
    return flag(F_IMAGE_READ) ? (low >> 5) & 7 : 7;
}

int highestBit(int value) { return value == 0 ? 0 : 1 << findMSB(value); }

int deltaZEncoding(int value)
{
    return ((value & 0xFF00) != 0 ? 8 : 0) | ((value & 0xF0F0) != 0 ? 4 : 0) | ((value & 0xCCCC) != 0 ? 2 : 0) | ((value & 0xAAAA) != 0 ? 1 : 0);
}

int decompressDepth(int stored)
{
    int packed = (stored >> 2) & 0x3FFF;
    int exponent = (packed >> 11) & 7;
    return (((packed & 0x7FF) << max(6 - exponent, 0)) + (0x40000 - (0x40000 >> exponent))) & 0x3FFFF;
}

int compressDepth(int z)
{
    uint inverted = ~(uint(z & 0x3FFFF) << 14);
    int leading = min(inverted == 0u ? 32 : 31 - findMSB(inverted), 7);
    int mantissa = leading <= 4 ? z >> (4 - leading) : z << min(leading - 4, 2);
    return (mantissa & 0x1FFC) | (leading << 13);
}

// Rdp.CompareDepth, the one-cycle half of it: the two-cycle mode's carried shifts are phase 4's.
bool compareDepth(uint depth, int z, int deltaZ, int deltaZEncoded, int memoryCoverage, inout int coverage, out bool blend, out bool overflow)
{
    z &= 0x3FFFF;
    overflow = ((memoryCoverage + coverage) & 8) != 0;
    // Which cycle's second alpha decides this is the two-cycle mode's last blend, not its first - see Mars_Gpu.md §10.1.
    bool shifts = flag(F_BLEND_SHIFTS);

    if (!flag(F_DEPTH_COMPARE))
    {
        blend = flag(F_FORCE_BLEND) || (!overflow && flag(F_ANTIALIAS));
        if (shifts) { blendShiftA = 0; blendShiftB = deltaZEncoded < 0xB ? 4 : 0xF - deltaZEncoded; }
        return true;
    }

    int stored = int(depth & 0xFFFFu), storedHidden = int(depth >> 16) & 3;
    int old = decompressDepth(stored);
    int storedEncoded = ((stored & 3) << 2) | storedHidden;
    int storedSlope = 1 << storedEncoded;

    if (shifts)
    {
        blendShiftA = clamp(deltaZEncoded - storedEncoded, 0, 4);
        blendShiftB = clamp(storedEncoded - deltaZEncoded, 0, 4);
    }

    if (((stored >> 13) & 0xF) < 3) storedSlope = storedSlope != 0x8000 ? max(storedSlope << 1, 16 >> ((stored >> 13) & 0xF)) : 0xFFFF;

    int slope = highestBit((deltaZ | storedSlope) & 0xFFFF);
    int margin = slope << 3;

    bool farther = z + margin >= old;
    blend = flag(F_FORCE_BLEND) || (!overflow && flag(F_ANTIALIAS) && farther);

    bool inFront = z < old, nearer = z - margin <= old, maximum = old == 0x3FFFF;
    int mode = (pint(P_MODES) >> 4) & 3;

    if (mode == 0) return maximum || (overflow ? inFront : nearer);
    if (mode == 1)
    {
        if (!inFront || !farther || !overflow) return maximum || (overflow ? inFront : nearer);
        int shift = deltaZEncoding(slope & 0xFFFF);
        coverage = ((((old >> shift) - (z >> shift)) & 0xF) * coverage >> 3) & 0xF;
        return true;
    }
    if (mode == 2) return inFront || maximum;
    return farther && nearer && !maximum;
}

ivec3 blendInput(int selector, ivec4 source)
{
    return selector == 0 ? source.rgb : selector == 1 ? memoryColor.rgb : selector == 2 ? pcolor(P_BLEND_COLOR).rgb : pcolor(P_FOG).rgb;
}

// Rdp.BuildBlendQuotients for one index: the bit-serial divider, run where the C# looks it up.
int blendQuotient(int divisor, int dividend)
{
    int complement = ~divisor & 0xF;
    int remainder = (complement + (dividend >> 8) + 1) & 7;
    int quotient = 0;

    for (int bit = 7; bit >= 0; bit--)
    {
        int incoming = (dividend >> bit) & 1;
        int sum = ((quotient >> (bit + 1)) & 1) != 0 ? complement + (remainder << 1) + incoming + 1 : divisor + (remainder << 1) + incoming;
        remainder = sum & 7;
        if ((sum & 0x10) != 0) quotient |= 1 << bit;
    }

    return quotient;
}

int dithered(int value, int dither)
{
    int raised = value > 247 ? 255 : (value & 0xF8) + 8;
    return dither < (value & 7) ? raised : value;
}

// Rdp.BlendEquation: weighted by the two alphas in eighths, then divided by their sum unless told not to.
ivec3 blendEquation(int selectors, ivec4 source, bool divide, int shiftA, int shiftB)
{
    int firstColor = selectors & 3, firstAlphaSelector = (selectors >> 2) & 3;
    int secondColor = (selectors >> 4) & 3, secondAlphaSelector = (selectors >> 6) & 3;

    int firstAlpha = firstAlphaSelector == 0 ? pixel.a : firstAlphaSelector == 1 ? pint(P_FOG + 3u) : firstAlphaSelector == 2 ? blenderShadeAlpha : 0;
    int secondAlpha = secondAlphaSelector == 0 ? ~firstAlpha & 0xFF : secondAlphaSelector == 1 ? memoryColor.a : secondAlphaSelector == 2 ? 0xFF : 0;

    int first = firstAlpha >> 3, second = secondAlpha >> 3;
    if (secondAlphaSelector == 1)
    {
        first = (first >> shiftA) & 0x3C;
        second = (second >> shiftB) | 3;
    }

    ivec3 sum = blendInput(firstColor, source) * first + blendInput(secondColor, source) * (second + 1);

    if (!divide) return (sum >> 5) & 0xFF;

    int divisor = (((first & ~3) + (second & ~3) + 4) >> 2) & 0xF;
    return ivec3(blendQuotient(divisor, (sum.r >> 2) & 0x7FF), blendQuotient(divisor, (sum.g >> 2) & 0x7FF), blendQuotient(divisor, (sum.b >> 2) & 0x7FF));
}

// Rdp.Blend: blend, pass the first input through, or take the second, then dither.
ivec3 blendCycle(int selectors, ivec4 source, int ditherColor, bool blend, bool overflow, int shiftA, int shiftB)
{
    int firstColor = selectors & 3, firstAlphaSelector = (selectors >> 2) & 3;
    int secondColor = (selectors >> 4) & 3, secondAlphaSelector = (selectors >> 6) & 3;
    ivec3 result;

    if (!flag(F_COLOR_ON_COVERAGE) || overflow)
    {
        bool opaque = firstAlphaSelector == 0 && secondAlphaSelector == 0 && pixel.a >= 0xFF;
        if (!blend || opaque) result = blendInput(firstColor, source);
        else result = blendEquation(selectors, source, !flag(F_FORCE_BLEND), shiftA, shiftB);
    }
    else
    {
        result = blendInput(secondColor, source);
    }

    int rgbDither = pint(P_MODES) & 3;
    if (rgbDither != 3)
    {
        result.r = dithered(result.r, rgbDither == 2 ? ditherColor & 7 : ditherColor);
        result.g = dithered(result.g, rgbDither == 2 ? (ditherColor >> 3) & 7 : ditherColor);
        result.b = dithered(result.b, rgbDither == 2 ? (ditherColor >> 6) & 7 : ditherColor);
    }

    return result;
}

// Rdp.FinalCoverage.
int finalCoverage(bool blend, int coverage, int memoryCoverage)
{
    int destination = (pint(P_MODES) >> 6) & 3;
    if (destination == 0)
    {
        int sum = blend ? coverage + memoryCoverage : coverage - 1;
        return (sum & 8) != 0 ? 7 : sum & 7;
    }
    return destination == 1 ? (coverage + memoryCoverage) & 7 : destination == 2 ? 7 : memoryCoverage;
}

// Rdp.CopyBankWord: four addresses reach four banks at once, so a texel whose bank an earlier one claimed reads that one's word.
int copyBankWord(int addresses[4], int texel, int upperHalf)
{
    int bank = (addresses[texel] >> 2) & 3;
    int first = 0;
    while (((addresses[first] >> 2) & 3) != bank) first++;
    return tmemWord(upperHalf | ((addresses[first] >> 2) & 0x3FF));
}

// Rdp.Replicated: a texel narrower than sixteen bits becomes one byte.
int replicated(int word, int nibble, int size, int format, int palette)
{
    if (size == 0)
    {
        int value = (word >> ((nibble ^ 3) << 2)) & 0xF;
        if (format == 2) return (palette << 4) | value;
        if (format != 3) return (value << 4) | value;

        int doubled = (value << 4) | value;
        return (doubled & 0xE0) | ((doubled & 0xE0) >> 3) | ((doubled & 0xC0) >> 6);
    }

    if (size != 1) return (word >> 8) & 0xFF;

    int at = ((nibble ^ 3) | 1) << 2;
    if (format != 3) return (((word >> at) & 0xF) << 4) | ((word >> (at & ~4)) & 0xF);

    int nib = (word >> at) & 0xF;
    return (nib << 4) | nib;
}

// Rdp.CopyPaletteIndex.
int copyPaletteIndex(int word, int nibble, int tile)
{
    if (tileSize(tile) == 0) return (tilePalette(tile) << 4) | ((word >> ((nibble ^ 3) << 2)) & 0xF);

    int at = ((nibble & 2) ^ 2) << 2;
    return ((at != 0 ? (word >> 12) & 0xF : (word >> 4) & 0xF) << 4) | ((word >> at) & 0xF);
}

// Rdp.CopyTexels as its sixty-four bits in two halves, since the port keeps to 32-bit integers - see Mars_Gpu.md §4.
uvec2 copyTexels(int s, int t, int tile)
{
    s = (shiftedCoordinate(s, tileShiftS(tile)) - (tileSL(tile) << 3)) >> 5;
    t = (shiftedCoordinate(t, tileShiftT(tile)) - (tileTL(tile) << 3)) >> 5;
    if (tileMaskT(tile) != 0) t = maskedCoordinate(t, tileMaskT(tile), tileMirrorT(tile), tileMirrorBitT(tile));

    int format = tileFormat(tile), tsize = tileSize(tile);
    bool yuv = format == 1;
    int stride = (yuv || tsize == 1) ? 2 : tsize >= 2 ? 4 : 1;
    int start = ((((tileLine(tile) * t) & 0x1FF) + tileMemory(tile)) << 4) & 0x1FFF;

    int along[4], upper[4], lower[4];
    for (int k = 0; k < 4; k++)
    {
        int column = tileMaskS(tile) != 0 ? maskedCoordinate(s + k, tileMaskS(tile), tileMirrorS(tile), tileMirrorBitS(tile)) : s + k;
        along[k] = (column * stride) & 0x1FFF;
        upper[k] = (start + along[k]) & 0x1FFF;
    }

    // YUV reads its chroma from a further step along, in the lower half's read alone.
    lower[0] = upper[0];
    lower[2] = upper[2];
    lower[1] = yuv ? (upper[0] + ((along[1] - along[0]) << 1)) & 0x1FFF : upper[1];
    lower[3] = yuv ? (lower[1] + along[3] - along[0]) & 0x1FFF : upper[3];

    if ((t & 1) != 0)
        for (int k = 0; k < 4; k++) { upper[k] ^= 8; lower[k] ^= 8; }

    bool palette = tflag(T_PALETTE);
    int psize = palette ? 2 : tsize;
    bool wide = !palette && (format == 1 || (format == 0 && tsize == 3));

    int words[4];
    for (int k = 0; k < 4; k++)
    {
        int word = copyBankWord(lower, k, 0);
        if (palette) words[k] = tmemWord(0x400 | (copyPaletteIndex(word, lower[k] & 3, tile) << 2) | k);
        else if (wide || (lower[k] & 0x1000) == 0) words[k] = word;
        else words[k] = copyBankWord(upper, k, 0x400);
    }

    uint lo = (uint(words[2]) << 16) | uint(words[3] & 0xFFFF);
    if (psize == 2) return uvec2((uint(words[0]) << 16) | uint(words[1] & 0xFFFF), lo);

    uint hi = 0u;
    for (int k = 0; k < 4; k++) hi = (hi << 8) | uint(replicated(words[k], lower[k] & 3, psize, format, tilePalette(tile)) & 0xFF);
    return uvec2(hi, lo);
}

// Rdp.FirstCycles' texel half: both texels through the two cycles, the first alone, or neither.
void twoCycleTexels(int vs, int vt, int vw, int ds, int dt, int dw, bool beyond, bool nextRowDrawn, int length, int tile, int maxLevel)
{
    int level = pint(P_TEXEL_LEVEL);
    if (level >= 3) return;

    if (level <= 1)
    {
        // Past a long enough row's end, when both texels are read through the second cycle, the second is the next row's first.
        if (beyond && level == 0 && nextRowDrawn && length >= 3)
        {
            ivec3 pick = nextRowLevelOfDetail(ds, dt, dw, tile, maxLevel);
            lodFraction = pick.z;

            ivec2 st = textureCoordinates(vs, vt, vw);
            texel0 = texelAt(st.x, st.y, pick.x, tflag(T_BILINEAR));

            ivec3 r = rowStart();
            ivec2 next = textureCoordinates(r.x, r.y, r.z);
            texel1 = texelAt(next.x, next.y, pick.y, tflag(T_BILINEAR));
            return;
        }

        ivec3 pick = twoCycleLevelOfDetail(vs, vt, vw, ds, dt, dw, tile, maxLevel);
        lodFraction = pick.z;

        ivec2 st = textureCoordinates(vs, vt, vw);
        texel0 = texelAt(st.x, st.y, pick.x, tflag(T_BILINEAR));
        texel1 = texelAt(st.x, st.y, pick.y, tflag(T_BILINEAR2));
        return;
    }

    ivec3 pick = twoCycleLevelOfDetail(vs, vt, vw, ds, dt, dw, tile, maxLevel);
    lodFraction = pick.z;
    ivec2 st = textureCoordinates(vs, vt, vw);
    texel0 = texelAt(st.x, st.y, pick.x, tflag(T_BILINEAR));
}

void main()
{
    uvec2 tile = gl_WorkGroupID.xy;
    if (tile.x >= push.tilesWide || tile.y >= push.tilesHigh) return;

    uint ux = (push.tileX0 + tile.x) * 8u + gl_LocalInvocationID.x;
    uint uy = (push.tileY0 + tile.y) * 8u + gl_LocalInvocationID.y;
    if (ux >= push.width) return;
    int x = int(ux), y = int(uy);

    uint slot = tile.y * push.tilesWide + tile.x;
    uint begin = tileOffsets[slot], end = tileOffsets[slot + 1u];
    if (begin == end) return;

    uint offset = uy * push.width + ux;
    uint word = push.imageWord + offset * push.pixelWords;
    uint depthAt = push.depthWord + offset;

    uint first = word < push.memoryWords ? memory[word] : 0u;
    uint second = push.pixelWords == 2u && word + 1u < push.memoryWords ? memory[word + 1u] : 0u;
    uint depth = depthAt < push.memoryWords ? memory[depthAt] : 0u;
    bool touched = false, depthTouched = false;

    for (uint i = begin; i < end; i++)
    {
        rb = tileRows[i] * ROW_WORDS;
        int left = int(rows[rb + R_LEFT]), right = int(rows[rb + R_RIGHT]);
        if (rows[rb + R_Y] != uy || x < left || x > right) continue;

        pb = rows[rb + R_PRIMITIVE] * PRIMITIVE_WORDS;
        uint kind = primitives[pb + P_KIND];

        if (kind == KIND_FILL)
        {
            first = filled(word, primitives[pb + P_FILL]);
            second = filled(word + 1u, primitives[pb + P_FILL]);
            touched = true;
            continue;
        }

        flags = primitives[pb + P_FLAGS];
        int n = flag(F_MAJOR_ON_LEFT) ? x - left : right - x;

        // Rdp.DrawCopyScaled for one pixel: its own texel, no combiner and no blender. The row's values here are the
        // major edge's, not stepped to the first drawn pixel, which is how the CPU path at a multiple does it - see §11.3.
        if (kind == KIND_COPY)
        {
            texture_ = primitives[pb + P_TEXTURE];
            tmemBase = primitives[pb + P_TMEM] * TMEM_WORDS;
            tileBase = primitives[pb + P_TILES] * TILE_WORDS;

            int vs = int(rows[rb + R_VALUES + ATTRIBUTE_S]) + pint(P_STEPS + ATTRIBUTE_S) * n;
            int vt = int(rows[rb + R_VALUES + ATTRIBUTE_T]) + pint(P_STEPS + ATTRIBUTE_T) * n;
            int vw = int(rows[rb + R_VALUES + ATTRIBUTE_W]) + pint(P_STEPS + ATTRIBUTE_W) * n;
            int ds = pint(P_STEPS + ATTRIBUTE_S), dt = pint(P_STEPS + ATTRIBUTE_T), dw = pint(P_STEPS + ATTRIBUTE_W);

            ivec2 st = textureCoordinates(vs, vt, vw);
            int from = levelOfDetail(vs + ds, vt + dt, vw + dw, vs + (ds << 1), vt + (dt << 1), vw + (dw << 1), pint(P_TILE), pint(P_MAXLEVEL)).x;
            uvec2 texels = copyTexels(st.x, st.y, from);

            // A sixteen-bit image takes the top two bytes, both kept or both not by the first texel's low bit.
            uint value = texels.x >> 16;
            if (flag(F_ALPHA_COMPARE) && (value & 1u) == 0u) continue;

            first = value | ((value & 1u) * 3u) << 16;
            touched = true;
            continue;
        }

        // Rdp.DrawOneCycle for one pixel: the row's values at its first pixel, stepped to this one.

        int mask = coverageMask(x, left, right);
        int coverage = bitCount(mask);
        bool coverageBit = (mask & 0x80) != 0;
        ivec2 firstSample = coverageOffset(mask);

        for (uint c = 0u; c < 4u; c++)
        {
            int value = int(rows[rb + R_VALUES + c]) + pint(P_STEPS + c) * n;
            shade[c] = correctShade(value >> 14, pint(P_SHADE_DX + c), pint(P_SHADE_DY + c), firstSample, coverage);
        }

        int zValue = flag(F_PRIMITIVE_DEPTH) ? pint(P_PRIMITIVE_Z) : int(rows[rb + R_VALUES + 4u]) + pint(P_STEPS + 4u) * n;
        int z = correctDepth((zValue >> 10) & 0x3FFFFF, pint(P_DEPTH_DX), pint(P_DEPTH_DY), firstSample, coverage);

        int ditherColor = 7, ditherAlpha = 0;
        if (flag(F_DITHER))
        {
            int index = (((y >> (flag(F_SCISSOR_FIELD) ? 1 : 0)) & 3) << 2) | (x & 3);
            int modes = pint(P_MODES);
            int rgb = modes & 3, alphaMode = (modes >> 2) & 3;
            int pattern = rgb == 0 || rgb == 2 ? MAGIC_SQUARE[index] : BAYER[index];
            ditherColor = rgb == 0 ? MAGIC_SQUARE[index] : rgb == 1 ? BAYER[index] : rgb == 2 ? 0 : 7;
            ditherAlpha = alphaMode == 0 ? pattern : alphaMode == 1 ? ~pattern & 7 : 0;
        }

        texture_ = primitives[pb + P_TEXTURE];

        // Rdp.DrawTwoCycle for one pixel. Its two cycles are pipelined: this pixel's first run before its
        // predecessor's last blend, so that blend reads the NEXT pixel's shade alpha - see Mars_Gpu.md §10.
        if (kind == KIND_TWO_CYCLE)
        {
            tmemBase = primitives[pb + P_TMEM] * TMEM_WORDS;
            tileBase = primitives[pb + P_TILES] * TILE_WORDS;
            int tile = pint(P_TILE), maxLevel = pint(P_MAXLEVEL);

            uint span = rows[rb + R_SPAN];
            bool nextRowDrawn = (span & S_NEXT_ROW_DRAWN) != 0u;
            int length = (span & S_LENGTH_THREE) != 0u ? 3 : 0;
            int last = right - left;
            int direction = flag(F_MAJOR_ON_LEFT) ? 1 : -1;

            int vs = int(rows[rb + R_VALUES + ATTRIBUTE_S]) + pint(P_STEPS + ATTRIBUTE_S) * n;
            int vt = int(rows[rb + R_VALUES + ATTRIBUTE_T]) + pint(P_STEPS + ATTRIBUTE_T) * n;
            int vw = int(rows[rb + R_VALUES + ATTRIBUTE_W]) + pint(P_STEPS + ATTRIBUTE_W) * n;
            int ds = pint(P_STEPS + ATTRIBUTE_S), dt = pint(P_STEPS + ATTRIBUTE_T), dw = pint(P_STEPS + ATTRIBUTE_W);

            twoCycleTexels(vs, vt, vw, ds, dt, dw, false, nextRowDrawn, length, tile, maxLevel);
            int compareAlpha = combineFirstCycle(ditherAlpha, coverage);

            // The second cycle reads the second texel as texel 0 and the first as texel 1.
            ivec4 swapped = texel0;
            texel0 = texel1;
            texel1 = swapped;
            coverage = combine(ditherAlpha, coverage);

            int memoryCoverage = readMemory(word, first, second);
            bool blend, overflow;
            if (!compareDepth(depth, z, pint(P_DELTA_Z), pint(P_DELTA_Z_ENCODED), memoryCoverage, coverage, blend, overflow)) continue;
            if (flag(F_ANTIALIAS) ? coverage == 0 : !coverageBit) continue;

            // The first blend is never divided; a primitive whose first cycle weighs memory alpha is declined, so its shifts are zero.
            ivec3 blended = blendEquation(pint(P_BLEND), pixel, false, 0, 0);

            // The next pixel's shade alpha, which is the one thing its first cycles change that this pixel's last blend reads.
            int nextX = x + direction;
            int nextMask = n < last ? coverageMask(nextX, left, right) : 0;
            int nextValue = int(rows[rb + R_VALUES + 3u]) + pint(P_STEPS + 3u) * (n + 1);
            int nextShade = correctShade(nextValue >> 14, pint(P_SHADE_DX + 3u), pint(P_SHADE_DY + 3u), coverageOffset(nextMask), bitCount(nextMask));

            int nextDitherAlpha = 0;
            if (flag(F_DITHER))
            {
                int index = (((y >> (flag(F_SCISSOR_FIELD) ? 1 : 0)) & 3) << 2) | (nextX & 3);
                int modes = pint(P_MODES);
                int rgb = modes & 3, alphaMode = (modes >> 2) & 3;
                int pattern = (rgb == 0 || rgb == 2) ? MAGIC_SQUARE[index] : BAYER[index];
                nextDitherAlpha = alphaMode == 0 ? pattern : alphaMode == 1 ? ~pattern & 7 : 0;
            }

            blenderShadeAlpha = nextShade + nextDitherAlpha;
            if ((blenderShadeAlpha & 0x100) != 0) blenderShadeAlpha = 0xFF;

            if (flag(F_ALPHA_COMPARE) && compareAlpha < (flag(F_DITHER_ALPHA) ? 0 : pint(P_BLEND_COLOR + 3u))) continue;

            ivec3 twoColor = blendCycle(pint(P_BLEND2), ivec4(blended, 0), ditherColor, blend, overflow, blendShiftA, blendShiftB) & 0xFF;

            int twoStored = finalCoverage(blend, coverage, memoryCoverage);
            int twoModes = pint(P_MODES);
            if (((twoModes >> 8) & 3) == 2)
            {
                int packed;
                if (((twoModes >> 10) & 7) == 0) packed = ((twoColor.r & ~7) << 8) | ((twoColor.g & ~7) << 3) | ((twoColor.b & ~7) >> 2);
                else { packed = (twoColor.r << 8) | (twoStored << 5); twoStored = 0; }

                first = uint((packed | (twoStored >> 2)) & 0xFFFF) | uint(twoStored & 3) << 16;
                touched = true;
            }
            else if (word + 1u < push.memoryWords)
            {
                first = uint((twoColor.r << 8) | twoColor.g) | uint((twoColor.g & 1) * 3) << 16;
                second = uint((twoColor.b << 8) | ((twoStored << 5) & 0xFF));
                touched = true;
            }

            if (flag(F_DEPTH_UPDATE))
            {
                int deltaZEncoded = pint(P_DELTA_Z_ENCODED);
                depth = uint((compressDepth(z & 0x3FFFF) | (deltaZEncoded >> 2)) & 0xFFFF) | uint(deltaZEncoded & 3) << 16;
                depthTouched = true;
            }

            continue;
        }

        if (tflag(T_TEXEL0 | T_TEXEL1 | T_LOD_FRACTION))
        {
            tmemBase = primitives[pb + P_TMEM] * TMEM_WORDS;
            tileBase = primitives[pb + P_TILES] * TILE_WORDS;
            int tile = pint(P_TILE), maxLevel = pint(P_MAXLEVEL);

            int vs = int(rows[rb + R_VALUES + ATTRIBUTE_S]) + pint(P_STEPS + ATTRIBUTE_S) * n;
            int vt = int(rows[rb + R_VALUES + ATTRIBUTE_T]) + pint(P_STEPS + ATTRIBUTE_T) * n;
            int vw = int(rows[rb + R_VALUES + ATTRIBUTE_W]) + pint(P_STEPS + ATTRIBUTE_W) * n;
            int ds = pint(P_STEPS + ATTRIBUTE_S), dt = pint(P_STEPS + ATTRIBUTE_T), dw = pint(P_STEPS + ATTRIBUTE_W);

            uint span = rows[rb + R_SPAN];
            bool nextRowDrawn = (span & S_NEXT_ROW_DRAWN) != 0u, longSpan = (span & S_LONG_SPAN) != 0u;
            bool midSpan = (span & S_MID_SPAN) != 0u, oneBeforeMid = (span & S_ONE_BEFORE_MID) != 0u;
            int last = right - left;

            // Each pixel's level is what its predecessor measured for its texel 1, which is this pixel's own measurement - see Mars_Gpu.md §7.3.
            int levelTile = tile;
            if (tflag(T_LOD | T_LOD_FRACTION))
            {
                ivec2 level = pixelLevelOfDetail(vs, vt, vw, ds, dt, dw, nextRowDrawn, n == last, n == last - 1, longSpan, midSpan, tile, maxLevel);
                levelTile = level.x;
                lodFraction = level.y;
            }

            if (tflag(T_TEXEL0 | T_TEXEL1))
            {
                ivec2 st = textureCoordinates(vs, vt, vw);
                texel0 = texelAt(st.x, st.y, levelTile, tflag(T_BILINEAR));

                if (tflag(T_TEXEL1))
                {
                    int nextTile = tile;
                    if (tflag(T_LOD | T_LOD_FRACTION))
                        nextTile = n < last
                            ? pixelLevelOfDetail(vs + ds, vt + dt, vw + dw, ds, dt, dw, nextRowDrawn, n + 1 == last, n + 1 == last - 1, longSpan, midSpan, tile, maxLevel).x
                            : afterSpanTile(vs + ds, vt + dt, vw + dw, ds, dt, dw, nextRowDrawn, longSpan, midSpan, oneBeforeMid, tile, maxLevel);

                    // The next pixel's texel of a long span's last pixel is the next row's first - see Mars_RdpTextures.md §6.
                    ivec3 r = rowStart();
                    st = (n == last && longSpan && nextRowDrawn) ? textureCoordinates(r.x, r.y, r.z) : textureCoordinates(vs + ds, vt + dt, vw + dw);
                    texel1 = texelAt(st.x, st.y, nextTile, tflag(T_BILINEAR));
                }
            }
        }

        coverage = combine(ditherAlpha, coverage);
        int memoryCoverage = readMemory(word, first, second);

        bool blend, overflow;
        if (!compareDepth(depth, z, pint(P_DELTA_Z), pint(P_DELTA_Z_ENCODED), memoryCoverage, coverage, blend, overflow)) continue;

        if (flag(F_ALPHA_COMPARE) && pixel.a < (flag(F_DITHER_ALPHA) ? 0 : pint(P_BLEND_COLOR + 3u))) continue;
        if (flag(F_ANTIALIAS) ? coverage == 0 : !coverageBit) continue;

        ivec3 color = blendCycle(pint(P_BLEND), pixel, ditherColor, blend, overflow, blendShiftA, blendShiftB) & 0xFF;

        // Rdp.WriteMemory, sixteen and thirty-two bits.
        int stored = finalCoverage(blend, coverage, memoryCoverage);
        int imageModes = pint(P_MODES);
        if (((imageModes >> 8) & 3) == 2)
        {
            int packed;
            if (((imageModes >> 10) & 7) == 0) packed = ((color.r & ~7) << 8) | ((color.g & ~7) << 3) | ((color.b & ~7) >> 2);
            else { packed = (color.r << 8) | (stored << 5); stored = 0; }

            first = uint((packed | (stored >> 2)) & 0xFFFF) | uint(stored & 3) << 16;
            touched = true;
        }
        else if (word + 1u < push.memoryWords)
        {
            first = uint((color.r << 8) | color.g) | uint((color.g & 1) * 3) << 16;
            second = uint((color.b << 8) | ((stored << 5) & 0xFF));
            touched = true;
        }

        // Rdp.StoreDepth.
        if (flag(F_DEPTH_UPDATE))
        {
            int deltaZEncoded = pint(P_DELTA_Z_ENCODED);
            depth = uint((compressDepth(z & 0x3FFFF) | (deltaZEncoded >> 2)) & 0xFFFF) | uint(deltaZEncoded & 3) << 16;
            depthTouched = true;
        }
    }

    if (touched)
    {
        if (word < push.memoryWords) memory[word] = first;
        if (push.pixelWords == 2u && word + 1u < push.memoryWords) memory[word + 1u] = second;
    }

    if (depthTouched && depthAt < push.memoryWords) memory[depthAt] = depth;
}
