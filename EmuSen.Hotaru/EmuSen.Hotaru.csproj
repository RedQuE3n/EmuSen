<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed for Audio/AudioPlayer.cs's fixed-pointer hand-off to SDL's
         QueueAudio (a raw void* parameter) - see that file's own comment.
         No longer needed for Raylib (this frontend has none left); was
         previously justified by the now-deleted Raylib-based PumpAudio. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hotaru's entire UI/audio/input stack now - see App.axaml.cs and
         Views/GameWindow.axaml.cs. Avalonia is the primary application
         (StartWithClassicDesktopLifetime in Program.cs), not a secondary
         dependency bootstrapped alongside a separate Raylib main loop the
         way it used to be for `coretop -w` alone - see git history for
         the Raylib/AvaloniaHost predecessor. Package versions match
         EmuSen.Mistress9's own references exactly, the same convention
         EmuSen.Serenity's csproj already follows. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- Gamepad input (Input/GamepadManager.cs) and real audio output
         (Audio/AudioPlayer.cs) - both duplicated from EmuSen.Mistress9's
         own copies, which already carry this exact dependency. -->
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <!-- Native Wayland backend - opted into explicitly in Program.cs
         (Linux only), matching EmuSen.Mistress9's own Program.cs. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.0" />
    <!-- Imaging/FrameImageWriter.cs encodes screenshots/frame-recording
         PNGs directly via SKImage.Encode, not Avalonia's
         WriteableBitmap.Save - see that file's own comment for why.
         Already a transitive dependency via EmuSen.Serenity's own
         PackageReference; referenced explicitly here too since Hotaru
         imports SkiaSharp types directly, matching Serenity's own
         "don't rely on an implicit transitive version" convention. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The emulation core (Cores/Nintendo/Venus - SNES/*, Common/, Debug/,
         Settings/) - EmuSen.csproj is a pure library, no Main/window
         ownership of its own. -->
    <ProjectReference Include="..\EmuSen\EmuSen.csproj" />
    <!-- GameFrameControl/ShaderEffect/BuiltInShaders - the Avalonia-native
         presenter this frontend is built around. See
         EmuSen.Serenity.csproj. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
  </ItemGroup>

</Project>
