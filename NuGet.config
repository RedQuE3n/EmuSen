<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.LunaP comes from nuget.org. It lives at
     https://github.com/RedQuE3n/EmuSen.LunaP and is published from a tag there
     by a workflow that stores no credential - NuGet Trusted Publishing
     exchanges a GitHub OIDC token for a short-lived key.

     This file used to point at a `local-packages/` folder feed populated by
     `dotnet pack` in that checkout, which meant working on the toolkit and this
     project at once cost a pack and a version bump every time. That is gone.
     The trap it carried is worth remembering anyway, because it will apply
     again the moment somebody consumes a prerelease from a folder: NuGet caches
     by package id AND version, so repacking at a version already restored does
     not propagate, and the build fails on code that was just written.

     Kept as an explicit <clear /> plus nuget.org rather than deleted, so a
     stray source in a machine-wide NuGet.config cannot quietly change where a
     dependency of this project comes from. See EmuSen_LunaP.md §3. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
