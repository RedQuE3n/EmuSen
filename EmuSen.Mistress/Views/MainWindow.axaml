<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:serenity="clr-namespace:EmuSen.Serenity;assembly=EmuSen.Serenity"
        x:Class="EmuSen.Mistress.Views.MainWindow"
        Title="EmuSen Testing Studio"
        Width="1024" Height="768"
        MinWidth="512" MinHeight="480">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open ROM..." Click="OnOpenRomClick" />
                <MenuItem Header="_Browse ROMs..." Click="OnBrowseRomsClick" />
                <Separator />
                <MenuItem Header="Game _Library" Click="OnShowLibraryClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>

            <!-- Every item needs a running game; enabled state is synced on
                 open - see EmuSen_Settings_Reference.md §4.12. -->
            <MenuItem x:Name="EmulationMenu" Header="_Emulation" SubmenuOpened="OnEmulationMenuOpened">
                <MenuItem x:Name="PauseMenuItem" Header="_Pause" ToggleType="CheckBox" Click="OnPauseClick" />
                <MenuItem x:Name="ResetMenuItem" Header="_Reset" Click="OnResetClick" />
                <MenuItem x:Name="CloseGameMenuItem" Header="_Close Game" Click="OnCloseGameClick" />
                <Separator />
                <!-- The held Fast Forward hotkey layers over whichever of these
                     is picked - see EmuSen_Settings_Reference.md §4.13. -->
                <MenuItem x:Name="SpeedMenuItem" Header="Spee_d">
                    <MenuItem x:Name="SpeedNormalMenuItem" Header="_Normal" ToggleType="Radio" Click="OnSpeedNormalClick" />
                    <MenuItem x:Name="SpeedFastMenuItem" Header="_Fast Forward" ToggleType="Radio" Click="OnSpeedFastClick" />
                    <MenuItem x:Name="SpeedSlowMenuItem" Header="_Slow Motion" ToggleType="Radio" Click="OnSpeedSlowClick" />
                    <MenuItem x:Name="SpeedUnthrottledMenuItem" Header="_Unthrottled" ToggleType="Radio" Click="OnSpeedUnthrottledClick" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="SaveStateMenuItem" Header="Save _State" Click="OnSaveStateClick" />
                <MenuItem x:Name="LoadStateMenuItem" Header="_Load State" Click="OnLoadStateClick" />
                <!-- Slots are rebuilt on open so their timestamps are current - see §4.13. -->
                <MenuItem x:Name="SaveSlotMenuItem" Header="State Sl_ot" SubmenuOpened="OnSaveSlotMenuOpened" />
            </MenuItem>

            <MenuItem x:Name="ViewMenu" Header="_View" SubmenuOpened="OnViewMenuOpened">
                <MenuItem x:Name="FullscreenMenuItem" Header="_Fullscreen" ToggleType="CheckBox" Click="OnFullscreenClick" />
            </MenuItem>

            <MenuItem x:Name="SettingsMenu" Header="_Settings" SubmenuOpened="OnSettingsMenuOpened">
                <MenuItem Header="_Controller Bindings..." Click="OnControllerBindingsClick" />
                <MenuItem Header="_Debug Logging..." Click="OnDebugLoggingClick" />
                <MenuItem Header="_Preferences..." Click="OnPreferencesClick" />
                <MenuItem Header="Chea_t Database..." Click="OnCheatDatabaseClick" />
                <MenuItem Header="_Active Cheats..." Click="OnActiveCheatsClick" />
                <Separator />
                <MenuItem x:Name="HardwareDashboardMenuItem" Header="_Hardware Dashboard..." Click="OnHardwareDashboardClick" />
                <!-- Reports on the host VM, so unlike the one above it never needs a ROM - see `man vstop`. -->
                <MenuItem x:Name="RuntimeDashboardMenuItem" Header="_Runtime Dashboard..." Click="OnRuntimeDashboardClick" />
                <MenuItem Header="_DianaOS Console..." Click="OnShellConsoleClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="6,3"
                Background="{DynamicResource SystemChromeLowColor}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="No ROM loaded" />
                <!-- Measured emulated frames/sec (TotalFrames delta over real
                     elapsed time), not a presentation/paint-rate counter -
                     see MainWindow.axaml.cs's EmulationLoop. Diagnostic for
                     telling "RunFrame() itself is behind real time" apart
                     from "presentation is just choppy" during the Testing
                     Studio slowdown investigation. -->
                <TextBlock Grid.Column="1" x:Name="FpsText" Text="" />
            </Grid>
        </Border>

        <!-- Two screens in one viewport: the library list until a game is
             running, the live frame after. Visibility is toggled in
             code-behind rather than bound - see EmuSen_Settings_Reference.md
             §4.11. GameFrameControl is EmuSen.Serenity's shared GPU
             (Skia/Ganesh) presentation surface, the same control Hotaru's
             GameWindow uses. -->
        <Grid Background="{DynamicResource LunaVoid}">
            <DockPanel x:Name="LibraryView" Margin="12">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="2,0,2,8">
                    <TextBlock Grid.Column="0" Text="Console:" Foreground="{DynamicResource LunaMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              x:Name="LibraryConsoleFilter"
                              MinWidth="180"
                              SelectionChanged="OnLibraryConsoleFilterChanged" />
                    <!-- A full NES set is thousands of titles - see EmuSen_Multicore.md §10. -->
                    <TextBox Grid.Column="2"
                             x:Name="LibrarySearchBox"
                             PlaceholderText="Search titles"
                             KeyDown="OnLibraryKeyDown"
                             Margin="8,0,0,0" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           x:Name="LibraryHeaderText"
                           Foreground="{DynamicResource LunaMuted}"
                           Margin="2,0,2,8" />
                <!-- Text is set in ShowLibraryEntries: it depends on whether a game is suspended. -->
                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="LibraryHintText"
                           Foreground="{DynamicResource LunaMuted}"
                           Margin="2,8,2,0" />
                <ListBox x:Name="LibraryList"
                         Background="Transparent"
                         DoubleTapped="OnLibraryItemActivated"
                         KeyDown="OnLibraryKeyDown" />
            </DockPanel>
            <serenity:GameFrameControl x:Name="GameFrame" IsVisible="False" />
        </Grid>

    </DockPanel>

</Window>
