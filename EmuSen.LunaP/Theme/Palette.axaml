<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every value here is the literal that was already in use, not a new
         choice - see EmuSen_LunaP.md §2 for the audit and for why LunaText
         and LunaMeterText are still two greys. -->

    <!-- Surfaces -->
    <Color x:Key="LunaSurfaceColor">#1E1E1E</Color>
    <Color x:Key="LunaInputSurfaceColor">#252526</Color>
    <Color x:Key="LunaVoidColor">#000000</Color>

    <SolidColorBrush x:Key="LunaSurface" Color="{StaticResource LunaSurfaceColor}" />
    <SolidColorBrush x:Key="LunaInputSurface" Color="{StaticResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="LunaVoid" Color="{StaticResource LunaVoidColor}" />

    <!-- Text -->
    <Color x:Key="LunaTextColor">#D4D4D4</Color>
    <Color x:Key="LunaMeterTextColor">#DCDCDC</Color>
    <Color x:Key="LunaMutedColor">#808080</Color>
    <Color x:Key="LunaSectionHeaderColor">#9CDCFE</Color>
    <Color x:Key="LunaWarningColor">#D08770</Color>

    <SolidColorBrush x:Key="LunaText" Color="{StaticResource LunaTextColor}" />
    <SolidColorBrush x:Key="LunaMeterText" Color="{StaticResource LunaMeterTextColor}" />
    <SolidColorBrush x:Key="LunaMuted" Color="{StaticResource LunaMutedColor}" />
    <SolidColorBrush x:Key="LunaSectionHeader" Color="{StaticResource LunaSectionHeaderColor}" />
    <SolidColorBrush x:Key="LunaWarning" Color="{StaticResource LunaWarningColor}" />

    <!-- The load ramp: what "getting busy" looks like, so the GUI dashboards
         and DianaOS's own ColoredBar never disagree - see EmuSen_LunaP.md §2.2. -->
    <Color x:Key="LunaNominalColor">#32CD32</Color>
    <Color x:Key="LunaBusyColor">#FFD700</Color>
    <Color x:Key="LunaHotColor">#FF4500</Color>

    <SolidColorBrush x:Key="LunaNominal" Color="{StaticResource LunaNominalColor}" />
    <SolidColorBrush x:Key="LunaBusy" Color="{StaticResource LunaBusyColor}" />
    <SolidColorBrush x:Key="LunaHot" Color="{StaticResource LunaHotColor}" />

    <!-- Type -->
    <FontFamily x:Key="LunaMonoFont">Consolas,Menlo,monospace</FontFamily>
    <x:Double x:Key="LunaHintFontSize">11</x:Double>
    <x:Double x:Key="LunaHeaderFontSize">14</x:Double>

</ResourceDictionary>
