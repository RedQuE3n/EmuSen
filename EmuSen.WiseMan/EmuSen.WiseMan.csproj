<Project Sdk="Microsoft.NET.Sdk">

  <!-- Named WiseMan, not EmuSen.Tests: WiseMan is the project's codename for its test harness.
       A committed, permanent home for verification that used to be
       reinvented as throwaway scratch code every investigation: shell/debug-
       toolchain dispatch, the core-agnostic IDebugTarget hooks
       (ClassifyStaticReference, DecodeTilePixels), the ICore audio drain
       path, and AudioPlayer's actual SDL3 calls (against SDL's dummy
       driver - see Fixtures/SyntheticRom.cs and Audio/AudioPlayerTests.cs
       for why a real audio device isn't needed to test this for real). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Shaderc's binding is pointers - see Mars_Gpu.md §2. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CsCheck" Version="4.7.0" />
    <!-- GLSL to SPIR-V for Mars's compute shaders, here and nowhere shipped - see Mars_Gpu.md §2. -->
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <!-- A second SVG renderer to grade LunaP's against; MS-PL through Svg.Custom, so test-only and never in anything shipped - see EmuSen_BigPicture.md §4.5, §13.7. 5.1.1 is the last on SkiaSharp 3.119. -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Real Avalonia render passes with no display/GPU needed - see
         Serenity/GameFrameControlRenderTests.cs. Not Avalonia.Headless.XUnit -
         that package pins xunit.v3, which collides (CS0433, duplicate
         Fact/Theory/InlineData types) with this project's existing xunit
         2.9.3 tests. HeadlessUnitTestSession (in plain Avalonia.Headless)
         gives the same capability against ordinary [Fact]/async Task
         instead. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cores' host: ICore, the factory and the catalog. -->
    <ProjectReference Include="..\EmuSen\EmuSen.csproj" />
    <!-- DianaShInterpreter and the shell's commands - its own project as
         of the standalone-shell packaging work, no longer bundled inside
         EmuSen.csproj. -->
    <ProjectReference Include="..\EmuSen.DianaSh\EmuSen.DianaSh.csproj" />
    <!-- IDebugTarget, the registries, the cheat engine, the system packs and the session service - see
         EmuSen_DianaSh.md §13.6. -->
    <ProjectReference Include="..\EmuSen.Crystal\EmuSen.Crystal.csproj" />
    <!-- InputSettingsWindow and the rest of the Mistress GUI under test -
         see Mistress/*Tests.cs. Pulls in Avalonia transitively, which is
         fine for a test project; nothing here opens an actual window. -->
    <ProjectReference Include="..\EmuSen.Mistress\EmuSen.Mistress.csproj" />
    <!-- HeadlessDebugOptions.Parse and FrameRunner - see
         HeadlessDebug/HeadlessDebugOptionsTests.cs and
         HeadlessDebug/FrameRunnerTests.cs. Referencing an OutputType=Exe
         project works the same as any other ProjectReference; its Main
         just never runs from here. -->
    <ProjectReference Include="..\EmuSen.Pharaoh\EmuSen.Pharaoh.csproj" />
    <!-- GameFrameControl.ComputeLetterboxRect, BuiltInShaders' SkSL source,
         ShaderEffect.CycleEffect() - see Serenity/*Tests.cs. Nothing here
         opens an actual Avalonia window either. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- HotaruKeyMap's default bindings and FrameImageWriter's PNG
         encoding - see Input/HotaruKeyMapTests.cs and
         Imaging/FrameImageWriterTests.cs. Nothing here constructs a
         GameWindow or opens an actual Avalonia window. -->
    <ProjectReference Include="..\EmuSen.Hotaru\EmuSen.Hotaru.csproj" />
    <!-- The shell program's launch decision, its window and its prompt's `core` - see Shell/. -->
    <ProjectReference Include="..\EmuSen.Shell\EmuSen.Shell.csproj" />
    <!-- ConfigStore/ConfigFile and the config models - see
         Galaxia/*Tests.cs. ConfigStore.OverrideDirectory is what keeps
         those tests off the real config tree. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
    <!-- The frontend API's binding and the C# implementation behind it - see Crystal/ManagedCrystalTests.cs and EmuSen_Backend.md §14. -->
    <ProjectReference Include="..\EmuSen.Crystal.Client\EmuSen.Crystal.Client.csproj" />
    <!-- AudioPlayer/GamepadBindingMap - see Audio/AudioPlayerTests.cs and
         Input/GamepadBindingMapTests.cs. Real SDL3 calls against the dummy
         driver; nothing here opens a window. -->
    <ProjectReference Include="..\EmuSen.Endymion\EmuSen.Endymion.csproj" />
    <!-- LunaPalette and the shared theme - Serenity/TestAppBuilder.cs now
         includes the same LunaTheme.axaml the real frontends do, instead of
         hand-building FluentTheme/Dark and risking a render pass over
         untemplated controls. See LunaP/LunaPaletteTests.cs. -->
    <!-- Now through LunaP.props, which names where it comes from. -->
  </ItemGroup>


  <!-- Galaxia's catalogue schema, so a test can build the real thing - see EmuSen_Galaxia.md §7. -->
  <ItemGroup>
    <None Include="..\EmuSen.Galaxia\Library\Catalogue\*.sql"
          Link="Library\Catalogue\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Every answer the engine registration gives, which a later build must reproduce - see EmuSen_CoreAPI.md §25. -->
  <ItemGroup>
    <None Include="Cores\CoreRegistrationGolden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Every built-in filter's variants as the chain draws them on the RX 6800 - see EmuSen_DevicePicture.md §19. -->
  <ItemGroup>
    <None Include="Serenity\BuiltInGoldens.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Serenity\BuiltInGoldens.txt')" />
  </ItemGroup>

  <!-- The SNES corpus's recorded verdicts, which the runner reproduces - see VenusRT_Native.md §3.5. -->
  <ItemGroup>
    <None Include="Cores\VenusRtBaseline.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Cores\MercuryCorpusBaseline.tsv" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Cores\MercuryCorpusBaseline.tsv')" />
    <None Include="..\EmuSen\Cores\Shared\emusen-native\abi\v1\baseline.txt" Link="Cores\CoreAbiBaseline.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The core ABI's test cores and the conformance kit's runner and the core host's tool, built by cargo and copied beside the tests that drive the v1 adapter; CI copies the shared job's builds instead - see EmuSen_CoreAPI.md §19, §21. -->
  <PropertyGroup>
    <EmuSenTestCoreDir>$(MSBuildThisFileDirectory)..\EmuSen\Cores\Shared\emusen-native\</EmuSenTestCoreDir>
    <EmuSenTestCoreTarget>$(MSBuildThisFileDirectory)obj\emusen-native</EmuSenTestCoreTarget>
    <EmuSenConformDir>$(MSBuildThisFileDirectory)..\EmuSen\Cores\Shared\emusen-core-conform\</EmuSenConformDir>
    <EmuSenConformTarget>$(MSBuildThisFileDirectory)obj\emusen-core-conform</EmuSenConformTarget>
    <EmuSenConformFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">emusen-core-conform.exe</EmuSenConformFile>
    <EmuSenConformFile Condition="'$(EmuSenConformFile)' == ''">emusen-core-conform</EmuSenConformFile>
    <EmuSenCoreHostDir>$(MSBuildThisFileDirectory)..\EmuSen\Cores\Shared\emusen-core-host\</EmuSenCoreHostDir>
    <EmuSenCoreHostTarget>$(MSBuildThisFileDirectory)obj\emusen-core-host</EmuSenCoreHostTarget>
    <EmuSenCoreHostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">emusen-core-host.exe</EmuSenCoreHostFile>
    <EmuSenCoreHostFile Condition="'$(EmuSenCoreHostFile)' == ''">emusen-core-host</EmuSenCoreHostFile>
    <EmuSenTestCorePrefix Condition="!$([MSBuild]::IsOSPlatform('Windows'))">lib</EmuSenTestCorePrefix>
    <EmuSenTestCoreSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.dll</EmuSenTestCoreSuffix>
    <EmuSenTestCoreSuffix Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</EmuSenTestCoreSuffix>
    <EmuSenTestCoreSuffix Condition="'$(EmuSenTestCoreSuffix)' == ''">.so</EmuSenTestCoreSuffix>
  </PropertyGroup>
  <Target Name="BuildV1TestCore" BeforeTargets="BeforeBuild" Condition="'$(EmuSenNative)' != 'false'">
    <Exec Command="cargo build --release --bin emusen-core-conform --manifest-path &quot;$(EmuSenConformDir)Cargo.toml&quot; --target-dir &quot;$(EmuSenConformTarget)&quot;" WorkingDirectory="$(EmuSenConformDir)" StandardOutputImportance="low" />
    <Exec Command="cargo build --release --bin emusen-core-host --manifest-path &quot;$(EmuSenCoreHostDir)Cargo.toml&quot; --target-dir &quot;$(EmuSenCoreHostTarget)&quot;" WorkingDirectory="$(EmuSenCoreHostDir)" StandardOutputImportance="low" />
    <Exec Command="cargo build --release --example v1_test_core --example v1_plain_core --manifest-path &quot;$(EmuSenTestCoreDir)Cargo.toml&quot; --target-dir &quot;$(EmuSenTestCoreTarget)&quot;" WorkingDirectory="$(EmuSenTestCoreDir)" StandardOutputImportance="low" />
    <ItemGroup>
      <None Include="$(EmuSenTestCoreTarget)\release\examples\$(EmuSenTestCorePrefix)v1_test_core$(EmuSenTestCoreSuffix)" Link="$(EmuSenTestCorePrefix)v1_test_core$(EmuSenTestCoreSuffix)" CopyToOutputDirectory="PreserveNewest" />
      <None Include="$(EmuSenTestCoreTarget)\release\examples\$(EmuSenTestCorePrefix)v1_plain_core$(EmuSenTestCoreSuffix)" Link="$(EmuSenTestCorePrefix)v1_plain_core$(EmuSenTestCoreSuffix)" CopyToOutputDirectory="PreserveNewest" />
      <None Include="$(EmuSenConformTarget)\release\$(EmuSenConformFile)" Link="$(EmuSenConformFile)" CopyToOutputDirectory="PreserveNewest" />
      <None Include="$(EmuSenCoreHostTarget)\release\$(EmuSenCoreHostFile)" Link="$(EmuSenCoreHostFile)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- The debugger's parity tool, built by cargo from the platform's workspace and run beside the tests, and the scripts both debuggers answer - see EmuSen_Backend.md §29.30. -->
  <PropertyGroup>
    <EmuSenDebugToolTarget>$(MSBuildThisFileDirectory)obj\emusen-crystal-debug</EmuSenDebugToolTarget>
    <EmuSenDebugToolFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">emusen-crystal-debug.exe</EmuSenDebugToolFile>
    <EmuSenDebugToolFile Condition="'$(EmuSenDebugToolFile)' == ''">emusen-crystal-debug</EmuSenDebugToolFile>
  </PropertyGroup>
  <Target Name="BuildCrystalDebugTool" BeforeTargets="BeforeBuild" Condition="'$(EmuSenNative)' != 'false'">
    <Exec Command="cargo build --release -p emusen-crystal-debug --features tool --bin emusen-crystal-debug --manifest-path &quot;$(MSBuildThisFileDirectory)..\Platform\Cargo.toml&quot; --target-dir &quot;$(EmuSenDebugToolTarget)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\Platform" StandardOutputImportance="low" />
    <ItemGroup>
      <None Include="$(EmuSenDebugToolTarget)\release\$(EmuSenDebugToolFile)" Link="$(EmuSenDebugToolFile)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="Crystal\DebugScripts\*.script" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\LunaP.props" />

</Project>
