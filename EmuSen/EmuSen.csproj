<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure library now - no Main, no window ownership. The Raylib console
       frontend's Main/hotkey loop lives in EmuSen.RaylibFrontend instead,
       so this project and EmuSen.Frontend (Avalonia) are true sibling
       consumers of the emulation core, neither depending on the other's
       frontend-specific code. See EmuSen_Project_Overview_v2.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Renderer.cs/Renderer.Debug.cs use Raylib_cs.Color/Image/Texture2D
         directly as their internal pixel representation and for the debug
         VRAM/CGRAM panel drawing - a real dependency of the core itself,
         not just a frontend concern, so it stays here even though this
         project no longer owns any window. -->
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- FramePresenter/GraphicsSettings/BuiltInShaders live here now, not
         in this project - see EmuSen.Presentation.csproj's own note on why
         presentation-layer code moved out to its own shared project. -->
    <ProjectReference Include="..\EmuSen.Presentation\EmuSen.Presentation.csproj" />
  </ItemGroup>

</Project>