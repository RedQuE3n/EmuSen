<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pegasus: the live shared notepad this project is developed through, and
       the one place EmuSen speaks F#. Named for Helios/Pegasus (naming scheme
       §12). See EmuSen_Pegasus.md for the design record, the on-disk format and
       the two YDotNet defects it works around.

       ONE ASSEMBLY ON PURPOSE. It arrived as four projects - core, net, app and
       tests - and was collapsed on the way in. A project boundary has to buy
       somebody separability they are actually using, and nothing outside
       Pegasus consumes its document model or its transport. See
       EmuSen_Pegasus.md §7; the same reasoning retired Crystal and Nehellania.

       FSharp.Core enters the solution here and nowhere else. That was the
       objection that sank the F#ascent branch, and it is answered rather than
       ignored: Pegasus is a leaf, so no frontend and no core links it, and the
       2.4 MB lands only in this executable's own publish. Nothing references
       this project - if something ever does, re-read that argument first. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>EmuSen.Pegasus</AssemblyName>
    <RootNamespace>EmuSen.Pegasus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Crypto.fs" />
    <Compile Include="Document.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Controller.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yrs, the Rust Yjs, through its .NET binding. The natives for all three
         desktop platforms ship so a publish for any RID carries libyrs. -->
    <PackageReference Include="YDotNet" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Linux" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.MacOS" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Win32" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window, the theme and the bootstrap all come from LunaP, which is
         why Avalonia is not named here - EmuSen_Pegasus.md §8. -->
    <ProjectReference Include="..\EmuSen.LunaP\EmuSen.LunaP.csproj" />
  </ItemGroup>

</Project>
