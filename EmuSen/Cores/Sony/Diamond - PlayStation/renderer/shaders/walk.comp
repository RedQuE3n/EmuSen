#version 450
// Diamond's renderer, the walk: one invocation a sample of an 8-by-8 tile of the mirror, one workgroup a tile; at a scale
// of N a console tile is N by N of them, the second dimension of the dispatch. Each invocation loads its sample, meets the
// console tile's records in drawing order and applies each by the software rasteriser's rules at the sample, then stores
// it once. See Diamond_Enhancements.md §16 and, for the precise triangle, §22, for the scale §39; the record's layout is
// the renderer's `record.rs`.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) buffer Vram { uint vram[]; };
layout(std430, set = 0, binding = 1) readonly buffer Records { int records[]; };
layout(std430, set = 0, binding = 2) readonly buffer Entries { uint entries[]; };
layout(std430, set = 0, binding = 3) readonly buffer Tiles { uvec4 tiles[]; };
layout(std430, set = 0, binding = 4) readonly buffer Cluts { uint cluts[]; };
layout(std430, set = 0, binding = 5) readonly buffer Data { uint data[]; };
// True colour's plane: each sample's three lowest bits a channel, red's in bits 0-2 (§40); bound but not read without it.
layout(std430, set = 0, binding = 6) buffer Fine { uint fine[]; };

// The first tile of the dispatch, the scale N, and the options' bits: true colour.
layout(push_constant) uniform Push { uint first_tile; uint scale; uint options; };

const uint COLOUR = 1u;

const int WORDS = 48;

const uint TRIANGLE = 1u;
const uint RECTANGLE = 2u;
const uint LINE = 3u;
const uint FILL = 4u;
const uint TRANSFER = 5u;
const uint PRECISE = 6u;

const uint SHADED = 1u << 8;
const uint TEXTURED = 1u << 9;
const uint RAW = 1u << 10;
const uint DITHER = 1u << 11;
const uint BLEND = 1u << 12;
const uint CHECK = 1u << 15;
const uint SET = 1u << 16;
const uint CROP = 1u << 17;
const uint SKIP = 1u << 18;
const uint PARITY = 1u << 19;
const uint PAIRS = 1u << 20;
const uint PERSPECTIVE = 1u << 21;
const uint BOUNDS = 22u;
const uint FILLED = 1u << 25;
const uint OWN_BOUNDS = 26u;
const uint TURNED = 1u << 29;
const uint FILTERED = 1u << 30;

// psx-spx's dither offsets, by y and x modulo 4 (draw.rs's DITHER).
const int DITHERS[16] = int[16](-4, 0, -3, 1, 2, -2, 3, -1, -3, 1, -4, 0, 3, -1, 2, -2);

// The invocation's sample: the console's pixel, and the sample's place within the pixel's block of N by N; with true
// colour on, its low bits as `put` leaves them; and the index of the 15-bit texel `texel` read last, -1 for a palette's.
int N, SX, SY;
bool TRUE_COLOUR;
uint LOW;
int TEXEL_AT;

// The sample (sx, sy) of the console's pixel (x, y), VRAM wrapping by the console's pixels.
uint sample_index(int x, int y, int sx, int sy) {
    return ((uint(y) & 511u) * uint(N) + uint(sy)) * 1024u * uint(N) + (uint(x) & 1023u) * uint(N) + uint(sx);
}

uint at_sample(int x, int y, int sx, int sy) {
    return vram[sample_index(x, y, sx, sy)];
}

// The console's own sample of a pixel, the first of its block.
uint at(int x, int y) {
    return at_sample(x, y, 0, 0);
}

// a / b rounded down, for b > 0.
int floor_div(int a, int b) {
    return a >= 0 ? a / b : -((-a + b - 1) / b);
}

// (256 base + g1 d1 + g2 d2 + 1/2) at 20 fractional bits, the distances in 256ths of a pixel, to 8 fractional bits: its
// integer part is the integer rule's interpolate when they are whole pixels (Diamond_Enhancements.md §22.2).
int interpolate_fine(int base, int g1, int d1, int g2, int d2) {
    int h1, l1, h2, l2;
    imulExtended(g1, d1, h1, l1);
    imulExtended(g2, d2, h2, l2);
    int b = base * 256 + (1 << 19);
    uint c1, c2;
    uint lo = uaddCarry(uint(l1), uint(l2), c1);
    lo = uaddCarry(lo, uint(b), c2);
    int hi = h1 + h2 + int(c1) + int(c2) + (b < 0 ? -1 : 0);
    return int((lo >> 12) | (uint(hi) << 20));
}

// The texel at (u, v) through the window, the page and the CLUT (texture.rs's `texel`, without the texture cache); a 15-bit
// one at the sample (su, sv) of its block, which at N x keeps what was drawn there (§39.3).
uint texel(int r, uint u, uint v, int su, int sv) {
    uint w = uint(records[r + 7]);
    uint mu = w & 0xFFu, mv = (w >> 8) & 0xFFu, ou = (w >> 16) & 0xFFu, ov = w >> 24;
    u = ((u & ~mu) | (ou & mu)) & 0xFFu;
    v = ((v & ~mv) | (ov & mv)) & 0xFFu;
    uint page = uint(records[r + 5]);
    int y = int(page >> 16) + int(v);
    if (y >= 512) {
        return 0u;
    }
    int px = int(page & 0xFFFFu);
    uint ds = uint(records[r + 6]);
    uint depth = ds & 0xFFu, slot = ds >> 8;
    TEXEL_AT = -1;
    if (depth == 0u) {
        uint half_ = at(px + int(u >> 2), y);
        return cluts[slot * 256u + ((half_ >> ((u & 3u) * 4u)) & 0xFu)];
    }
    if (depth == 1u) {
        uint half_ = at(px + int(u >> 1), y);
        return cluts[slot * 256u + ((half_ >> ((u & 1u) * 8u)) & 0xFFu)];
    }
    TEXEL_AT = int(sample_index(px + int(u), y, su, sv));
    return vram[TEXEL_AT] & 0xFFFFu;
}

// B the pixel in VRAM, F the new one, each channel at five bits, saturated: B/2+F/2, B+F, B-F, B+F/4.
uint blend(uint back, uint front, uint mode) {
    uint out_ = 0u;
    for (uint s = 0u; s < 15u; s += 5u) {
        int b = int((back >> s) & 31u), f = int((front >> s) & 31u), c;
        if (mode == 0u) {
            c = (b + f) >> 1;
        } else if (mode == 1u) {
            c = min(b + f, 31);
        } else if (mode == 2u) {
            c = max(b - f, 0);
        } else {
            c = min(b + (f >> 2), 31);
        }
        out_ |= uint(c) << s;
    }
    return out_;
}

// B the pixel in VRAM, F the new one, each channel at eight bits (true colour, §40), saturated at 255.
ivec3 blend8(ivec3 b, ivec3 f, uint mode) {
    return mode == 0u ? (b + f) >> 1 : mode == 1u ? min(b + f, 255) : mode == 2u ? max(b - f, 0) : min(b + (f >> 2), 255);
}

// A sample's colour at eight bits a channel: the console's five with true colour's three below.
ivec3 eight(uint half_, uint low) {
    return ivec3(int(half_ & 31u) << 3 | int(low & 7u), int((half_ >> 5) & 31u) << 3 | int((low >> 3) & 7u), int((half_ >> 10) & 31u) << 3 | int((low >> 6) & 7u));
}

// draw.rs's `put`: dithered, cut to five bits, left alone over a masked pixel when checking, blended, written with the
// texel's flag and the mask bit. With true colour, no dither, the blend at eight bits, and the three bits the console
// drops kept in the plane (§40).
void put(inout uint pixel, uint flags, int x, int y, ivec3 c, uint flag, bool blended) {
    if (TRUE_COLOUR) {
        c = clamp(c, 0, 255);
        if ((flags & CHECK) != 0u && (pixel & 0x8000u) != 0u) {
            return;
        }
        if (blended) {
            c = blend8(eight(pixel, LOW), c, (flags >> 13) & 3u);
        }
        pixel = uint(c.r >> 3) | (uint(c.g >> 3) << 5) | (uint(c.b >> 3) << 10) | flag | ((flags & SET) != 0u ? 0x8000u : 0u);
        LOW = uint(c.r & 7) | (uint(c.g & 7) << 3) | (uint(c.b & 7) << 6);
        return;
    }
    if ((flags & DITHER) != 0u) {
        c += DITHERS[(y & 3) * 4 + (x & 3)];
    }
    c = clamp(c, 0, 255) >> 3;
    if ((flags & CHECK) != 0u && (pixel & 0x8000u) != 0u) {
        return;
    }
    uint out_ = uint(c.r) | (uint(c.g) << 5) | (uint(c.b) << 10);
    if (blended) {
        out_ = blend(pixel, out_, (flags >> 13) & 3u);
    }
    pixel = out_ | flag | ((flags & SET) != 0u ? 0x8000u : 0u);
}

// The texels a filtered primitive mixes are held within, per axis (lo, hi), from the least and greatest of its vertices'
// coordinates `range` and its gradients: short of the end the coordinate runs toward across the screen, which it never
// reaches; none where the texture window repeats the axis, the window then wrapping each texel (§41).
ivec2 filter_limits(uint range, int gx, int gy, uint window) {
    int lo = int(range & 0xFFu), hi = int((range >> 8) & 0xFFu);
    if (window != 0u) {
        return ivec2(0, -1);
    }
    if (hi > lo && gx >= 0 && gy >= 0) {
        hi--;
    } else if (hi > lo && gx <= 0 && gy <= 0) {
        lo++;
    }
    return ivec2(lo, hi);
}

// Bilinear after the palette (§41): the four texels about the coordinate (fu, fv), (c + 1/2) in 256ths, each through the
// window, the page and the palette, held within `limits` (u's then v's, none where hi < lo); a 15-bit page at N x
// mixes its samples, a palette's page its texels. Transparent texels are left out and the others' weights renormalised.
ivec3 bilinear(int r, int fu, int fv, ivec4 limits, ivec3 nearest) {
    int n = (uint(records[r + 6]) & 0xFFu) == 2u ? N : 1;
    int pu = fu * n - 128, pv = fv * n - 128;
    int u0 = pu >> 8, v0 = pv >> 8, wu = pu & 255, wv = pv & 255;
    ivec3 sum = ivec3(0);
    int weights = 0;
    for (int k = 0; k < 4; k++) {
        int au = u0 + (k & 1), av = v0 + (k >> 1);
        if (limits.y >= limits.x) {
            au = clamp(au, limits.x * n, limits.y * n + n - 1);
        }
        if (limits.w >= limits.z) {
            av = clamp(av, limits.z * n, limits.w * n + n - 1);
        }
        int tu = floor_div(au, n), tv = floor_div(av, n);
        uint t = texel(r, uint(tu) & 0xFFu, uint(tv) & 0xFFu, au - tu * n, av - tv * n);
        if (t == 0u) {
            continue;
        }
        int w = ((k & 1) != 0 ? wu : 256 - wu) * ((k >> 1) != 0 ? wv : 256 - wv);
        sum += w * eight(t, TRUE_COLOUR && TEXEL_AT >= 0 ? fine[TEXEL_AT] : 0u);
        weights += w;
    }
    return weights == 0 ? nearest : (sum + weights / 2) / weights;
}

// draw.rs's `row` for one pixel: the texel and its transparency, modulation or a raw texture, then `put`. Filtered, the
// colour is `bilinear`'s at (fu, fv), what is drawn and how it blends the nearest texel's, the console's own (§41).
void shade(inout uint pixel, int r, uint flags, int x, int y, ivec3 rgb, uint u, uint v, int su, int sv, int fu, int fv, ivec4 limits) {
    bool blending = (flags & BLEND) != 0u;
    if ((flags & TEXTURED) == 0u) {
        put(pixel, flags, x, y, rgb, 0u, blending);
        return;
    }
    uint t = texel(r, u, v, su, sv);
    if (t == 0u) {
        return;
    }
    ivec3 t5 = ivec3(int(t & 31u), int((t >> 5) & 31u), int((t >> 10) & 31u));
    ivec3 c;
    if ((flags & FILTERED) != 0u) {
        ivec3 t8 = bilinear(r, fu, fv, limits, eight(t, TRUE_COLOUR && TEXEL_AT >= 0 ? fine[TEXEL_AT] : 0u));
        c = (flags & RAW) != 0u ? t8 : (flags & CROP) != 0u ? (((rgb >> 3) * (t8 >> 3)) >> 1) : (rgb * t8) >> 7;
    } else if (TRUE_COLOUR && (flags & CROP) == 0u) {
        // The texel at eight bits, with the low bits of a 15-bit one drawn with true colour (§40).
        ivec3 t8 = eight(t, TEXEL_AT >= 0 ? fine[TEXEL_AT] : 0u);
        c = (flags & RAW) != 0u ? t8 : (rgb * t8) >> 7;
    } else if ((flags & RAW) != 0u) {
        c = t5 << 3;
    } else if ((flags & CROP) != 0u) {
        c = ((rgb >> 3) * t5) >> 1;
    } else {
        c = (rgb * t5) >> 4;
    }
    uint flag = t & 0x8000u;
    put(pixel, flags, x, y, c, flag, blending && flag != 0u);
}

ivec3 colour(int r) {
    int w = records[r + 8];
    return ivec3(w & 0xFF, (w >> 8) & 0xFF, (w >> 16) & 0xFF);
}

// The drawing row VRAM's row `py` stands for in a primitive spanning rows y_lo..y_hi, at most 512 of them: py or py + 512.
int row_of(int r, int py) {
    return py >= records[r + 3] ? py : py + 512;
}

bool inside(int r, int x, int y) {
    return x >= records[r + 1] && x <= records[r + 2] && y >= records[r + 3] && y <= records[r + 4];
}

bool skipped(uint flags, int y) {
    return (flags & SKIP) != 0u && uint(y & 1) == ((flags >> 19) & 1u);
}

// A coordinate of a sample, `d` in N x units, as the point its colours and texture are evaluated at, in 256ths of a
// console pixel: centred in the block about the console's point, `(2d - N + 1) / 2N`, to the nearest 256th (§39.1).
int attribute_point(int d) {
    return N == 1 ? d * 256 : floor_div(256 * (2 * d - N + 1) + N, 2 * N);
}

// A texture coordinate with its fraction, (c + 1/2) in 256ths: the texel the console's rounding reads, and the sample
// of its block the fraction falls in (§39.3).
uvec2 texel_of(int c) {
    return uvec2(uint(c >> 8) & 0xFFu, uint(((c & 255) * N) >> 8));
}

// At N x a sample's attribute point can lie a little outside its triangle (§39.1), where its coordinate runs past the
// vertices' own: held within them, `range` their least and greatest, so that it never wraps to the page's far side.
int within(int c, uint range) {
    return N == 1 ? c : clamp(c, int(range & 0xFFu) * 256, int((range >> 8) & 0xFFu) * 256 + 255);
}

void triangle(inout uint pixel, int r, uint flags, int x, int py) {
    int y = row_of(r, py);
    if (!inside(r, x, y) || skipped(flags, y)) {
        return;
    }
    int fx = x * N + SX, fy = y * N + SY;
    for (int e = 0; e < 3; e++) {
        int k = r + 10 + 5 * e;
        if (records[k + 2] * (fy - N * records[k + 1]) - records[k + 3] * (fx - N * records[k]) < records[k + 4]) {
            return;
        }
    }
    int dx = attribute_point(fx) - 256 * records[r + 25], dy = attribute_point(fy) - 256 * records[r + 26];
    ivec3 rgb = colour(r);
    if ((flags & SHADED) != 0u) {
        for (int k = 0; k < 3; k++) {
            rgb[k] = interpolate_fine(records[r + 27 + k], records[r + 32 + 2 * k], dx, records[r + 33 + 2 * k], dy) >> 8;
        }
    }
    uvec2 u = uvec2(0u), v = uvec2(0u);
    int fu = 0, fv = 0;
    ivec4 limits = ivec4(0, -1, 0, -1);
    if ((flags & TEXTURED) != 0u) {
        uint range = uint(records[r + 9]);
        fu = within(interpolate_fine(records[r + 30], records[r + 38], dx, records[r + 39], dy), range);
        fv = within(interpolate_fine(records[r + 31], records[r + 40], dx, records[r + 41], dy), range >> 16);
        u = texel_of(fu);
        v = texel_of(fv);
        if ((flags & FILTERED) != 0u) {
            uint window = uint(records[r + 7]);
            limits = ivec4(filter_limits(range, records[r + 38], records[r + 39], window & 0xFFu), filter_limits(range >> 16, records[r + 40], records[r + 41], (window >> 8) & 0xFFu));
        }
    }
    shade(pixel, r, flags, x, y, rgb, u.x, v.x, int(u.y), int(v.y), fu, fv, limits);
}


// The mark of an edge of a precise triangle, at `j` in its record: fifteen bits of its two ends, the same from either
// triangle that has it, and never zero; with BEYOND, the mark of a pixel filled past that edge (§33.3).
const uint BEYOND = 0x8000u;

uint point_mark(int x, int y) {
    uint h = uint(x) * 0x9E3779B1u + uint(y) * 0x85EBCA77u;
    return (h ^ (h >> 15)) * 0xC2B2AE3Du;
}

uint edge_mark(int j) {
    uint h = point_mark(records[j], records[j + 1]) + point_mark(records[j] + records[j + 2], records[j + 1] + records[j + 3]);
    return max((h ^ (h >> 16)) & 0x7FFFu, 1u);
}

// Whether the console's own triangle covers the sample at (x, y) in N x units, the precise triangle's vertices without
// their fractions by the integer rule; and the sample's place in it at its attribute point, the weight of the vertex
// opposite each edge, N times its edge function there (§33.2, §39.7).
bool console_covers(int r, uint flags, int x, int y, out float place[3]) {
    ivec2 v[3];
    for (int k = 0; k < 3; k++) {
        int j = r + 10 + 5 * k, f = records[j + 4];
        v[k] = ivec2(records[j] - ((f << 16) >> 16), records[j + 1] - (f >> 16)) >> 8;
    }
    int turn = (flags & TURNED) != 0u ? -1 : 1;
    for (int k = 0; k < 3; k++) {
        ivec2 a = v[k], d = v[(k + 1) % 3] - a;
        int edge = turn * (d.x * (y - N * a.y) - d.y * (x - N * a.x));
        if (edge < int((flags >> (OWN_BOUNDS + uint(k))) & 1u)) {
            return false;
        }
        place[k] = float(edge) - float(turn * (d.x - d.y)) * 0.5 * float(N - 1);
    }
    return true;
}

// A coordinate, (c + 1/2) in 256ths, held within the texels `lo..hi`: past an end, that end's texel at its sample nearest
// the inside.
int hold(int c, uint lo, uint hi) {
    return clamp(c, int(lo) * 256, int(hi) * 256 + 255);
}

// A triangle with precise vertices in 256ths of a pixel: each edge function exact in 64 bits against its owner's bound,
// the colour and an untilted texture by the fine gradients, a tilted texture in perspective from the three edge
// functions and the vertices' depths, a division a pixel (§22.2, §22.3). A pixel it does not cover and the console's own
// triangle does is filled, as its place in that triangle taken to this one, unless a precise triangle across the edge it
// lies beyond drew it; and never blended, but over a pixel filled past the same edge (§33).
void fine_triangle(inout uint pixel, int r, uint flags, int x, int py) {
    int y = row_of(r, py);
    if (!inside(r, x, y) || skipped(flags, y)) {
        return;
    }
    // The sample's coverage point in 256ths times N, exact at every scale; its edge functions are N times the point's.
    int cx = x * N + SX, cy = y * N + SY;
    int fx = 256 * cx, fy = 256 * cy;
    float e[3];
    uint outside = 0u;
    for (int k = 0; k < 3; k++) {
        int j = r + 10 + 5 * k;
        int h1, l1, h2, l2;
        imulExtended(records[j + 2], fy - N * records[j + 1], h1, l1);
        imulExtended(records[j + 3], fx - N * records[j], h2, l2);
        uint borrow;
        uint lo = usubBorrow(uint(l1), uint(l2), borrow);
        int hi = h1 - h2 - int(borrow);
        if (hi < 0 || (hi == 0 && lo < ((flags >> (BOUNDS + uint(k))) & 1u))) {
            if ((flags & FILLED) == 0u) {
                return;
            }
            outside |= 1u << k;
        } else {
            e[k] = float(hi) * 4294967296.0 + float(lo);
        }
    }
    uint mark = pixel >> 16, beyond = 0u;
    bool follows = false;
    int dx = attribute_point(cx) - records[r + 25], dy = attribute_point(cy) - records[r + 26];
    if (outside != 0u) {
        if (!console_covers(r, flags, cx, cy, e)) {
            return;
        }
        vec2 place = vec2(0.0);
        for (int k = 0; k < 3; k++) {
            int j = r + 10 + 5 * k;
            if ((outside & (1u << k)) != 0u) {
                beyond = edge_mark(j) | BEYOND;
                if (mark == (beyond ^ BEYOND)) {
                    return;
                }
                follows = follows || mark == beyond;
            }
            place += e[(k + 1) % 3] * vec2(float(records[j]), float(records[j + 1]));
        }
        place = floor(place / (e[0] + e[1] + e[2]) + 0.5);
        dx = int(place.x) - records[r + 25];
        dy = int(place.y) - records[r + 26];
    }
    ivec3 rgb = colour(r);
    if ((flags & SHADED) != 0u) {
        for (int k = 0; k < 3; k++) {
            rgb[k] = interpolate_fine(records[r + 27 + k], records[r + 32 + 2 * k], dx, records[r + 33 + 2 * k], dy) >> 8;
        }
    }
    uvec2 u = uvec2(0u), v = uvec2(0u);
    int fu = 0, fv = 0;
    uint held = uint(records[r + 9]);
    // The vertices' own coordinates' range, packed as the integer record's word 9.
    uint range = 0u;
    if (N > 1 || (flags & FILTERED) != 0u) {
        ivec3 cu = ivec3(records[r + 42], records[r + 43], records[r + 44]) & 0xFF, cv = (ivec3(records[r + 42], records[r + 43], records[r + 44]) >> 8) & 0xFF;
        range = uint(min(cu.x, min(cu.y, cu.z)) | max(cu.x, max(cu.y, cu.z)) << 8 | min(cv.x, min(cv.y, cv.z)) << 16 | max(cv.x, max(cv.y, cv.z)) << 24);
    }
    if ((flags & PERSPECTIVE) != 0u) {
        float w = 0.0, su = 0.0, sv = 0.0;
        for (int k = 0; k < 3; k++) {
            int uv = records[r + 42 + k];
            // The weights at the attribute point: at N x the coverage point's, less half a pixel less half a sample (§39.1).
            int j = r + 10 + 5 * k;
            float ek = outside != 0u ? e[k] : e[k] - float(records[j + 2] - records[j + 3]) * 128.0 * float(N - 1);
            float a = ek * intBitsToFloat(records[r + 45 + k]);
            w += a;
            su += a * float(uv & 0xFF);
            sv += a * float((uv >> 8) & 0xFF);
        }
        fu = within(int(floor((su / w + 0.5) * 256.0)), range);
        fv = within(int(floor((sv / w + 0.5) * 256.0)), range >> 16);
    } else if ((flags & TEXTURED) != 0u) {
        fu = within(interpolate_fine(records[r + 30], records[r + 38], dx, records[r + 39], dy), range);
        fv = within(interpolate_fine(records[r + 31], records[r + 40], dx, records[r + 41], dy), range >> 16);
    }
    fu = hold(fu, held & 0xFFu, (held >> 8) & 0xFFu);
    fv = hold(fv, (held >> 16) & 0xFFu, held >> 24);
    u = texel_of(fu);
    v = texel_of(fv);
    ivec4 limits = ivec4(0, -1, 0, -1);
    if ((flags & FILTERED) != 0u) {
        uint window = uint(records[r + 7]);
        limits = ivec4(filter_limits(range, records[r + 38], records[r + 39], window & 0xFFu), filter_limits(range >> 16, records[r + 40], records[r + 41], (window >> 8) & 0xFFu));
        // The texel hold of §26.3 narrows them further.
        limits = ivec4(max(limits.x, int(held & 0xFFu)), min(limits.y, int((held >> 8) & 0xFFu)), max(limits.z, int((held >> 16) & 0xFFu)), min(limits.w, int(held >> 24)));
    }
    if (outside != 0u && (flags & BLEND) != 0u && !follows && ((flags & TEXTURED) == 0u || (texel(r, u.x, v.x, int(u.y), int(v.y)) & 0x8000u) != 0u)) {
        return;
    }
    // A write leaves the pixel's high half clear: the mark is then the nearest edge's, or that of the edge filled past.
    pixel |= 0xFFFF0000u;
    shade(pixel, r, flags, x, y, rgb, u.x, v.x, int(u.y), int(v.y), fu, fv, limits);
    if ((pixel >> 16) != 0u) {
        pixel = (pixel & 0xFFFFu) | (mark << 16);
    } else if (outside == 0u) {
        int n = e[0] <= e[1] ? (e[0] <= e[2] ? 0 : 2) : (e[1] <= e[2] ? 1 : 2);
        pixel |= edge_mark(r + 10 + 5 * n) << 16;
    } else {
        pixel |= beyond << 16;
    }
}

// A texel's texture cache entry in the window, for a rectangle's pairs (raster.rs's `rectangle`).
uint entry(int r, uint u) {
    uint w = uint(records[r + 7]);
    uint mu = w & 0xFFu, ou = (w >> 16) & 0xFFu;
    uint depth = uint(records[r + 6]) & 0xFFu;
    return (((u & ~mu) | (ou & mu)) & 0xFFu) >> (4u - depth);
}

void rectangle(inout uint pixel, int r, uint flags, int x, int py) {
    int y = row_of(r, py);
    if (!inside(r, x, y) || skipped(flags, y)) {
        return;
    }
    uint v = uint(records[r + 13] + records[r + 15] * (y - records[r + 11])) & 0xFFu;
    uint u = uint(records[r + 12] + records[r + 14] * (x - records[r + 10])) & 0xFFu;
    if ((flags & PAIRS) != 0u && (x & 1) == 1 && x > records[r + 1]) {
        uint left = (u - 1u) & 0xFFu;
        if (entry(r, u) != entry(r, left)) {
            u = left;
        }
    }
    // A sprite is a texel a pixel: the sample within the texel's block is the sample within the pixel's, mirrored with a
    // flip, so that what was drawn at N x is copied at N x (§39.2).
    int su = records[r + 14] < 0 ? N - 1 - SX : SX, sv = records[r + 15] < 0 ? N - 1 - SY : SY;
    // Filtered, the sample's place in its texel as a coordinate; held within the sprite's own texels (word 9).
    int fu = int(u) * 256 + (su * 256 + 128) / N, fv = int(v) * 256 + (sv * 256 + 128) / N;
    ivec4 limits = ivec4(0, -1, 0, -1);
    if ((flags & FILTERED) != 0u) {
        uint range = uint(records[r + 9]), window = uint(records[r + 7]);
        limits = ivec4(int(range & 0xFFu), (window & 0xFFu) != 0u ? -1 : int((range >> 8) & 0xFFu), int((range >> 16) & 0xFFu), ((window >> 8) & 0xFFu) != 0u ? -1 : int(range >> 24));
    }
    shade(pixel, r, flags, x, y, colour(r), u, v, su, sv, fu, fv, limits);
}

void line(inout uint pixel, int r, uint flags, int x, int py) {
    int y = row_of(r, py);
    if (!inside(r, x, y) || skipped(flags, y)) {
        return;
    }
    int ax = records[r + 10], ay = records[r + 11], dx = records[r + 12], dy = records[r + 13], n = records[r + 14];
    int k = 0;
    if (n == 0) {
        if (x != ax || y != ay) {
            return;
        }
    } else if (records[r + 15] != 0) {
        k = (x - ax) * sign(dx);
        if (k < 0 || k > n || ay + sign(dy) * floor_div(2 * k * abs(dy) + (dx < 0 ? n - 1 : n), 2 * n) != y) {
            return;
        }
    } else {
        k = (y - ay) * sign(dy);
        if (k < 0 || k > n || ax + floor_div(2 * k * dx + n - 1, 2 * n) != x) {
            return;
        }
    }
    ivec3 rgb;
    for (int c = 0; c < 3; c++) {
        rgb[c] = ((records[r + 16 + c] << 12) + records[r + 19 + c] * k + 2048) >> 12;
    }
    shade(pixel, r, flags, x, y, rgb, 0u, 0u, 0, 0, 0, 0, ivec4(0, -1, 0, -1));
}

void fill(inout uint pixel, int r, uint flags, int px, int py) {
    uint i = uint(px - records[r + 10]) & 1023u, j = uint(py - records[r + 11]) & 511u;
    if (i >= uint(records[r + 12]) || j >= uint(records[r + 13]) || skipped(flags, py)) {
        return;
    }
    pixel = uint(records[r + 14]);
    LOW = uint(records[r + 15]);
}

void transfer(inout uint pixel, int r, uint flags, int px, int py) {
    uint w = uint(records[r + 12]);
    uint i = uint(px - records[r + 10]) & 1023u, j = uint(py - records[r + 11]) & 511u;
    if (i >= w || j >= uint(records[r + 13])) {
        return;
    }
    uint k = j * w + i;
    if (k < uint(records[r + 14]) || k >= uint(records[r + 15])) {
        return;
    }
    if ((flags & CHECK) != 0u && (pixel & 0x8000u) != 0u) {
        return;
    }
    uint d = uint(records[r + 16]) + k - uint(records[r + 14]);
    pixel = ((data[d >> 1] >> ((d & 1u) * 16u)) & 0xFFFFu) | ((flags & SET) != 0u ? 0x8000u : 0u);
    LOW = 0u;
}

void main() {
    N = int(scale);
    uvec4 t = tiles[first_tile + gl_WorkGroupID.x];
    uint block = gl_WorkGroupID.y;
    int sx = int((t.x & 127u) * 8u * scale + (block % scale) * 8u + gl_LocalInvocationID.x);
    int sy = int((t.x >> 7) * 8u * scale + (block / scale) * 8u + gl_LocalInvocationID.y);
    int px = sx / N, py = sy / N;
    SX = sx - px * N;
    SY = sy - py * N;
    uint index = uint(sy) * 1024u * scale + uint(sx);
    uint pixel = vram[index];
    TRUE_COLOUR = (options & COLOUR) != 0u;
    LOW = TRUE_COLOUR ? fine[index] : 0u;
    for (uint e = t.y; e < t.y + t.z; e++) {
        int r = int(entries[e]) * WORDS;
        uint flags = uint(records[r]);
        uint kind = flags & 0xFu;
        if (kind == TRIANGLE) {
            triangle(pixel, r, flags, px, py);
        } else if (kind == RECTANGLE) {
            rectangle(pixel, r, flags, px, py);
        } else if (kind == LINE) {
            line(pixel, r, flags, px, py);
        } else if (kind == FILL) {
            fill(pixel, r, flags, px, py);
        } else if (kind == TRANSFER) {
            transfer(pixel, r, flags, px, py);
        } else if (kind == PRECISE) {
            fine_triangle(pixel, r, flags, px, py);
        }
    }
    vram[index] = pixel;
    if (TRUE_COLOUR) {
        fine[index] = LOW;
    }
}
