# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command spaces
usage 1   spaces                        list available memory spaces

case the fake target's spaces
target fake
covers 1
$ spaces
out 219
GOLDEN memory spaces:
  RAM             256 bytes  R/W
  ROM             512 bytes  R/O
  VRAM           1024 bytes  R/W
  IO               16 bytes  R/W
  UNSIZED           0 bytes  R/O
  CpuBus        65536 bytes  R/W
status 0
action none
end

case a bare target
target bare
covers 1
$ spaces
out 219
GOLDEN memory spaces:
  RAM             256 bytes  R/W
  ROM             512 bytes  R/O
  VRAM           1024 bytes  R/W
  IO               16 bytes  R/W
  UNSIZED           0 bytes  R/O
  CpuBus        65536 bytes  R/W
status 0
action none
end

case with no target
target none
covers 1
$ spaces
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
end

case on venusrt
target venusrt
covers 1
$ spaces
out 286
VenusRT memory spaces:
  CpuBus     16777216 bytes  R/W
  IO             1024 bytes  R/O
  WRAM         131072 bytes  R/W
  VRAM          65536 bytes  R/W
  CGRAM           512 bytes  R/W
  OAM             544 bytes  R/W
  SRAM              0 bytes  R/W
  APURAM        65536 bytes  R/W
status 0
action none
end

