<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Mistress.Views.InputSettingsWindow"
        Title="Controller Settings"
        Width="680" Height="480"
        MinWidth="680" MinHeight="360"
        CanResize="True">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="Click Rebind Key then press a keyboard key, or Rebind Pad then press a button on your controller. Escape cancels a key rebind in progress."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Reset to Defaults" Click="OnResetClick" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
            <CheckBox x:Name="MirrorPlayer1ToPlayer2CheckBox"
                      Content="Mirror Player 1 input to Player 2"
                      IsCheckedChanged="OnMirrorPlayer1ToPlayer2Changed" />
            <TextBlock Text="Compatibility option for games that read Controller 2 instead of Controller 1 (e.g. Super Mario All-Stars' classic Mario games). Leave off for real two-player sessions."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="24,2,0,0" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel x:Name="BindingsPanel" Spacing="6" />
        </ScrollViewer>

    </DockPanel>

</Window>
