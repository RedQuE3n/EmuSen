<Project>
  <!--
    MarsRT's library in a publish for another platform - see Mars_Native.md §6.3.

    EmuSen.csproj builds the crate for the machine it runs on and copies that
    library beside the assemblies, and the SDK builds a referenced library
    without the publish's RuntimeIdentifier, so a publish for win-x64 made on
    Linux would carry libmarsrt.so and nothing Windows could load. Imported by
    the published frontends, this drops the host's library from a foreign
    publish and puts the platform's own in its place, taken from
    $(EmuSenNativePrebuilt)/<rid>/<library>, where the MarsRT workflow's
    artefacts go; without one it warns, since the N64 would run on Mars alone.
  -->

  <PropertyGroup>
    <!-- A distribution's SDK names its host by distribution (fedora.44-x64); the portable name is what a publish asks for. -->
    <EmuSenNativeForeign Condition="'$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != '$(NETCoreSdkRuntimeIdentifier)' And '$(RuntimeIdentifier)' != '$(NETCoreSdkPortableRuntimeIdentifier)'">true</EmuSenNativeForeign>
    <EmuSenNativePublishFile Condition="$(RuntimeIdentifier.StartsWith('win'))">marsrt.dll</EmuSenNativePublishFile>
    <EmuSenNativePublishFile Condition="$(RuntimeIdentifier.StartsWith('osx'))">libmarsrt.dylib</EmuSenNativePublishFile>
    <EmuSenNativePublishFile Condition="'$(EmuSenNativePublishFile)' == ''">libmarsrt.so</EmuSenNativePublishFile>
    <EmuSenNativePrebuiltFile Condition="'$(EmuSenNativePrebuilt)' != ''">$(EmuSenNativePrebuilt)/$(RuntimeIdentifier)/$(EmuSenNativePublishFile)</EmuSenNativePrebuiltFile>
  </PropertyGroup>

  <Target Name="MarsRtForeignLibrary"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForeign)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libmarsrt.so' Or '%(Filename)%(Extension)' == 'marsrt.dll' Or '%(Filename)%(Extension)' == 'libmarsrt.dylib'" />
    </ItemGroup>
    <Warning Condition="'$(EmuSenNativePrebuiltFile)' == '' Or !Exists('$(EmuSenNativePrebuiltFile)')"
             Text="No MarsRT library for $(RuntimeIdentifier): this publish runs the N64 on Mars (C#) alone. Build $(EmuSenNativePublishFile) with the MarsRT workflow and pass -p:EmuSenNativePrebuilt=&lt;dir&gt; holding $(RuntimeIdentifier)/$(EmuSenNativePublishFile)." />
    <ItemGroup Condition="'$(EmuSenNativePrebuiltFile)' != '' And Exists('$(EmuSenNativePrebuiltFile)')">
      <ResolvedFileToPublish Include="$(EmuSenNativePrebuiltFile)" RelativePath="$(EmuSenNativePublishFile)" CopyToPublishDirectory="PreserveNewest" AssetType="native" />
    </ItemGroup>
  </Target>
</Project>
