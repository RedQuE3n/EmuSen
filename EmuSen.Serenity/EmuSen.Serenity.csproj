<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- FramePresenter drives an actual Raylib window/GPU texture pipeline
         directly - see FramePresenter.cs's own notes on why this can't be
         a truly rendering-API-agnostic abstraction. What IS shared here is
         the core-agnostic INPUT contract (byte[] rgba, width, height, via
         ICore) and the built-in shader source, so any frontend consuming
         this project gets the same effects/behavior instead of a
         hand-copied duplicate. -->
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
  </ItemGroup>

</Project>
