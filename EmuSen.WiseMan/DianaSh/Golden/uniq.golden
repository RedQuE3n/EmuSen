# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command uniq
usage 1   uniq [-c] [-D] [-w <chars>]   collapse adjacent duplicate lines (-c prefixes each with its
usage 2                                 repeat count; -D prints every line of each run of two or more;
usage 3                                 -w compares only the first <chars> characters) - sort first

case adjacent duplicates
target none
covers 1-3
file a.txt 12
a
a
b
a
b
b

$ cat a.txt | uniq
out 7
a
b
a
b
status 0
action none
$ cat a.txt | uniq -c
out 15
2 a
1 b
1 a
2 b
status 0
action none
$ cat a.txt | sort | uniq -c
out 7
3 a
3 b
status 0
action none
$ uniq a a b
out 5
a a b
status 0
action none
$ uniq
out 0

status 0
action none
end

case every line of each run, and a key of the first characters
target none
file b.txt 22
abc 1
abc 2
abd 3
x
x

$ cat b.txt | uniq -D
out 3
x
x
status 0
action none
$ cat b.txt | uniq -D -w 3
out 15
abc 1
abc 2
x
x
status 0
action none
$ cat b.txt | uniq -w 2
out 7
abc 1
x
status 0
action none
$ cat b.txt | uniq -c -w2
out 11
3 abc 1
2 x
status 0
action none
$ uniq -c -D
out 135
uniq: -c and -D together are meaningless: every line of a run is printed, not counted
Usage: uniq [-c] [-D] [-w <chars>] - see man uniq
status 1
action none
$ uniq -w
out 87
uniq: -w needs a number of characters
Usage: uniq [-c] [-D] [-w <chars>] - see man uniq
status 1
action none
end
