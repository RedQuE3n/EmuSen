 {
 #ifndef DUMMYCPU
 	_emu->ProcessInstruction<CpuType::Nes>();
+	uint64_t cycleBefore = 0;
+	if(g_cpuTraceOn) {
+		// DebugRead, not GetOPCode: the real fetch advances PC and burns a cycle,
+		// so tracing has to read the opcode without touching the machine.
+		PushNesCpuTrace(_state, _state.PC, _memoryManager->DebugRead(_state.PC), 0);
+		cycleBefore = _state.CycleCount;
+	}
 #endif
 
 	uint8_t opCode = GetOPCode();
