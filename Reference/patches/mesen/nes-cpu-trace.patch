+// 6502 trace in the same 24-byte ESCT record the S-CPU uses, and into the same
+// buffer - see EmuSen_Debugging_Tools_Reference_v5.md §3.52. One machine runs at
+// a time, so one buffer is enough, and one record layout means --cputrace and
+// Pharaoh's --tracediff mean the same thing on both consoles. The 65816-only
+// fields are the constants the 6502 makes them: D and DBR zero, E set, and the
+// 8-bit registers in the low byte. Defined by patches/mesen/cpu-trace.patch.
+extern bool g_cpuTraceOn;
+extern std::vector<uint8_t> g_cpuTrace;
+
+static void PushNesCpuTrace(NesCpuState& s, uint16_t addr, uint8_t opcode, uint8_t kind)
+{
+	if(!g_cpuTraceOn || g_cpuTrace.size() >= 2000000000u) { return; }
+
+	uint8_t r[24] = {};
+	r[0] = (uint8_t)addr;       r[1] = (uint8_t)(addr >> 8);
+	r[4] = opcode;              r[5] = kind;
+	r[6] = s.A;
+	r[8] = s.X;
+	r[10] = s.Y;
+	r[12] = s.SP;
+	r[17] = s.PS;               r[18] = 1;
+	g_cpuTrace.insert(g_cpuTrace.end(), r, r + 24);
+}
+
+// The cost field is CPU cycles here and master-clock ticks on the S-CPU. Both
+// are self-consistent, and a trace is only ever compared with another trace of
+// the same machine, so the units never meet.
+static void SetLastNesCpuTraceCost(uint32_t cycles)
+{
+	size_t n = g_cpuTrace.size();
+	if(n < 24) { return; }
+	g_cpuTrace[n - 4] = (uint8_t)cycles;         g_cpuTrace[n - 3] = (uint8_t)(cycles >> 8);
+	g_cpuTrace[n - 2] = (uint8_t)(cycles >> 16); g_cpuTrace[n - 1] = (uint8_t)(cycles >> 24);
+}
+
