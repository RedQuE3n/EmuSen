<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmuSen.Mistress.Views"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        x:Class="EmuSen.Mistress.Views.ActiveCheatsWindow"
        Title="Active Cheats"
        Width="720" Height="600"
        MinWidth="560" MinHeight="440">

    <DockPanel Margin="16">

        <!-- General first, then consoles oldest-first; console tabs are appended
             by BuildConsoleTabs so a new core needs no XAML - see §4.14. -->
        <luna:Tabs DockPanel.Dock="Top" x:Name="Tabs" SelectionChanged="OnTabChanged" Margin="0,0,0,12">

            <TabItem Header="General">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <!-- One switch over the whole list, independent of each cheat's own box - see §4.14. -->
                    <Border Padding="10" CornerRadius="4" Background="{DynamicResource SystemChromeLowColor}">
                        <StackPanel Spacing="4">
                            <luna:LunaSwitch x:Name="MasterSwitch" Label="Enable cheats" />
                            <luna:HintText x:Name="MasterHintText" />
                        </StackPanel>
                    </Border>

                    <!-- Saving is per game, not per console - see §4.15. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Saved cheat list" FontWeight="Bold" />
                        <luna:HintText x:Name="SaveTargetText" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" />
                            <Button x:Name="LoadButton" Content="Load" Click="OnLoadClick" />
                            <Button x:Name="SaveAsButton" Content="Save As..." Click="OnSaveAsClick" />
                            <Button x:Name="LoadFromButton" Content="Load From..." Click="OnLoadFromClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </luna:Tabs>

        <TextBlock DockPanel.Dock="Top" x:Name="ListHeaderText" FontWeight="Bold" Margin="0,0,0,8" />

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <luna:ButtonBar Grid.Column="1">
                    <Button x:Name="ApplyButton" Content="Apply Cheats" Click="OnApplyClick" />
                    <Button x:Name="RemoveButton" Content="Remove" IsEnabled="False" Click="OnRemoveClick" />
                    <Button x:Name="ClearButton" Content="Remove All" Click="OnClearClick" />
                    <Button Content="Close" Click="OnCloseClick" />
                </luna:ButtonBar>
            </Grid>
        </Border>

        <ListBox x:Name="CheatsList" SelectionChanged="OnCheatSelected">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:CheatRow">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kind}"
                                   Foreground="{DynamicResource LunaMuted}"
                                   FontSize="11"
                                   Width="34"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Description}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Detail}"
                                   Foreground="{DynamicResource LunaMuted}"
                                   FontFamily="monospace"
                                   FontSize="11"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</Window>
