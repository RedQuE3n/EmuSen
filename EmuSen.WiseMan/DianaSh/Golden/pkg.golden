case with no library set, every request is refused before anything is read or written
target none
covers 1-4
$ pkg ls
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg check NES
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg make /
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg migrate NES/a.nes
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg patch add NES/a.nes /a.ips
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg patch rm NES/a.nes 1
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg make nes --self-contained --zip
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg zip NES/a.nes
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg identity NES/a.nes patched
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
$ pkg check NES/a.nes.zip
out 87
pkg: AppSettings.RomDirectory is not set: there is no library for a package to link to.
status 1
action none
end
