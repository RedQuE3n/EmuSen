<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core-agnostic timing scheduler: a master clock, devices that run
       themselves forward to a deadline, and events identified by a plain int
       - see EmuSen_Crystal_Scheduler.md.

       Deliberately a leaf: no ProjectReference, no PackageReference, the same
       constraint EmuSen.Galaxia carries and for a stronger reason. Every core
       sits above this, so anything Crystal depended on upward would be a
       dependency every future core inherits. It is also what keeps the
       abstraction honest - nothing here can name a scanline, an NMI or a
       SnesButton, so "agnostic" is enforced by the build rather than by
       discipline. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
