# Breakpoints, watches, frame logs, coverage, the profile, counters, the call stack, freezes and labels, through the
# twins and the tables, on the v1 test core.
log_switch 0
open $GAME
bp_list 0
bp_add 0 '{"address":5}'
bp_add 4294967295 '{"address":5,"end":3}'
bp_add 0 '{"address":16,"end":18,"condition":"F == 17"}'
bp_add 0 '{"address":32,"log":"F, timer.Count, [2]"}'
bp_add 0 '{"address":48,"condition":"Nope"}'
bp_add 0 '{"address":48,"condition":"[9999]"}'
bp_add 0 '{"address":48,"condition":"1 +"}'
bp_add 0 '{"address":48,"log":"F,"}'
bp_add 0 '{"address":4294967295}'
bp_add 0 '{"address":-1}'
bp_add 0 '{"address":4294967296}'
bp_add 0 '{"address":1.5}'
bp_add 0 '{"address":"one"}'
bp_add 0 '{"end":1}'
bp_add 0 '{"address":1,"condition":7}'
bp_add 0 '[1]'
bp_add 0 'x'
bp_add 0 -
bp_add 0 ''
bp_add 9 '{"address":1}'
bp_list 0
bp_list 4294967295
bp_list 9
frames 10
halt_state 0
bp_list 0
run_control 1 0 0
frames 1
run_control 1 0 0
frames 25
halt_state 0
run_control 1 0 0
frames 40
run_control 1 0 0
frames 40
bp_list 0
bp_log 0 5
bp_log 0 1
bp_log 0 0x80000000
bp_set_enabled 0 1 0
bp_set_enabled 0 99 1
bp_set_enabled 0 4294967295 1
bp_remove 0 2
bp_remove 0 2
bp_add_data 0 '{"space":"ram","address":2,"value":-1,"changed_only":true}'
bp_add_data 0 '{"space":"RAM","address":3,"end":1,"on_read":true,"condition":"F > 0","log":"F"}'
bp_add_data 0 '{"space":"NOPE","address":3}'
bp_add_data 0 '{"address":3}'
bp_add_data 0 '{"space":"RAM","address":3,"value":4294967296}'
bp_add_data 0 '{"space":"RAM","address":3,"on_read":1}'
bp_add_data 0 '{"space":"RAM","address":3,"condition":"Nope"}'
bp_forbid_range 0 0x40 0x30
bp_depth_guard 0 3
bp_depth_guard 0 -1
bp_depth_guard 0 0
bp_uninitialized 0 RAM 8
bp_uninitialized 0 NOPE 8
bp_uninitialized 0 RAM 0
bp_uninitialized 0 RAM 0x80000000
bp_list 0
bp_uninitialized 0 - 0
bp_conditions 0
bp_conditions 9
bp_arm_condition 0 vblank 0
bp_arm_condition 0 vblank 2
bp_arm_condition 0 - 2
bp_arm_condition 0 vblank 4
bp_log_clear 0
bp_log 0 5
bp_remove 0 1
bp_remove 0 3
bp_remove 0 4
bp_remove 0 5
bp_remove 0 6
bp_remove 0 7
bp_remove 0 8
run_control 1 0 0
frames 3
halt_state 0
via table
bp_add 0 '{"address":64}'
bp_list 0
bp_set_enabled 0 9 0
bp_remove 0 9
via ro
bp_add 0 '{"address":64}'
bp_add 0 'x'
bp_remove 0 1
bp_list 0
bp_log 0 1
bp_log_clear 0
bp_depth_guard 0 1
via stranger
bp_add 0 '{"address":64}'
bp_list 0
# Watches and frame logs
via twin
bp_remove 0 10
bp_remove 0 11
bp_remove 0 12
run_control 1 0 0
frames 2
bp_list 0
halt_state 0
watch_add RAM 2 1 0
watch_add ram 0 255 2
watch_add RAM 0 1 3
watch_add RAM 0 0 0
watch_add NOPE 0 1 0
watch_add - 0 1 0
watch_add RAM 0 0x80000000 1
watch_list
frames 3
watch_events 1 5
watch_events 2 3
watch_events 9 5
watch_events 4294967295 5
watch_summary 1
watch_summary 2
watch_summary 9
watch_clear 1
watch_summary 1
watch_clear 9
watch_remove 2
watch_remove 2
via ro
watch_add RAM 2 1 0
watch_events 1 5
watch_clear 1
via twin
framelog_add RAM 2 1
framelog_add ram 1 2
framelog_add ROM 0 2
framelog_add RAM 0 0
framelog_add NOPE 0 1
framelog_list
frames 3
framelog_samples 1 5
framelog_samples 2 2
framelog_samples 3 5
framelog_samples 9 5
framelog_clear 1
framelog_samples 1 5
framelog_clear 9
framelog_remove 3
framelog_remove 3
via table
framelog_list
via ro
framelog_add RAM 3 1
framelog_remove 1
# Coverage and the profile
via twin
coverage_op 0 5 -
coverage_op 0 0 -
coverage_op 0 5 -
frames 5
coverage_op 0 5 -
coverage_op 0 6 '{"address":0,"length":256,"limit":300}'
coverage_op 0 6 '{"address":0,"length":256,"limit":3}'
coverage_op 0 6 '{"address":0}'
coverage_op 0 6 '{"address":0,"length":256,"limit":4294967296}'
coverage_op 0 7 '{"address":0,"length":256}'
coverage_op 0 3 -
frames 2
coverage_op 0 7 '{"address":0,"length":256,"limit":5}'
coverage_op 0 8 '{"limit":5}'
coverage_op 0 8 -
coverage_op 0 9 -
coverage_op 0 4 -
coverage_op 0 1 -
coverage_op 0 5 -
coverage_op 0 10 x:00
coverage_op 0 11 x:0102
coverage_op 0 11 x:0500000000000000FF00
coverage_op 0 5 -
coverage_op 0 12 -
coverage_op 0 5 'nope'
coverage_op 9 5 -
coverage_op 4294967295 5 -
coverage_op 0 2 -
coverage_op 0 5 -
via ro
coverage_op 0 0 -
coverage_op 0 5 -
coverage_op 0 13 -
via twin
profile_op 0 3 -
profile_op 0 0 -
frames 3
profile_op 0 3 -
profile_op 0 4 '{"limit":5}'
profile_op 0 4 -
profile_op 0 4 'nope'
profile_op 0 3 'nope'
profile_op 0 6 -
profile_op 9 3 -
profile_op 4294967295 3 -
via ro
profile_op 0 1 -
profile_op 0 5 -
profile_op 0 3 -
via twin
profile_op 0 1 -
profile_op 0 2 -
profile_op 0 3 -
profile_op 0 5 -
call_stack 0 5
call_stack 4294967295 5
call_stack 9 5
counters_op 3 -
counters_op 0 '{"space":"RAM","size":4}'
counters_op 99 'nope'
via ro
counters_op 0 -
via stranger
counters_op 3 -
coverage_op 0 5 -
# Freezes and labels
via twin
freeze_add RAM 2 0x77
freeze_add RAM 2 0x100
freeze_add NOPE 2 1
freeze_add ram 3 0x10
frames 2
space_read RAM 0 4
freeze_list
freeze_remove 1
freeze_remove 1
freeze_list
via ro
freeze_clear
via twin
freeze_clear
freeze_list
label_add 0x40 Here -
label_add 0x41 There "a comment"
label_add 0x42 "  " -
label_add 0x42 - -
label_list
label_at 0x40
label_at 0x41
label_at 0x43
label_remove There 0
label_remove - 0x40
label_remove - 0x40
label_remove Nope 0
label_list
label_load? "100 First\n0x101 Second note here\nbad\n"
label_list
label_load "100 First\n$101 Second note here\nbad\n\r\n"
label_list
label_save
via ro
label_add 0x44 Ro -
label_load "0x200 Ro"
label_save
label_clear
via table
label_clear
label_list
label_save
