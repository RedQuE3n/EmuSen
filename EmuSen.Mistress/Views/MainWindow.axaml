<luna:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Windowing;assembly=EmuSen.LunaP"
        xmlns:lunac="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        xmlns:lib="clr-namespace:EmuSen.Mistress.Library"
        xmlns:input="clr-namespace:EmuSen.Mistress.Input"
        xmlns:serenity="clr-namespace:EmuSen.Serenity;assembly=EmuSen.Serenity"
        x:Class="EmuSen.Mistress.Views.MainWindow"
        Title="EmuSen Testing Studio"
        Width="1024" Height="768"
        MinWidth="512" MinHeight="480">

    <DockPanel>

        <!-- Built from LunaActions in BuildMenus() - see EmuSen_Settings_Reference.md §4.12. -->
        <lunac:MenuBar x:Name="MenuStrip" DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Bottom"
                Padding="6,3"
                Background="{DynamicResource SystemChromeLowColor}">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Assigned from seventeen places, carrying transient results ("Applied 12
                     cheats"), permanent state ("No ROM loaded") and failures alike.
                     Polite announces a change at the next pause rather than
                     interrupting; a status line that interrupted on every update
                     would make the emulator unusable with a reader running. -->
                <TextBlock Grid.Column="0" x:Name="StatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Text="No ROM loaded" />
                <!-- Measured emulated frames/sec (TotalFrames delta over real
                     elapsed time), not a presentation/paint-rate counter -
                     see MainWindow.axaml.cs's EmulationLoop. Diagnostic for
                     telling "RunFrame() itself is behind real time" apart
                     from "presentation is just choppy" during the Testing
                     Studio slowdown investigation. -->
                <TextBlock Grid.Column="1" x:Name="FpsText" Text="" />
            </Grid>
        </Border>

        <!-- Two screens in one viewport: the library list until a game is
             running, the live frame after. Visibility is toggled in
             code-behind rather than bound - see EmuSen_Settings_Reference.md
             §4.11. GameFrameControl is EmuSen.Serenity's shared GPU
             (Skia/Ganesh) presentation surface, the same control Hotaru's
             GameWindow uses. -->
        <Grid Background="{DynamicResource LunaVoid}">
            <DockPanel x:Name="LibraryView" Margin="12">
                <!-- A full NES set is thousands of titles - see EmuSen_Multicore.md §10. -->
                <lunac:FilterBar DockPanel.Dock="Top"
                                 x:Name="LibraryFilter"
                                 ShowFacet="True"
                                 FacetLabel="Console:"
                                 Placeholder="Search titles"
                                 Margin="2,0,2,8" />
                <TextBlock DockPanel.Dock="Top"
                           x:Name="LibraryHeaderText"
                           Foreground="{DynamicResource LunaMuted}"
                           Margin="2,0,2,8" />
                <!-- Text is set in ShowLibraryEntries: it depends on whether a game is suspended. -->
                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="LibraryHintText"
                           Foreground="{DynamicResource LunaMuted}"
                           Margin="2,8,2,0" />
                <lunac:LunaList x:TypeArguments="lib:RomEntry"
                                x:Name="LibraryList"
                                AutomationProperties.Name="ROM library"
                                Background="Transparent"
                                DoubleTapped="OnLibraryItemActivated"
                                KeyDown="OnLibraryKeyDown" />
            </DockPanel>
            <serenity:GameFrameControl x:Name="GameFrame" IsVisible="False" />

            <!-- The pad's menu, over whichever screen is showing - see EmuSen_Settings_Reference.md §4.29. -->
            <Border x:Name="PadMenuPanel" IsVisible="False" Background="#D0000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28,22" CornerRadius="10" MinWidth="460"
                        Background="{DynamicResource LunaVoid}"
                        BorderBrush="{DynamicResource LunaMuted}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="PadMenuTitle" FontSize="24" Margin="0,0,0,12" />
                        <TextBlock DockPanel.Dock="Bottom" x:Name="PadMenuHint"
                                   Foreground="{DynamicResource LunaMuted}" Margin="0,12,0,0" />
                        <lunac:LunaList x:TypeArguments="input:PadMenuEntry"
                                        x:Name="PadMenuList"
                                        AutomationProperties.Name="Menu"
                                        FontSize="20" Background="Transparent" MaxHeight="520" />
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

    </DockPanel>

</luna:ToolWindow>
