<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:serenity="clr-namespace:EmuSen.Serenity;assembly=EmuSen.Serenity"
        x:Class="EmuSen.Mistress.Views.MainWindow"
        Title="EmuSen Testing Studio"
        Width="1024" Height="768"
        MinWidth="512" MinHeight="480">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open ROM..." Click="OnOpenRomClick" />
                <MenuItem Header="_Browse ROMs..." Click="OnBrowseRomsClick" />
                <Separator />
                <MenuItem Header="Game _Library" Click="OnShowLibraryClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>

            <!-- Pause/Reset still aren't implemented - individually disabled.
                 Save/Load State are real now (EmulatorSession.SaveState/
                 LoadState), so the menu itself no longer needs a blanket
                 disable. -->
            <MenuItem Header="_Emulation">
                <MenuItem Header="_Pause" IsEnabled="False" />
                <MenuItem Header="_Reset" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Save _State" Click="OnSaveStateClick" />
                <MenuItem Header="_Load State" Click="OnLoadStateClick" />
            </MenuItem>

            <MenuItem Header="_Settings">
                <MenuItem Header="_Controller Bindings..." Click="OnControllerBindingsClick" />
                <MenuItem Header="_Debug Logging..." Click="OnDebugLoggingClick" />
                <MenuItem Header="_Preferences..." Click="OnPreferencesClick" />
                <Separator />
                <MenuItem Header="_DianaOS Console..." Click="OnShellConsoleClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="6,3"
                Background="{DynamicResource SystemChromeLowColor}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="No ROM loaded" />
                <!-- Measured emulated frames/sec (TotalFrames delta over real
                     elapsed time), not a presentation/paint-rate counter -
                     see MainWindow.axaml.cs's EmulationLoop. Diagnostic for
                     telling "RunFrame() itself is behind real time" apart
                     from "presentation is just choppy" during the Testing
                     Studio slowdown investigation. -->
                <TextBlock Grid.Column="1" x:Name="FpsText" Text="" />
            </Grid>
        </Border>

        <!-- Two screens in one viewport: the library list until a game is
             running, the live frame after. Visibility is toggled in
             code-behind rather than bound - see EmuSen_Settings_Reference.md
             §4.11. GameFrameControl is EmuSen.Serenity's shared GPU
             (Skia/Ganesh) presentation surface, the same control Hotaru's
             GameWindow uses. -->
        <Grid Background="Black">
            <DockPanel x:Name="LibraryView" Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           x:Name="LibraryHeaderText"
                           Foreground="Gray"
                           Margin="2,0,2,8" />
                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="LibraryHintText"
                           Text="Double-click a title, or press Enter, to start it."
                           Foreground="Gray"
                           Margin="2,8,2,0" />
                <ListBox x:Name="LibraryList"
                         Background="Transparent"
                         DoubleTapped="OnLibraryItemActivated"
                         KeyDown="OnLibraryKeyDown" />
            </DockPanel>
            <serenity:GameFrameControl x:Name="GameFrame" IsVisible="False" />
        </Grid>

    </DockPanel>

</Window>
