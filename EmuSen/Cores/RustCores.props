<Project>
  <!-- The Rust cores: one row per crate, read by EmuSen.csproj's cargo build and by RustCoresPublish.targets, and repeated in rust-cores.yml's plan - see Mercury_Native.md §8.6 and EmuSen_RustPlatform.md §28. -->
  <PropertyGroup>
    <EmuSenRustCoresImported>true</EmuSenRustCoresImported>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <EmuSenRustCrate>
      <InDevelopment>false</InDevelopment>
      <Role>core</Role>
    </EmuSenRustCrate>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- Identity is the crate's library name; the fallback names the C# core a console runs on without the library, empty where there is none; CoreAbi 1 marks a library on the core ABI v1, whose sidecar the build writes; InDevelopment true keeps a core from players until its gate, see EmuSen_CoreAPI.md §27. -->
    <EmuSenRustCrate Include="diamond">
      <Dir>$(MSBuildThisFileDirectory)Sony\Diamond - PlayStation\v1\</Dir>
      <Core>Diamond</Core>
      <Console>the PlayStation</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="endou">
      <Dir>$(MSBuildThisFileDirectory)Sega\Endou - Master System\</Dir>
      <Core>Endou</Core>
      <Console>the Master System and the SG-1000</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="marsrt">
      <Dir>$(MSBuildThisFileDirectory)Nintendo\MarsRT - N64\</Dir>
      <Core>MarsRT</Core>
      <Console>the N64</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="mercuryrt">
      <Dir>$(MSBuildThisFileDirectory)Nintendo\MercuryRT - GB\</Dir>
      <Core>MercuryRT</Core>
      <Console>the Game Boy</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="moonrt">
      <Dir>$(MSBuildThisFileDirectory)Nintendo\MoonRT - NES\</Dir>
      <Core>MoonRT</Core>
      <Console>the NES</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="nephrite">
      <Dir>$(MSBuildThisFileDirectory)Sega\Nephrite - Genesis\</Dir>
      <Core>Nephrite</Core>
      <Console>the Genesis, the Sega CD and the 32X</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="sapphire">
      <Dir>$(MSBuildThisFileDirectory)Sony\Sapphire - PlayStation 2\</Dir>
      <Core>Sapphire</Core>
      <Console>the PlayStation 2</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="venusrt">
      <Dir>$(MSBuildThisFileDirectory)Nintendo\VenusRT - SNES\</Dir>
      <Core>VenusRT</Core>
      <Console>the SNES</Console>
      <Fallback></Fallback>
      <CoreAbi>1</CoreAbi>
    </EmuSenRustCrate>
  </ItemGroup>

  <!-- The libretro host's crates, Linux only while the broker confines a core only with Landlock: Role part is a library an installed entry copies (built, published, in cores.manifest, no sidecar), program an executable beside the assemblies, test a library the tests alone use - see EmuSen_LibretroHost.md §10d. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('linux')))">
    <EmuSenRustCrate Include="emusen_libretro_proxy">
      <Dir>$(MSBuildThisFileDirectory)Libretro\emusen-libretro-proxy\</Dir>
      <Core>the libretro proxy</Core>
      <Console>libretro cores</Console>
      <Fallback></Fallback>
      <Role>part</Role>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="emusen_libretro_host">
      <Dir>$(MSBuildThisFileDirectory)Libretro\emusen-libretro-host\</Dir>
      <Core>the libretro host</Core>
      <Console>libretro cores</Console>
      <Fallback></Fallback>
      <Role>part</Role>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="emusen-core-runner">
      <Dir>$(MSBuildThisFileDirectory)Shared\emusen-core-broker\</Dir>
      <Core>the core runner</Core>
      <Console>libretro cores</Console>
      <Fallback></Fallback>
      <Role>program</Role>
    </EmuSenRustCrate>
    <EmuSenRustCrate Include="emusen_libretro_testcore">
      <Dir>$(MSBuildThisFileDirectory)Libretro\emusen-libretro-testcore\</Dir>
      <Core>the libretro test core</Core>
      <Console>the libretro host's tests</Console>
      <Fallback></Fallback>
      <Role>test</Role>
      <InDevelopment>true</InDevelopment>
    </EmuSenRustCrate>
  </ItemGroup>
</Project>
