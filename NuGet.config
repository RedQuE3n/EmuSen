<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.LunaP lives in its own repository now, so it arrives as a package
     rather than as a ProjectReference. `local-packages` is a folder feed,
     resolved relative to this file so it works on any machine; populate it
     with `dotnet pack` in a checkout of EmuSen.LunaP, or replace this source
     with a real feed once the package is pushed to one.

         dotnet pack src/EmuSen.LunaP/EmuSen.LunaP.csproj -c Release \
             -o <path>/EmuSen Project/local-packages

     THE TRAP, recorded here because this is where somebody will hit it: NuGet
     caches by package id AND version. Repacking the toolkit at a version that
     is already in ~/.nuget/packages does not propagate, and the build fails on
     code that was just written as though it did not exist. Bump the version in
     LunaP's csproj, or delete ~/.nuget/packages/emusen.lunap first. See
     EmuSen_LunaP.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="lunap-local" value="local-packages" />
  </packageSources>
</configuration>
