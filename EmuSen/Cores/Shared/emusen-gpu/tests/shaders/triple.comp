#version 450
// The crate's test program: each word becomes three times itself plus the push constant. See EmuSen_Gpu.md §7.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Values { uint values[]; };
layout(push_constant) uniform Push { uint add; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(values.length())) {
        values[i] = values[i] * 3u + add;
    }
}
