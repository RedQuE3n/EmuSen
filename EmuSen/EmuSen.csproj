<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure library now - no Main, no window ownership, and since 2026-08-05
       no rendering framework either: Venus composites into its own
       internal Rgba32 struct, not Raylib_cs.Color - see Venus_PPU.md §15.1.
       The console frontend's Main/hotkey loop lives in EmuSen.Hotaru instead,
       so this project and EmuSen.Mistress (Avalonia) are true sibling
       consumers of the emulation core, neither depending on the other's
       frontend-specific code. See EmuSen_Project_Overview_v2.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Vulkan's binding is pointers throughout; only Mars's Rdp/Gpu uses them - see Mars_Gpu.md §1. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common/Imaging/PngFile.cs encodes with SKImage directly, so this is
         a real dependency of this project and not just something inherited
         through EmuSen.Serenity - listed explicitly to match this file's
         own "be explicit about what's actually used" convention. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Managed binding only: the loader and the driver are the system's, and their absence is the CPU path - see Mars_Gpu.md §1. -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled from the .comp beside each by WiseMan, which also holds them equal - see Mars_Gpu.md §2. -->
    <EmbeddedResource Include="Cores\Nintendo\Mars - N64\Rdp\Gpu\Shaders\*.spv" LogicalName="Mars.Gpu.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- FramePresenter/GraphicsSettings/BuiltInShaders live here now, not
         in this project - see EmuSen.Serenity.csproj's own note on why
         presentation-layer code moved out to its own shared project. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- SnesDebugTarget implements IDebugTarget and its
         ICheatCodeCodec/ICpuTraceSwitch adapter classes plug into
         DianaOS's own extension points - see IDebugTarget.cs's own
         header comment on why DianaOS itself has zero reference back to
         this project. EmuSen.Cauldron is referenced transitively through
         this (SnesDebugTarget builds PollingProvider<T> instances
         directly), listed explicitly anyway to match this project's own
         "be explicit about what's actually used" convention. -->
    <ProjectReference Include="..\EmuSen.DianaOS\EmuSen.DianaOS.csproj" />
    <ProjectReference Include="..\EmuSen.Cauldron\EmuSen.Cauldron.csproj" />
    <!-- AudioConfig, which AudioSettings maps to and from - see
         EmuSen_Config_Reference.md §3.2. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

  <!-- MarsRT, the Rust N64 core, built by cargo for this machine when it is installed and copied beside the assemblies; without it Mars runs its C# paths - see Mars_Native.md §1. A publish for another platform swaps the library in MarsRtPublish.targets, §6.3. -->
  <PropertyGroup>
    <EmuSenNativeDir>$(MSBuildThisFileDirectory)Cores\Nintendo\MarsRT - N64\</EmuSenNativeDir>
    <EmuSenNativeTarget>$(MSBuildProjectDirectory)/obj/marsrt</EmuSenNativeTarget>
    <EmuSenNativeFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">marsrt.dll</EmuSenNativeFile>
    <EmuSenNativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmarsrt.dylib</EmuSenNativeFile>
    <EmuSenNativeFile Condition="'$(EmuSenNativeFile)' == ''">libmarsrt.so</EmuSenNativeFile>
    <EmuSenNativeForHost Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == '$(NETCoreSdkRuntimeIdentifier)' Or '$(RuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'">true</EmuSenNativeForHost>
    <EmuSenNativeProfile Condition="'$(_IsPublishing)' == 'true'">dist</EmuSenNativeProfile>
    <EmuSenNativeProfile Condition="'$(EmuSenNativeProfile)' == ''">release</EmuSenNativeProfile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Cores/Nintendo/MarsRT - N64/target/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- MercuryRT, the Rust Game Boy core, built and copied the same way; without it the Game Boy runs on the C# Mercury - see Mercury_Native.md §2. -->
  <PropertyGroup>
    <MercuryRtDir>$(MSBuildThisFileDirectory)Cores\Nintendo\MercuryRT - GB\</MercuryRtDir>
    <MercuryRtTarget>$(MSBuildProjectDirectory)/obj/mercuryrt</MercuryRtTarget>
    <MercuryRtFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">mercuryrt.dll</MercuryRtFile>
    <MercuryRtFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmercuryrt.dylib</MercuryRtFile>
    <MercuryRtFile Condition="'$(MercuryRtFile)' == ''">libmercuryrt.so</MercuryRtFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Cores/Nintendo/MercuryRT - GB/target/**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildMercuryRt" BeforeTargets="BeforeBuild" Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForHost)' == 'true'">
    <Exec Command="cargo build --profile $(EmuSenNativeProfile) --manifest-path &quot;$(MercuryRtDir)Cargo.toml&quot; --target-dir &quot;$(MercuryRtTarget)&quot;" ContinueOnError="true" StandardOutputImportance="low" />
    <ItemGroup Condition="Exists('$(MercuryRtTarget)/$(EmuSenNativeProfile)/$(MercuryRtFile)')">
      <None Include="$(MercuryRtTarget)/$(EmuSenNativeProfile)/$(MercuryRtFile)" Link="$(MercuryRtFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="BuildEmuSenNative" BeforeTargets="BeforeBuild" Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForHost)' == 'true'">
    <Exec Command="cargo build --profile $(EmuSenNativeProfile) --manifest-path &quot;$(EmuSenNativeDir)Cargo.toml&quot; --target-dir &quot;$(EmuSenNativeTarget)&quot;" ContinueOnError="true" StandardOutputImportance="low" />
    <ItemGroup Condition="Exists('$(EmuSenNativeTarget)/$(EmuSenNativeProfile)/$(EmuSenNativeFile)')">
      <None Include="$(EmuSenNativeTarget)/$(EmuSenNativeProfile)/$(EmuSenNativeFile)" Link="$(EmuSenNativeFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
