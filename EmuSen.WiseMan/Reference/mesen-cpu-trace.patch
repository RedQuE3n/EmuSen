--- a/Core/SNES/SnesCpu.cpp
+++ b/Core/SNES/SnesCpu.cpp
@@ -26,6 +26,29 @@ SnesCpu::~SnesCpu()
 {
 }
 
+// S-CPU trace in EmuSen's shared 20-byte record - see EmuSen_Debugging_Tools_Reference_v5.md §3.40.
+bool g_cpuTraceOn = false;
+std::vector<uint8_t> g_cpuTrace;
+
+void PushCpuTrace(SnesCpuState& s, uint32_t addr, uint8_t opcode, uint8_t kind)
+{
+	// ~600k records per 70 frames at 20 bytes; the cap is a runaway guard only.
+	if(!g_cpuTraceOn || g_cpuTrace.size() >= 2000000000u) { return; }
+
+	uint8_t r[20];
+	r[0] = (uint8_t)addr;       r[1] = (uint8_t)(addr >> 8);
+	r[2] = (uint8_t)(addr >> 16); r[3] = 0;
+	r[4] = opcode;              r[5] = kind;
+	r[6] = (uint8_t)s.A;        r[7] = (uint8_t)(s.A >> 8);
+	r[8] = (uint8_t)s.X;        r[9] = (uint8_t)(s.X >> 8);
+	r[10] = (uint8_t)s.Y;       r[11] = (uint8_t)(s.Y >> 8);
+	r[12] = (uint8_t)s.SP;      r[13] = (uint8_t)(s.SP >> 8);
+	r[14] = (uint8_t)s.D;       r[15] = (uint8_t)(s.D >> 8);
+	r[16] = s.DBR;              r[17] = s.PS;
+	r[18] = s.EmulationMode ? 1 : 0; r[19] = 0;
+	g_cpuTrace.insert(g_cpuTrace.end(), r, r + 20);
+}
+
 void SnesCpu::Exec()
 {
 	_immediateMode = false;
@@ -34,6 +57,11 @@ void SnesCpu::Exec()
 	if(_state.StopState == SnesCpuStopState::Running) {
 #ifndef DUMMYCPU
 		_emu->ProcessInstruction<CpuType::Snes>();
+		if(g_cpuTraceOn) {
+			// Peek is the debugger's side-effect-free read, so tracing cannot alter timing.
+			uint32_t pc = ((uint32_t)_state.K << 16) | _state.PC;
+			PushCpuTrace(_state, pc, _memoryManager->Peek(pc), 0);
+		}
 #endif
 
 		RunOp();
@@ -50,11 +78,13 @@ void SnesCpu::CheckForInterrupts()
 	if(_state.NeedNmi) {
 		_state.NeedNmi = false;
 		uint32_t originalPc = GetProgramAddress(_state.PC);
+		if(g_cpuTraceOn) { PushCpuTrace(_state, originalPc, 0, 1); }
 		_emu->GetCheatManager()->RefreshRamCheats(CpuType::Snes);
 		ProcessInterrupt(_state.EmulationMode ? SnesCpu::LegacyNmiVector : SnesCpu::NmiVector, true);
 		_emu->ProcessInterrupt<CpuType::Snes>(originalPc, GetProgramAddress(_state.PC), true);
 	} else if(_state.PrevIrqSource) {
 		uint32_t originalPc = GetProgramAddress(_state.PC);
+		if(g_cpuTraceOn) { PushCpuTrace(_state, originalPc, 0, 2); }
 		ProcessInterrupt(_state.EmulationMode ? SnesCpu::LegacyIrqVector : SnesCpu::IrqVector, true);
 		_emu->ProcessInterrupt<CpuType::Snes>(originalPc, GetProgramAddress(_state.PC), false);
 	}
