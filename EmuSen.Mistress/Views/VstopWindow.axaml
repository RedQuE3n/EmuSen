<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Mistress.Views.VstopWindow"
        Title="DianaOS vstop"
        Width="480" Height="620"
        MinWidth="360" MinHeight="360"
        Background="{DynamicResource LunaSurface}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="HintText"
                           Foreground="{DynamicResource LunaMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CollectButton" Content="Collect now" Click="OnCollectClick" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="12" Spacing="8">
                <TextBlock x:Name="HeaderText"
                           Foreground="{DynamicResource LunaText}"
                           FontFamily="{DynamicResource LunaMonoFont}"
                           FontWeight="Bold"
                           FontSize="14" />
                <TextBlock x:Name="HostText"
                           Foreground="{DynamicResource LunaMuted}"
                           FontFamily="{DynamicResource LunaMonoFont}"
                           FontSize="11"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="MetersPanel" Spacing="3" />

                <TextBlock Text="Memory" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
                <TextBlock x:Name="MemoryText"
                           Foreground="{DynamicResource LunaText}"
                           FontFamily="{DynamicResource LunaMonoFont}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Garbage collector" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
                <TextBlock x:Name="GcText"
                           Foreground="{DynamicResource LunaText}"
                           FontFamily="{DynamicResource LunaMonoFont}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Threads" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
                <TextBlock x:Name="ThreadsText"
                           Foreground="{DynamicResource LunaText}"
                           FontFamily="{DynamicResource LunaMonoFont}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
