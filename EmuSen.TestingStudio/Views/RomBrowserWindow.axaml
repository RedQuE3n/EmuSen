<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.TestingStudio.Views.RomBrowserWindow"
        Title="Browse ROMs"
        Width="420" Height="480">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   x:Name="DirectoryText"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="11"
                   Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="OpenButton" Content="Open" Click="OnOpenClick" />
            <Button Content="Cancel" Click="OnCancelClick" />
        </StackPanel>

        <ListBox x:Name="RomList" DoubleTapped="OnRomListDoubleTapped" />

    </DockPanel>

</Window>
