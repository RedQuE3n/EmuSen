<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Hotaru.Views.CoretopWindow"
        Title="DianaOS coretop"
        Width="480" Height="720"
        MinWidth="360" MinHeight="360"
        Background="{DynamicResource LunaSurface}">

    <ScrollViewer>
        <StackPanel Margin="12" Spacing="8">
            <TextBlock x:Name="HeaderText"
                       Foreground="{DynamicResource LunaText}"
                       FontFamily="{DynamicResource LunaMonoFont}"
                       FontWeight="Bold"
                       FontSize="14" />
            <TextBlock x:Name="NoTargetText"
                       Text="No ROM loaded."
                       Foreground="{DynamicResource LunaMuted}"
                       IsVisible="False" />

            <TextBlock Text="Load" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <StackPanel x:Name="LoadPanel" Spacing="3" />

            <TextBlock Text="CPU registers" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <TextBlock x:Name="CpuRegsText"
                       Foreground="{DynamicResource LunaText}"
                       FontFamily="{DynamicResource LunaMonoFont}"
                       TextWrapping="Wrap" />

            <TextBlock Text="Sprites" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar x:Name="SpritesBar" Grid.Column="0" Minimum="0" Maximum="100" Height="16" />
                <TextBlock x:Name="SpritesText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource LunaText}"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Audio channels" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <StackPanel x:Name="AudioPanel" Spacing="3" />

            <TextBlock Text="Palette (color RAM)" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <Image x:Name="PaletteImage"
                   Stretch="None"
                   RenderOptions.BitmapInterpolationMode="None"
                   HorizontalAlignment="Left" />

            <TextBlock Text="VRAM tile sheet" Foreground="{DynamicResource LunaSectionHeader}" FontWeight="Bold" />
            <Image x:Name="TileSheetImage"
                   Stretch="Uniform"
                   MaxHeight="320"
                   RenderOptions.BitmapInterpolationMode="None"
                   HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>

</Window>
