<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core-agnostic debug/scripting shell - see EmuSen_DianaSh.md for
       the full design. OutputType=Exe so `dotnet run` here launches a
       standalone shell with no core loaded at all (see Program.cs) -
       every other project just references this like any other library;
       its Main only runs when this project is the one actually launched. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OutputType=Exe above means a RID-specific publish of a frontend that
         references this project also builds it for the HOST rid, so restore
         has to produce assets for every publish target plus the build
         machine's own - see `man hier`. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Crystal, beneath the shell: IDebugTarget, the registries, the cheat engine, the telemetry contracts and the
         system packs, which the debugger's commands read - see EmuSen_DianaSh.md §13.6. -->
    <ProjectReference Include="..\EmuSen.Crystal\EmuSen.Crystal.csproj" />
    <!-- ConfigRoot (this shell's own root discovery lives there now) and
         CheatFile, behind `cheat save`/`load` - see
         EmuSen_Config_Reference.md §1.1 for why the dependency runs this
         way round rather than Galaxia calling DianaShSandbox. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

  <!-- The golden corpus reads $? and the command list through two internal members - see EmuSen_DianaSh.md §13.4. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EmuSen.WiseMan" />
  </ItemGroup>

  <!-- The manual pages, one file each and grouped in the source by the command module that will own them, flattened
       into dianash/man/ beside the program (ConfigRoot.ShellModulesDirName), which a published tree puts in
       /lib/EmuSen/dianash/man. Copied to the output too, since `man` reads them there from source as well.
       See EmuSen_DianaSh.md §12.4 and §13.5. -->
  <ItemGroup>
    <None Update="DianaSh\Lib\dianash\*\man\*" Link="dianash\man\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ships the two read-only doc trees into a published build's own sandbox
       root, so `man`/`cat`/`find` have the same reference material there that
       they do running from source. Link= stages them under DianaShRoot/, which
       DianaShPublishLayout.targets then hoists to the publish root - and which
       is also where a publish that does NOT import those targets leaves them,
       matching DianaShSandbox's fallback root. See `man hier`.
       CopyToPublishDirectory only (not CopyToOutputDirectory): running from
       source already reads these straight out of the repo, so copying them
       into every bin/ would be ~770KB of duplication nothing ever reads. -->
  <ItemGroup>
    <None Include="DianaSh\Etc\Man pages\**\*" Link="DianaShRoot\home\Documents\Man pages\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="DianaSh\Usr\Home\Documents\**\*" Link="DianaShRoot\home\Documents\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- A published build's output directory is DianaSh's own root: the .NET
       app dir moves to /lib/EmuSen, /bin gets a launcher. See `man hier`. -->
  <Import Project="Publish\DianaShPublishLayout.targets" />

</Project>
