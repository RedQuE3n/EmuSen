{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emusen-core/v1/settings",
  "title": "emusen_core_settings_schema: the core's settings, the one source for them (EmuSen_CoreAPI.md 6.13)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "label", "help", "kind", "default", "scope", "effect"],
    "properties": {
      "key": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
      "label": { "type": "string" },
      "help": { "type": "string" },
      "kind": { "type": "string" },
      "default": { "type": "string" },
      "min": { "type": "integer" },
      "max": { "type": "integer" },
      "step": { "type": "integer" },
      "choices": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["value", "label"],
          "properties": { "value": { "type": "string" }, "label": { "type": "string" }, "help": { "type": "string" } }
        }
      },
      "scope": { "type": "string" },
      "category": { "type": "string" },
      "effect": { "type": "string" },
      "cost": { "type": "string" },
      "accurate": { "type": "string" },
      "hardware": { "type": "string" },
      "advanced": { "type": "boolean" },
      "hidden": { "type": "boolean" },
      "restart": { "type": "boolean" }
    }
  }
}
