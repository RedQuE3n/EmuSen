<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Mistress9.Views.ShellConsoleWindow"
        Title="EmuSen Shell Console"
        Width="860" Height="540"
        MinWidth="420" MinHeight="240"
        Background="#1E1E1E">

    <DockPanel Margin="8">

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <TextBlock x:Name="PromptText"
                       Grid.Column="0"
                       Text="debug&gt; "
                       VerticalAlignment="Center"
                       FontFamily="Consolas,Menlo,monospace"
                       Foreground="#D4D4D4"
                       Margin="0,0,4,0" />
            <TextBox x:Name="InputBox"
                     Grid.Column="1"
                     FontFamily="Consolas,Menlo,monospace"
                     Background="#252526"
                     Foreground="#D4D4D4"
                     CaretBrush="#D4D4D4"
                     BorderThickness="1" />
        </Grid>

        <ScrollViewer x:Name="OutputScroll">
            <SelectableTextBlock x:Name="OutputText"
                                  FontFamily="Consolas,Menlo,monospace"
                                  Foreground="#D4D4D4"
                                  TextWrapping="Wrap" />
        </ScrollViewer>

    </DockPanel>

</Window>
