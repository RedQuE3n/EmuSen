<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library since the fold: the `hotaru` command and the game window it opens, started by EmuSen.Shell - see EmuSen_Frontend_Driver.md §0. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Both XAML types are constructed by hand - see EmuSen_Settings_Reference.md §4.8. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hotaru's entire UI/audio/input stack now - see
         Views/GameWindow.axaml.cs. Avalonia is the primary application
         (StartWithClassicDesktopLifetime in EmuSen.Shell's Program.cs), not a secondary
         dependency bootstrapped alongside a separate Raylib main loop the
         way it used to be for `coretop -w` alone - see git history for
         the Raylib/AvaloniaHost predecessor. Package versions match
         EmuSen.Mistress's own references exactly, the same convention
         EmuSen.Serenity's csproj already follows. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- Native X11 backend - opted into explicitly by LunaApp, which
         EmuSen.Shell's Program.cs starts (Linux only), matching EmuSen.Mistress. -->
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frontend API's binding, the one way this frontend drives a core; it names no type of EmuSen or
         EmuSen.Crystal (SR2) - see EmuSen_Backend.md §14.11. -->
    <ProjectReference Include="..\EmuSen.Crystal.Client\EmuSen.Crystal.Client.csproj" />
    <!-- The shell its F4 prompt and terminal embed, made over the session's service table - see EmuSen_DianaSh.md §13.6. -->
    <ProjectReference Include="..\EmuSen.DianaSh\EmuSen.DianaSh.csproj" />
    <!-- GameFrameControl/ShaderEffect/BuiltInShaders - the Avalonia-native
         presenter this frontend is built around. See
         EmuSen.Serenity.csproj. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- AudioPlayer/GamepadManager/GamepadBindingMap and the shared
         config root - one copy for both frontends, see
         EmuSen_Settings_Reference.md §4.10. -->
    <ProjectReference Include="..\EmuSen.Endymion\EmuSen.Endymion.csproj" />
    <!-- The shared theme (EmuSen.Shell's App.axaml's one StyleInclude), the Avalonia
         bootstrap sequence Program.cs used to spell out, and the controls/
         window scaffolding Views/ is migrating onto - see EmuSen_LunaP.md.
         Same reference EmuSen.Mistress carries; the two frontends share
         widgets, not windows - see EmuSen_LunaP_Gameplan.md §2. -->
    <!-- Now through LunaP.props, which names where it comes from. -->
  </ItemGroup>


  <Import Project="..\LunaP.props" />

</Project>
