<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The frontend API on the Rust Crystal unless EMUSEN_CRYSTAL_NATIVE is 0 - see EmuSen_Backend.md §29.27. -->
    <EmuSenCrystalNative>true</EmuSenCrystalNative>
  </PropertyGroup>

  <ItemGroup>
    <!-- The frontend API, the one way this program drives a core; it names nothing of the runtime's own assemblies - see EmuSen_Backend.md §14.8 and SR2. -->
    <ProjectReference Include="..\EmuSen.Crystal.Client\EmuSen.Crystal.Client.csproj" />
    <!-- The shell its scripts' other verbs fall through to, handed the session's own table. -->
    <ProjectReference Include="..\EmuSen.DianaSh\EmuSen.DianaSh.csproj" />
    <!-- Paths, the config models and the input vocabulary. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For LibraryIndexer/SqliteCatalogue only, now that the dictionary is read
         from Python. The bundle_e_sqlite3 pin is deliberate - see EmuSen.csproj. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>


  <!-- A published build's output directory is DianaSh's own root: the .NET
       app dir moves to /lib/EmuSen, /bin gets a launcher. See `man hier`. -->
  <Import Project="..\EmuSen.DianaSh\Publish\DianaShPublishLayout.targets" />

</Project>
