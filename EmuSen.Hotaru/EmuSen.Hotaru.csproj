<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Both XAML types are constructed by hand - see EmuSen_Settings_Reference.md §4.8. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hotaru's entire UI/audio/input stack now - see App.axaml.cs and
         Views/GameWindow.axaml.cs. Avalonia is the primary application
         (StartWithClassicDesktopLifetime in Program.cs), not a secondary
         dependency bootstrapped alongside a separate Raylib main loop the
         way it used to be for `coretop -w` alone - see git history for
         the Raylib/AvaloniaHost predecessor. Package versions match
         EmuSen.Mistress's own references exactly, the same convention
         EmuSen.Serenity's csproj already follows. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- Native X11 backend - opted into explicitly in Program.cs
         (Linux only), matching EmuSen.Mistress's own Program.cs. -->
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
    <!-- Imaging/FrameImageWriter.cs encodes screenshots/frame-recording
         PNGs directly via SKImage.Encode, not Avalonia's
         WriteableBitmap.Save - see that file's own comment for why.
         Already a transitive dependency via EmuSen.Serenity's own
         PackageReference; referenced explicitly here too since Hotaru
         imports SkiaSharp types directly, matching Serenity's own
         "don't rely on an implicit transitive version" convention. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The emulation core (Cores/Nintendo/Venus - SNES/*, Common/, Debug/,
         Settings/) - EmuSen.csproj is a pure library, no Main/window
         ownership of its own. -->
    <ProjectReference Include="..\EmuSen\EmuSen.csproj" />
    <!-- GameFrameControl/ShaderEffect/BuiltInShaders - the Avalonia-native
         presenter this frontend is built around. See
         EmuSen.Serenity.csproj. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- AudioPlayer/GamepadManager/GamepadBindingMap and the shared
         config root - one copy for both frontends, see
         EmuSen_Settings_Reference.md §4.10. -->
    <ProjectReference Include="..\EmuSen.Endymion\EmuSen.Endymion.csproj" />
    <!-- The shared theme (App.axaml's one StyleInclude), the Avalonia
         bootstrap sequence Program.cs used to spell out, and the controls/
         window scaffolding Views/ is migrating onto - see EmuSen_LunaP.md.
         Same reference EmuSen.Mistress carries; the two frontends share
         widgets, not windows - see EmuSen_LunaP_Gameplan.md §2. -->
    <PackageReference Include="EmuSen.LunaP" Version="0.2.0" />
  </ItemGroup>


  <!-- A published build's output directory is DianaOS's own root: the .NET
       app dir moves to /lib/EmuSen, /bin gets a launcher. See `man hier`. -->
  <Import Project="..\EmuSen.DianaOS\Publish\DianaOSPublishLayout.targets" />

</Project>
