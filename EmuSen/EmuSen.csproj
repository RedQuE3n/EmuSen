<Project Sdk="Microsoft.NET.Sdk">

  <!-- No C# since the C# core host was retired on 2026-11-07: this project carries the Rust cores, which the build host
       builds, to every program that references it - see EmuSen_Backend.md §40.10 and EmuSen_RustPlatform.md §28.11. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common/Imaging/PngFile.cs encodes with SKImage directly, so SkiaSharp is a real dependency of this project; its Linux library is a package of its own, which Avalonia brought until S1 - see EmuSen_Surfaces.md §7.1. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- The Rust cores, their sidecars and cores.manifest: the build host builds this project's part of xtask/libraries.tsv and puts it beside every program that references this project - see EmuSen_RustPlatform.md §28.11. -->
  <PropertyGroup>
    <EmuSenNativePart>cores</EmuSenNativePart>
    <DefaultItemExcludes>$(DefaultItemExcludes);Cores/*/*RT - */target/**;Cores/*/*RT - */pgo/**;Cores/Shared/*/target/**;Cores/Libretro/*/target/**;Cores/Sega/Nephrite - Genesis/target/**;Cores/Sega/Endou - Master System/target/**;Cores/Sega/Beryl-HW/*/target/**;Cores/Sony/Diamond - PlayStation/target/**;Cores/Sony/Sapphire - PlayStation 2/target/**;Cores/Sony/BlackMoon-HW/*/target/**;Cores/Nintendo/SilverMillennium-HW/*/target/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
