# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command mem
usage 1   mem <space> <addr> [<len>]    hexdump <len> bytes (default 16) from <space> at <addr>

case hexdumps
target fake
covers 1
$ mem
out 33
Usage: mem <space> <addr> [<len>]
status 0
action none
$ mem RAM
out 33
Usage: mem <space> <addr> [<len>]
status 0
action none
$ mem RAM 0
out 97
RAM @ 0x0 (16 bytes):
  000000: 03 0A 11 18 1F 26 2D 34 3B 42 49 50 57 5E 65 6C  .....&-4;BIPW^el
status 0
action none
$ mem RAM 0 20
out 173
RAM @ 0x0 (32 bytes):
  000000: 03 0A 11 18 1F 26 2D 34 3B 42 49 50 57 5E 65 6C  .....&-4;BIPW^el
  000010: 73 7A 81 88 8F 96 9D A4 AB B2 B9 C0 C7 CE D5 DC  sz..............
status 0
action none
$ mem ram 10 3
out 84
RAM @ 0x10 (3 bytes):
  000010: 73 7A 81                                         sz.
status 0
action none
$ mem ROM 0 10
out 97
ROM @ 0x0 (16 bytes):
  000000: 20 10 80 AD 42 00 8D 43 00 4C 00 80 EA EA EA EA   ...B..C.L......
status 0
action none
$ mem IO 0 4
out 83
IO @ 0x0 (4 bytes):
  000000: F0 F1 F2 F3                                      ....
status 0
action none
$ mem VRAM 3F8 10
out 100
VRAM @ 0x3F8 (16 bytes):
  0003F8: 98 A5 B2 BF CC D9 E6 F3 00 0D 1A 27 34 41 4E 5B  ...........'4AN[
status 0
action none
$ mem RAM F8 10
out 98
RAM @ 0xF8 (16 bytes):
  0000F8: CB D2 D9 E0 E7 EE F5 FC 03 0A 11 18 1F 26 2D 34  .............&-4
status 0
action none
$ echo $?
out 1
0
status 0
action none
$ mem NOPE 0
out 83
Error: No memory space named 'NOPE'. Available: RAM, ROM, VRAM, IO, UNSIZED, CpuBus
status 1
action none
$ mem RAM 0 0
out 20
RAM @ 0x0 (0 bytes):
status 0
action none
end

case with no target
target none
covers 1
$ mem RAM 0
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
$ echo $?
out 1
1
status 0
action none
end

case on venusrt
target venusrt
covers 1
$ spaces
out 286
