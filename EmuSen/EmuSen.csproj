<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure library now - no Main, no window ownership, and since 2026-08-05
       no rendering framework either: Venus composites into its own
       internal Rgba32 struct, not Raylib_cs.Color - see Venus_PPU.md §15.1.
       The console frontend's Main/hotkey loop lives in EmuSen.Hotaru instead,
       so this project and EmuSen.Mistress (Avalonia) are true sibling
       consumers of the emulation core, neither depending on the other's
       frontend-specific code. See EmuSen_Project_Overview_v2.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Vulkan's binding is pointers throughout; only Mars's Rdp/Gpu uses them - see Mars_Gpu.md §1. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common/Imaging/PngFile.cs encodes with SKImage directly, so this is
         a real dependency of this project and not just something inherited
         through EmuSen.Serenity - listed explicitly to match this file's
         own "be explicit about what's actually used" convention. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Managed binding only: the loader and the driver are the system's, and their absence is the CPU path - see Mars_Gpu.md §1. -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled from the .comp beside each by WiseMan, which also holds them equal - see Mars_Gpu.md §2. -->
    <EmbeddedResource Include="Cores\Nintendo\Mars - N64\Rdp\Gpu\Shaders\*.spv" LogicalName="Mars.Gpu.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- FramePresenter/GraphicsSettings/BuiltInShaders live here now, not
         in this project - see EmuSen.Serenity.csproj's own note on why
         presentation-layer code moved out to its own shared project. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- SnesDebugTarget implements IDebugTarget and its
         ICheatCodeCodec/ICpuTraceSwitch adapter classes plug into
         DianaOS's own extension points - see IDebugTarget.cs's own
         header comment on why DianaOS itself has zero reference back to
         this project. EmuSen.Cauldron is referenced transitively through
         this (SnesDebugTarget builds PollingProvider<T> instances
         directly), listed explicitly anyway to match this project's own
         "be explicit about what's actually used" convention. -->
    <ProjectReference Include="..\EmuSen.DianaOS\EmuSen.DianaOS.csproj" />
    <ProjectReference Include="..\EmuSen.Cauldron\EmuSen.Cauldron.csproj" />
    <!-- AudioConfig, which AudioSettings maps to and from - see
         EmuSen_Config_Reference.md §3.2. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

  <!-- The Rust cores, built by cargo for this machine when it is installed and copied beside the assemblies; without one its console runs on the C# core - see Mars_Native.md §1, Mercury_Native.md §8.6. A publish for another platform swaps the libraries in RustCoresPublish.targets. -->
  <Import Project="Cores\RustCores.props" />

  <PropertyGroup>
    <EmuSenNativeForHost Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == '$(NETCoreSdkRuntimeIdentifier)' Or '$(RuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'">true</EmuSenNativeForHost>
    <EmuSenNativeProfile Condition="'$(_IsPublishing)' == 'true'">dist</EmuSenNativeProfile>
    <EmuSenNativeProfile Condition="'$(EmuSenNativeProfile)' == ''">release</EmuSenNativeProfile>
    <!-- Each crate builds into <root>/<library name>; overridable so a scratch build keeps cargo's output off the tree. -->
    <EmuSenCargoTargetRoot Condition="'$(EmuSenCargoTargetRoot)' == ''">$(MSBuildProjectDirectory)/obj</EmuSenCargoTargetRoot>
    <EmuSenHostLibraryPrefix Condition="!$([MSBuild]::IsOSPlatform('Windows'))">lib</EmuSenHostLibraryPrefix>
    <EmuSenHostLibrarySuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.dll</EmuSenHostLibrarySuffix>
    <EmuSenHostLibrarySuffix Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</EmuSenHostLibrarySuffix>
    <EmuSenHostLibrarySuffix Condition="'$(EmuSenHostLibrarySuffix)' == ''">.so</EmuSenHostLibrarySuffix>
    <DefaultItemExcludes>$(DefaultItemExcludes);Cores/*/*RT - */target/**;Cores/*/*RT - */pgo/**</DefaultItemExcludes>
    <!-- A crate holding pgo/<name>.<this machine's Rust target>.profdata is built profile-guided unless this is false - see Mars_Native.md §6.17. -->
    <EmuSenPgo Condition="'$(EmuSenPgo)' == ''">true</EmuSenPgo>
    <_EmuSenHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_EmuSenHostArch>
    <_EmuSenHostArch Condition="'$(_EmuSenHostArch)' == 'X64'">x86_64</_EmuSenHostArch>
    <_EmuSenHostArch Condition="'$(_EmuSenHostArch)' == 'Arm64'">aarch64</_EmuSenHostArch>
    <EmuSenHostRustTarget Condition="'$(EmuSenHostRustTarget)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(_EmuSenHostArch)-pc-windows-msvc</EmuSenHostRustTarget>
    <EmuSenHostRustTarget Condition="'$(EmuSenHostRustTarget)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(_EmuSenHostArch)-apple-darwin</EmuSenHostRustTarget>
    <EmuSenHostRustTarget Condition="'$(EmuSenHostRustTarget)' == ''">$(_EmuSenHostArch)-unknown-linux-gnu</EmuSenHostRustTarget>
  </PropertyGroup>

  <!-- A machine without Rust builds the C# cores alone; one with it must build the Rust ones, so a failed cargo step fails the build instead of leaving an old library in place - see Mars_Native.md §1. -->
  <Target Name="FindCargo" Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForHost)' == 'true'">
    <Exec Command="cargo --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <PropertyGroup>
      <CargoFound Condition="'$(CargoExitCode)' == '0'">true</CargoFound>
    </PropertyGroup>
    <Warning Condition="'$(CargoFound)' != 'true'" Text="cargo was not found: @(EmuSenRustCrate->'%(Core)', ' and ') are not built, and their consoles run on the C# cores alone." />
  </Target>

  <!-- One cargo build per crate of RustCores.props, in its order; the first to fail stops the build. -->
  <Target Name="BuildRustCores" BeforeTargets="BeforeBuild" DependsOnTargets="FindCargo;BuildRustCore" Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForHost)' == 'true'">
    <ItemGroup>
      <_EmuSenRustLibrary Include="@(EmuSenRustCrate->'$(EmuSenCargoTargetRoot)/%(Identity)/$(EmuSenNativeProfile)/$(EmuSenHostLibraryPrefix)%(Identity)$(EmuSenHostLibrarySuffix)')" />
      <None Include="@(_EmuSenRustLibrary)" Condition="Exists('%(_EmuSenRustLibrary.FullPath)')" Link="%(_EmuSenRustLibrary.Filename)%(_EmuSenRustLibrary.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Batched: once per crate. Its profile for this target is used from a copy named by its hash, so a refreshed profile rebuilds every crate it guides; no profile, no flag and no warning - see Mars_Native.md §6.17. -->
  <Target Name="BuildRustCore" Outputs="%(EmuSenRustCrate.Identity)" DependsOnTargets="FindCargo" Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForHost)' == 'true' And '$(CargoFound)' == 'true'">
    <PropertyGroup>
      <_EmuSenPgoProfile>%(EmuSenRustCrate.Dir)pgo/%(EmuSenRustCrate.Identity).$(EmuSenHostRustTarget).profdata</_EmuSenPgoProfile>
      <_EmuSenPgoUse>false</_EmuSenPgoUse>
      <_EmuSenPgoUse Condition="'$(EmuSenPgo)' != 'false' And Exists('$(_EmuSenPgoProfile)')">true</_EmuSenPgoUse>
      <_EmuSenPgoConfig></_EmuSenPgoConfig>
    </PropertyGroup>
    <ItemGroup>
      <_EmuSenPgoManifest Remove="@(_EmuSenPgoManifest)" />
      <_EmuSenPgoFlavour Remove="@(_EmuSenPgoFlavour)" />
    </ItemGroup>
    <!-- Only a flavour the manifest lists is given the profile: another compiler's names match nothing, and a newer LLVM's profile would fail the build - see Mars_Native.md §6.17.4. -->
    <PropertyGroup>
      <_EmuSenRustcCommand>rustc</_EmuSenRustcCommand>
      <_EmuSenRustcCommand Condition="'$(RUSTC)' != ''">&quot;$(RUSTC)&quot;</_EmuSenRustcCommand>
    </PropertyGroup>
    <Exec Condition="'$(_EmuSenPgoUse)' == 'true'" Command="$(_EmuSenRustcCommand) -V" WorkingDirectory="%(EmuSenRustCrate.Dir)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_EmuSenRustc" />
    </Exec>
    <ReadLinesFromFile Condition="'$(_EmuSenPgoUse)' == 'true'" File="$([System.IO.Path]::ChangeExtension('$(_EmuSenPgoProfile)', '.pgo'))">
      <Output TaskParameter="Lines" ItemName="_EmuSenPgoManifest" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'$(_EmuSenPgoUse)' == 'true'">
      <_EmuSenPgoFlavour Include="@(_EmuSenPgoManifest)" Condition="'%(_EmuSenPgoManifest.Identity)' == 'flavour = $(_EmuSenRustc) | $(EmuSenNativeProfile) | host'" />
    </ItemGroup>
    <Message Condition="'$(_EmuSenPgoUse)' == 'true' And '@(_EmuSenPgoFlavour)' == ''" Importance="normal" Text="%(EmuSenRustCrate.Core) builds without its PGO profile, which was not trained for $(_EmuSenRustc), $(EmuSenNativeProfile)." />
    <PropertyGroup Condition="'$(_EmuSenPgoUse)' == 'true' And '@(_EmuSenPgoFlavour)' == ''">
      <_EmuSenPgoUse>false</_EmuSenPgoUse>
    </PropertyGroup>
    <GetFileHash Condition="'$(_EmuSenPgoUse)' == 'true'" Files="$(_EmuSenPgoProfile)">
      <Output TaskParameter="Hash" PropertyName="_EmuSenPgoHash" />
    </GetFileHash>
    <PropertyGroup Condition="'$(_EmuSenPgoUse)' == 'true'">
      <_EmuSenPgoCopy>$([MSBuild]::NormalizePath('$(EmuSenCargoTargetRoot)', '%(EmuSenRustCrate.Identity)', 'pgo', '%(EmuSenRustCrate.Identity)-$(_EmuSenPgoHash.Substring(0, 16))'))</_EmuSenPgoCopy>
      <_EmuSenPgoConfig> --config &quot;build.rustflags=['-Cprofile-use=$(_EmuSenPgoCopy).profdata', '-Cllvm-args=-no-pgo-warn-mismatch']&quot;</_EmuSenPgoConfig>
    </PropertyGroup>
    <Copy Condition="'$(_EmuSenPgoUse)' == 'true'" SourceFiles="$(_EmuSenPgoProfile);$([System.IO.Path]::ChangeExtension('$(_EmuSenPgoProfile)', '.pgo'))" DestinationFiles="$(_EmuSenPgoCopy).profdata;$(_EmuSenPgoCopy).pgo" SkipUnchangedFiles="true" />
    <Warning Condition="'$(_EmuSenPgoUse)' == 'true' And ('$(RUSTFLAGS)' != '' Or '$(CARGO_ENCODED_RUSTFLAGS)' != '')" Text="RUSTFLAGS is set and overrides build.rustflags: %(EmuSenRustCrate.Core) builds without its PGO profile." />
    <Exec Command="cargo build --profile $(EmuSenNativeProfile) --manifest-path &quot;%(EmuSenRustCrate.Dir)Cargo.toml&quot; --target-dir &quot;$(EmuSenCargoTargetRoot)/%(EmuSenRustCrate.Identity)&quot;$(_EmuSenPgoConfig)" StandardOutputImportance="low" />
  </Target>

</Project>
