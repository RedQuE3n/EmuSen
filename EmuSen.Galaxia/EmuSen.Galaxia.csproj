<Project Sdk="Microsoft.NET.Sdk">

  <!-- The librarian: the one answer to where anything this program keeps on
       disk lives, and how it is read and written safely - config files
       (EmuSen_Config_Reference.md) and saved data alike (EmuSen_Galaxia.md).

       Deliberately a leaf: no ProjectReference, no PackageReference. It has
       to be, because EmuSen.DianaOS references it (CheatRegistry's save/load)
       and EmuSen references EmuSen.DianaOS - anything Galaxia depended on
       upward would close a cycle. That constraint is what makes it agnostic
       rather than just shared: nothing here can name Avalonia's Key, SDL's
       GamepadButton or SnesButton, so the config models are plain data and
       the typed maps that use foreign enums keep their own homes. -->
  <!-- The catalogue's schema ships as SQL beside the contract that describes it.
       Galaxia owns where things live and what shape they are in; the driver that
       executes this lives above her, because a leaf cannot take a database
       engine - see EmuSen_Galaxia.md §7.1. -->
  <ItemGroup>
    <None Include="Library\Catalogue\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Packed because EmuSen.LunaP is packed and names this as a dependency; a
       consumer outside this repository cannot resolve a ProjectReference. The
       argument for packaging at all is in EmuSen_LunaP.md §17. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EmuSen.Galaxia</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tristan Pelland</Authors>
    <Description>Where EmuSen keeps things on disk, and how they are read and written safely.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RedQuE3n/EmuSen-Project</RepositoryUrl>
  </PropertyGroup>

</Project>
