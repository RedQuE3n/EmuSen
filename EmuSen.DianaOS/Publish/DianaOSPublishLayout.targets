<Project>

  <!-- Makes a published frontend's output directory BE DianaOS's own root,
       instead of a flat .NET app dir with a DianaOSRoot/ subfolder inside
       it. The whole .NET app directory - apphost, every .dll, deps.json,
       runtimeconfig.json, runtimes/ - moves intact into /lib/EmuSen, and
       /bin gets a launcher shim. Nothing about how the app loads changes:
       the app dir is relocated, not taken apart, so no assembly resolver
       or deps.json surgery is involved. See `man hier` for the resulting
       layout and for why the root moved out from under the binaries.

       Imported explicitly by each publishable frontend rather than dropped
       in a Directory.Build.targets, matching this repo's "be explicit about
       what's actually used" convention (see EmuSen.csproj). Set
       DianaOSPublishLayout=false to publish a plain flat .NET app dir. -->

  <!-- SkiaSharp and HarfBuzzSharp ship a native .pdb beside the .dll in
       their win32 runtime packs; the Linux and macOS packs ship none. That
       is 100MB per Windows app (80MB libSkiaSharp.pdb, 20MB
       libHarfBuzzSharp.pdb) of symbols for third-party native libraries -
       never loaded at runtime, and useless without matching Skia sources.
       It is what made a Windows publish roughly twice the size of the same
       app for any other RID.

       DebugType=none does not cover these: that governs this repo's own
       MANAGED pdbs, while these arrive as native package content. Matched
       on AssetType rather than by file name so a future native dependency
       is covered without an edit here. Set DianaOSPublishNativePdbs=true
       to keep them for a session that genuinely needs to debug into Skia. -->
  <PropertyGroup>
    <DianaOSPublishNativePdbs Condition="'$(DianaOSPublishNativePdbs)' == ''">false</DianaOSPublishNativePdbs>
  </PropertyGroup>

  <Target Name="DianaOSDropNativePdbs"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(DianaOSPublishNativePdbs)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' AND '%(ResolvedFileToPublish.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

  <!-- EmuSen ships NO cheat data, ever. The libretro database is CC BY-SA
       content a player downloads themselves and then prunes to whatever
       cores they have (see `man cheat`), and a developer's own downloaded
       copy lives in the same sandbox tree the publish reads its docs out
       of - one over-broad glob away from being redistributed by accident.

       So this is a build failure rather than a code review item: nothing
       matching *.cht, and nothing under Usr/Home/Cheats, may enter a
       publish. Today no include even selects them (EmuSen.DianaOS.csproj
       takes Documents and Man pages only); this exists so that stays
       true. -->
  <Target Name="DianaOSRefuseToPublishCheats"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_DianaOSLeakedCheat
        Include="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.cht' OR $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('home/Cheats')) OR $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('Usr/Home/Cheats'))" />
    </ItemGroup>
    <Error Condition="'@(_DianaOSLeakedCheat)' != ''"
           Text="Refusing to publish cheat data - EmuSen ships none. @(_DianaOSLeakedCheat->'%(RelativePath)', ', ')" />
  </Target>

  <PropertyGroup>
    <DianaOSPublishLayout Condition="'$(DianaOSPublishLayout)' == ''">true</DianaOSPublishLayout>
    <!-- Private libraries of a single application, the /usr/lib/<app> shape. -->
    <DianaOSAppDirName Condition="'$(DianaOSAppDirName)' == ''">lib/EmuSen</DianaOSAppDirName>
    <!-- Where EmuSen.DianaOS.csproj's doc-tree Link= metadata stages the read-only
         trees. Must match DianaOSSandbox.PublishedRootDirName, which is still the
         fallback root for a publish that does NOT import this file. -->
    <DianaOSStagedRootDirName Condition="'$(DianaOSStagedRootDirName)' == ''">DianaOSRoot</DianaOSStagedRootDirName>
    <_DianaOSStagedPrefixLength>$([MSBuild]::Add($(DianaOSStagedRootDirName.Length), 1))</_DianaOSStagedPrefixLength>
    <!-- Must match DianaOSSandbox.RootMarkerFileName. -->
    <DianaOSRootMarkerFileName Condition="'$(DianaOSRootMarkerFileName)' == ''">.dianaosroot</DianaOSRootMarkerFileName>
    <_DianaOSLauncherDir>$(MSBuildThisFileDirectory)</_DianaOSLauncherDir>
  </PropertyGroup>

  <!-- A Mac app bundle instead of the tree above, for a project that names one
       (DianaOSMacAppName) and a publish for osx-*. Decided 2026-09-27: macOS
       installs EmuSen as EmuSen.app in /Applications, the platform's own
       standard, where Linux has none and gets the self-contained tree. The
       bundle stays read-only: the program's data lives in
       ~/Library/Application Support/EmuSen (ConfigRoot), so there is no
       .dianaosroot and no bin/ launcher. The .NET app directory moves whole
       into Contents/MacOS, the staged doc trees into Contents/Resources/home
       (copied into the data home on start), and the notices and icon into
       Contents/Resources. See EmuSen_Settings_Reference.md §4.82 and
       EmuSen_Galaxia.md §3.4. -p:DianaOSMacAppBundle=false publishes the Linux
       tree for osx-* instead. -->
  <PropertyGroup>
    <DianaOSMacAppBundle Condition="'$(DianaOSMacAppBundle)' == '' And '$(DianaOSPublishLayout)' == 'true' And '$(DianaOSMacAppName)' != '' And $(RuntimeIdentifier.StartsWith('osx'))">true</DianaOSMacAppBundle>
    <_DianaOSMacContents>$(DianaOSMacAppName).app/Contents</_DianaOSMacContents>
    <!-- The highest LC_BUILD_VERSION minos among the shipped Mach-O files: the .NET 10 runtime, its apphost and SDL3 all say 12.0; Avalonia, Skia and HarfBuzz say 11.0. -->
    <DianaOSMacMinimumSystemVersion Condition="'$(DianaOSMacMinimumSystemVersion)' == ''">12.0</DianaOSMacMinimumSystemVersion>
    <DianaOSMacCodesign Condition="'$(DianaOSMacCodesign)' == ''">true</DianaOSMacCodesign>
    <_DianaOSAppDest>$(DianaOSAppDirName)</_DianaOSAppDest>
    <_DianaOSAppDest Condition="'$(DianaOSMacAppBundle)' == 'true'">$(_DianaOSMacContents)/MacOS</_DianaOSAppDest>
    <_DianaOSStagedDest></_DianaOSStagedDest>
    <_DianaOSStagedDest Condition="'$(DianaOSMacAppBundle)' == 'true'">$(_DianaOSMacContents)/Resources/</_DianaOSStagedDest>
  </PropertyGroup>

  <!-- Rewrites each publish item's destination before anything is copied, so
       files land in their final home directly - no post-publish move, and no
       empty runtimes/*/native husks left behind by one. The staged doc trees
       lose their DianaOSRoot/ prefix (they are already at their root-relative
       path); everything else gains the app dir prefix. Matched on the bare
       directory name so it works whichever slash MSBuild normalized Link= to.

       Hooked on ComputeFilesToPublish, not ComputeResolvedFilesToPublishList:
       the latter does not contribute the app's own deps.json, which
       GeneratePublishDependencyFile adds afterwards and which would otherwise
       be the one file left stranded at the root, away from the assemblies it
       describes. ComputeFilesToPublish is the join point for both, and still
       runs before anything is copied. -->
  <Target Name="DianaOSRelocatePublishFiles"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(DianaOSPublishLayout)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish>
        <_DianaOSPath Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('$(DianaOSStagedRootDirName)'))">$(_DianaOSStagedDest)$([System.String]::Copy('%(RelativePath)').Substring($(_DianaOSStagedPrefixLength)))</_DianaOSPath>
        <_DianaOSPath Condition="!$([System.String]::Copy('%(RelativePath)').StartsWith('$(DianaOSStagedRootDirName)'))">$(_DianaOSAppDest)/%(RelativePath)</_DianaOSPath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish>
        <RelativePath>%(_DianaOSPath)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- The two things the root needs that aren't build output: the marker
       DianaOSSandbox.ComputeRootFor walks up to find, and the launcher. Both
       shims dispatch on their own filename, so the same file serves every
       frontend - see launcher.sh. -->
  <Target Name="DianaOSWritePublishRoot"
          AfterTargets="Publish"
          Condition="'$(DianaOSPublishLayout)' == 'true' And '$(DianaOSMacAppBundle)' != 'true'">
    <PropertyGroup>
      <_DianaOSRoot>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_DianaOSRoot>
    </PropertyGroup>
    <WriteLinesToFile File="$(_DianaOSRoot)$(DianaOSRootMarkerFileName)"
                      Lines="DianaOS sandbox root. Created at publish time - see 'man hier'."
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(_DianaOSLauncherDir)launcher.sh"
          DestinationFiles="$(_DianaOSRoot)bin/$(AssemblyName)" />
    <Copy SourceFiles="$(_DianaOSLauncherDir)launcher.cmd"
          DestinationFiles="$(_DianaOSRoot)bin/$(AssemblyName).cmd" />
    <!-- Copy does not carry the source's mode bits across. -->
    <Exec Command="chmod +x &quot;$(_DianaOSRoot)bin/$(AssemblyName)&quot;"
          Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <!-- Every published build carries the GPL, the third-party notices and the licence texts at its root, or in a Mac bundle's Contents/Resources - see THIRD_PARTY_NOTICES.md. -->
  <Target Name="DianaOSPublishNotices" AfterTargets="Publish">
    <PropertyGroup>
      <_DianaOSRepoRoot>$(MSBuildThisFileDirectory)../../</_DianaOSRepoRoot>
      <_DianaOSNoticeDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_DianaOSNoticeDir>
      <_DianaOSNoticeDir Condition="'$(DianaOSMacAppBundle)' == 'true'">$(_DianaOSNoticeDir)$(_DianaOSMacContents)/Resources/</_DianaOSNoticeDir>
    </PropertyGroup>
    <ItemGroup>
      <_DianaOSNotice Include="$(_DianaOSRepoRoot)LICENSE;$(_DianaOSRepoRoot)THIRD_PARTY_NOTICES.md" />
      <_DianaOSLicenceText Include="$(_DianaOSRepoRoot)licenses/*" />
    </ItemGroup>
    <Error Condition="!Exists('$(_DianaOSRepoRoot)THIRD_PARTY_NOTICES.md')" Text="THIRD_PARTY_NOTICES.md is missing; a build may not ship without it." />
    <Copy SourceFiles="@(_DianaOSNotice)" DestinationFolder="$(_DianaOSNoticeDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DianaOSLicenceText)" DestinationFolder="$(_DianaOSNoticeDir)licenses" SkipUnchangedFiles="true" />
  </Target>

  <!-- The bundle's Info.plist, from Info.plist.in beside this file, and its
       icon. CFBundleExecutable is the apphost, which already sits in
       Contents/MacOS; CFBundleIconFile names the .icns without its extension,
       as macOS looks it up in Contents/Resources. -->
  <Target Name="DianaOSWriteMacAppBundle"
          AfterTargets="Publish"
          Condition="'$(DianaOSMacAppBundle)' == 'true'">
    <PropertyGroup>
      <_DianaOSMacBundleDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))$(_DianaOSMacContents)/</_DianaOSMacBundleDir>
      <_DianaOSMacIconName>$([System.IO.Path]::GetFileNameWithoutExtension('$(DianaOSMacAppIcon)'))</_DianaOSMacIconName>
      <_DianaOSMacDisplayName Condition="'$(DianaOSMacDisplayName)' == ''">$(DianaOSMacAppName)</_DianaOSMacDisplayName>
      <_DianaOSMacDisplayName Condition="'$(DianaOSMacDisplayName)' != ''">$(DianaOSMacDisplayName)</_DianaOSMacDisplayName>
      <_DianaOSMacInfoPlist>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Info.plist.in'))</_DianaOSMacInfoPlist>
      <_DianaOSMacInfoPlist>$(_DianaOSMacInfoPlist.Replace('@NAME@', '$(DianaOSMacAppName)').Replace('@DISPLAYNAME@', '$(_DianaOSMacDisplayName)'))</_DianaOSMacInfoPlist>
      <_DianaOSMacInfoPlist>$(_DianaOSMacInfoPlist.Replace('@IDENTIFIER@', '$(DianaOSMacBundleIdentifier)').Replace('@EXECUTABLE@', '$(AssemblyName)'))</_DianaOSMacInfoPlist>
      <_DianaOSMacInfoPlist>$(_DianaOSMacInfoPlist.Replace('@ICON@', '$(_DianaOSMacIconName)').Replace('@VERSION@', '$(Version)'))</_DianaOSMacInfoPlist>
      <_DianaOSMacInfoPlist>$(_DianaOSMacInfoPlist.Replace('@MINIMUMSYSTEMVERSION@', '$(DianaOSMacMinimumSystemVersion)').Replace('@CATEGORY@', '$(DianaOSMacCategory)'))</_DianaOSMacInfoPlist>
    </PropertyGroup>
    <Error Condition="'$(DianaOSMacBundleIdentifier)' == ''" Text="A Mac app bundle needs DianaOSMacBundleIdentifier, its reverse-DNS id." />
    <Error Condition="'$(DianaOSMacAppIcon)' == '' Or !Exists('$(DianaOSMacAppIcon)')" Text="A Mac app bundle needs DianaOSMacAppIcon, an existing .icns file; '$(DianaOSMacAppIcon)' is not one." />
    <WriteLinesToFile File="$(_DianaOSMacBundleDir)Info.plist" Lines="$(_DianaOSMacInfoPlist)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(DianaOSMacAppIcon)" DestinationFiles="$(_DianaOSMacBundleDir)Resources/$(_DianaOSMacIconName).icns" SkipUnchangedFiles="true" />
    <!-- Copy does not carry the source's mode bits across, and a bundle zipped on Linux keeps what it has here. -->
    <Exec Command="chmod +x &quot;$(_DianaOSMacBundleDir)MacOS/$(AssemblyName)&quot;"
          Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <!-- Ad hoc signing, last, so the seal covers the notices and Info.plist
       too; arm64 macOS will not start unsigned code at all. Only a Mac has
       codesign. A bundle published elsewhere is left unsigned and says so.
       Signing with a Developer ID, the hardened runtime and notarization are
       not done yet - see EmuSen_Settings_Reference.md §4.82. -->
  <Target Name="DianaOSSignMacAppBundle"
          AfterTargets="Publish"
          DependsOnTargets="DianaOSPublishNotices;DianaOSWriteMacAppBundle"
          Condition="'$(DianaOSMacAppBundle)' == 'true'">
    <PropertyGroup>
      <_DianaOSMacAppDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))$(DianaOSMacAppName).app</_DianaOSMacAppDir>
    </PropertyGroup>
    <Exec Command="codesign --force --deep -s - &quot;$(_DianaOSMacAppDir)&quot;"
          Condition="'$(DianaOSMacCodesign)' == 'true' And $([MSBuild]::IsOSPlatform('OSX'))" />
    <Message Importance="high"
             Condition="'$(DianaOSMacCodesign)' != 'true' Or !$([MSBuild]::IsOSPlatform('OSX'))"
             Text="$(DianaOSMacAppName).app is not signed. On a Mac, run: codesign --force --deep -s - &quot;$(DianaOSMacAppName).app&quot;" />
  </Target>

</Project>
