<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        x:Class="EmuSen.Mistress.Views.RomBrowserWindow"
        Title="Browse ROMs"
        Width="420" Height="480">

    <DockPanel Margin="16">

        <luna:HintText DockPanel.Dock="Top"
                       x:Name="DirectoryText"
                       Margin="0,0,0,8" />

        <luna:ButtonBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="OpenButton" Content="Open" Click="OnOpenClick" />
            <Button Content="Cancel" Click="OnCancelClick" />
        </luna:ButtonBar>

        <ListBox x:Name="RomList" DoubleTapped="OnRomListDoubleTapped" />

    </DockPanel>

</Window>
