<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        x:Class="EmuSen.Mistress.Views.InputSettingsWindow"
        Title="Controller Settings"
        Width="820" Height="720"
        MinWidth="760" MinHeight="420"
        CanResize="True">

    <!-- General first, then one tab per console - see EmuSen_Input.md §5.1. -->
    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="Click Rebind, then press the key or controller button you want. Escape cancels. A key can only do one thing on the same console, so binding it somewhere new clears it from wherever it was."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="ConflictText"
                           Foreground="{DynamicResource LunaWarning}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <luna:ButtonBar Grid.Column="1">
                    <Button Content="Reset to Defaults" Click="OnResetClick" />
                    <Button Content="Close" Click="OnCloseClick" IsCancel="False" />
                </luna:ButtonBar>
            </Grid>
        </Border>

        <luna:Tabs x:Name="Tabs">

            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Spacing="4" Margin="0,8,0,0">

                        <TextBlock Text="Emulator Hotkeys" FontWeight="Bold" Margin="0,0,0,2" />
                        <luna:HintText Text="Actions on the emulator itself, shared by every console. Fast Forward and Rewind apply while held; the rest fire once per press."
                                       Margin="0,0,0,6" />
                        <Grid x:Name="HotkeyHeaderRow" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Text="Action" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Keyboard" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel x:Name="HotkeysPanel" Spacing="6" />

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="Gamepad" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock x:Name="ControllerStatusText" Margin="0,0,0,8" />
                        <luna:LunaSwitch x:Name="AnalogStickAsDpadCheckBox"
                                  Label="Use the left stick as a d-pad"
                                  IsCheckedChanged="OnAnalogStickAsDpadChanged" />
                        <luna:HintText Text="Neither of these consoles reads an analog axis, so the stick is only useful mapped onto the d-pad directions."
                                       Margin="24,2,0,8" />
                        <Grid ColumnDefinitions="Auto,240,Auto" Margin="24,0,0,0">
                            <TextBlock Grid.Column="0" Text="Stick deadzone" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <!-- The label is the TextBlock to its left, which a
                                 screen reader has no reason to connect to it.
                                 This was the one control in this window with no
                                 name at all, and a nameless slider is worse than
                                 a nameless button: it announces a bare number,
                                 changing as you press an arrow key, with nothing
                                 to say what it measures. LunaP.md §24.2. -->
                            <Slider Grid.Column="1"
                                    x:Name="DeadzoneSlider"
                                    AutomationProperties.Name="Stick deadzone"
                                    AutomationProperties.HelpText="How far the stick must travel before it counts as a direction."
                                    Minimum="0.05" Maximum="0.95"
                                    SmallChange="0.05" LargeChange="0.1"
                                    ValueChanged="OnDeadzoneChanged" />
                            <TextBlock Grid.Column="2" x:Name="DeadzoneText" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <luna:HintText Text="How far the stick must travel before it counts as a direction. Raise it if your stick drifts."
                                       Margin="24,2,0,0" />

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="Player 2" FontWeight="Bold" Margin="0,0,0,6" />
                        <luna:LunaSwitch x:Name="MirrorPlayer1ToPlayer2CheckBox"
                                  Label="Mirror Player 1 input to Player 2"
                                  IsCheckedChanged="OnMirrorPlayer1ToPlayer2Changed" />
                        <luna:HintText Text="Compatibility option for games that read Controller 2 instead of Controller 1 (e.g. Super Mario All-Stars' classic Mario games). Leave off for real two-player sessions."
                                       Margin="24,2,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Console tabs are appended here by BuildConsoleTabs, so a new core needs no XAML. -->

        </luna:Tabs>

    </DockPanel>

</Window>
