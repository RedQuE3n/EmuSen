# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command pal
usage 1   pal [<index>]                 one palette, or all of them if omitted

case palettes
target fake
covers 1
$ pal
out 36
pal  0: 000000 FF8008
pal  1: 0A141E
status 0
action none
$ pal 0
out 21
pal  0: 000000 FF8008
status 0
action none
$ pal 1
out 14
pal  1: 0A141E
status 0
action none
$ pal 9
out 0

status 0
action none
$ pal x
out 46
Error: Could not find any recognizable digits.
status 1
action none
end

case a bare target
target bare
covers 1
$ pal
out 0

status 0
action none
end

case with no target
target none
covers 1
$ pal
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
end

case on venus
target venus
covers 1
$ pal 0
out 119
pal  0: 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000
status 0
action none
end

case on venusrt
target venusrt
covers 1
$ pal 0
out 119
pal  0: 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000 000000
status 0
action none
end

case on moon
target moon
covers 1
$ pal 0
out 35
pal  0: 545454 545454 545454 545454
status 0
action none
end

case on moonrt
target moonrt
covers 1
$ pal 0
out 35
pal  0: 545454 545454 545454 545454
status 0
action none
end

case on mercury
target mercury
covers 1
$ pal 0
out 35
pal  0: FFFFFF 000000 000000 000000
status 0
action none
end

case on mercuryrt
target mercuryrt
covers 1
$ pal 0
out 35
pal  0: FFFFFF 000000 000000 000000
status 0
action none
end

case on marsrt
target marsrt
covers 1
$ pal 0
out 0

status 0
action none
end

case on nephrite
target nephrite
covers 1
$ pal 0
out 0

status 0
action none
end
