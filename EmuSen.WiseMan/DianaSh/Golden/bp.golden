# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command bp
usage 1   bp add <addr>[-<end>] [if <expr>] [log <expr>]
usage 2                                 halt just before <addr> runs (24-bit CPU address, or a range);
usage 3                                 with 'log' it records <expr> and carries on instead of halting
usage 4   bp write <space> <addr>[-<end>] [<v>] [changed] [if <expr>]
usage 5                                 halt just after anything writes that address
usage 6   bp read <space> <addr>[-<end>] [<v>] [if <expr>]
usage 7                                 halt just after anything reads it
usage 8   bp uninit <space>             halt the first time never-written memory is read back
usage 9   bp when <condition> [log|off] halt (or just record) when the hardware does something
usage 10                                 it should not - `bp when` alone lists what this core detects
usage 11   bp depth <n>                  halt if the call stack ever gets deeper than <n>
usage 12   bp forbid <addr>-<end>        never halt while the PC is in this range
usage 13   bp log [<count>] | bp log clear
usage 14                                 show (or forget) what the logpoints have recorded
usage 15   bp list                       list active breakpoints with their IDs and hit counts
usage 16   bp on|off <id>                enable/disable one breakpoint without removing it
usage 17   bp remove <id>                remove a breakpoint entirely
usage 18   bp <cpu> add|list|remove ...  same, on another processor - `cpus` lists them, and each
usage 19                                 one's addresses are its own address space
usage 20   (see also: `cpus`, `step`, `runto`, and the F4 prompt's own 'continue'/'c')

case pc breakpoints
target fake
covers 1-3,15-17,20
$ bp
out 37
Usage: bp [<cpu>] add|list|remove ...
status 0
action none
$ bp add
out 40
Usage: bp add <addr>[-<end>] [if <expr>]
status 0
action none
$ bp add 8003
out 31
Breakpoint #1 added at $008003.
status 0
action none
$ bp add 8000-8010 if A==0x12
out 50
Breakpoint #2 added at $008000-$008010 if A==0x12.
status 0
action none
$ bp add 8010-8000
out 39
Breakpoint #3 added at $008000-$008010.
status 0
action none
$ bp add 8009 log A
out 39
Breakpoint #4 logging at $008009 log A.
status 0
action none
$ bp add 800C if A==1 log X
out 47
Breakpoint #5 logging at $00800C if A==1 log X.
status 0
action none
$ bp add zz
out 46
Error: Could not find any recognizable digits.
status 1
action none
$ echo $?
out 1
1
status 0
action none
$ bp list
out 212
  #1: $008003 (enabled, hit 0x)
  #2: $008000-$008010 if A==0x12 (enabled, hit 0x)
  #3: $008000-$008010 (enabled, hit 0x)
  #4: $008009 log A (enabled, logged 0x)
  #5: $00800C if A==1 log X (enabled, logged 0x)
status 0
action none
$ bp off 1
out 23
Breakpoint #1 disabled.
status 0
action none
$ bp on 1
out 22
Breakpoint #1 enabled.
status 0
action none
$ bp on
out 17
Usage: bp on <id>
status 0
action none
$ bp on 99
out 25
No breakpoint #153 found.
status 1
action none
$ echo $?
out 1
1
status 0
action none
$ bp remove 2
out 22
Breakpoint #2 removed.
status 0
action none
$ bp remove 99
out 24
No breakpoint #99 found.
status 0
action none
$ echo $?
out 1
0
status 0
action none
$ bp remove
out 21
Usage: bp remove <id>
status 0
action none
$ bp list
out 161
  #1: $008003 (enabled, hit 0x)
  #3: $008000-$008010 (enabled, hit 0x)
  #4: $008009 log A (enabled, logged 0x)
  #5: $00800C if A==1 log X (enabled, logged 0x)
status 0
action none
$ bp frob
out 99
Unknown 'bp' subcommand 'frob'. Try add/read/write/uninit/when/depth/forbid/log/list/on/off/remove.
status 0
action none
end

case data breakpoints
target fake
covers 4-7,15
$ bp write RAM 42 7
out 49
