<luna:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Windowing;assembly=EmuSen.LunaP"
        xmlns:lunac="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        xmlns:views="clr-namespace:EmuSen.Mistress.Views"
        x:Class="EmuSen.Mistress.Views.CheatDatabaseWindow"
        Title="Cheat Database"
        Width="820" Height="620"
        MinWidth="640" MinHeight="480">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="EmuSen ships no cheat data. Point this at a cheat folder you already have - a RetroArch cheats folder works as-is - or download one."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="Cheat Folder" FontWeight="Bold" />
        <!-- lunac:PathPickerRow, NOT a read-only TextBox and a Browse button
             spelled out again. It was the second of those until the 0.5.0 bump
             made the difference visible: the toolkit control names its own parts
             and the copy named nothing, so the same row was accessible in
             PreferencesWindow and silent here. Naming the copy by hand would
             have closed that gap and kept the thing that caused it - which is
             the argument EmuSen_LunaP.md §6.1 already made about three copies of
             a frame hand-off sharing one bug. §7.2. -->
        <lunac:PathPickerRow DockPanel.Dock="Top"
                            x:Name="DirectoryPicker"
                            Margin="0,4,0,12"
                            Placeholder="(default)"
                            BrowseTitle="Choose a cheat folder (a RetroArch cheats folder works as-is)" />

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Carries the result of a download or a prune, which is
                     read rather than sought. Polite waits for a pause instead of
                     interrupting; a status line carries far more that can wait
                     than that cannot. -->
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           AutomationProperties.LiveSetting="Polite"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <lunac:ButtonBar Grid.Column="1">
                    <Button x:Name="ActiveCheatsButton" Content="Active Cheats..." Click="OnActiveCheatsClick" />
                    <!-- Two-stage on purpose: the first click only reports
                         what would go - see EmuSen_Settings_Reference.md §4.16. -->
                    <Button x:Name="PruneButton" Content="Prune Unsupported" Click="OnPruneClick" />
                    <Button x:Name="DownloadButton" Content="Download from libretro" Click="OnDownloadClick" />
                    <Button Content="Close" Click="OnCloseClick" />
                </lunac:ButtonBar>
            </Grid>
        </Border>

        <!-- CC BY-SA 4.0 requires attribution, and the codes were
             aggregated from elsewhere - both belong in front of the user
             before they download, not buried in a doc. -->
        <Border DockPanel.Dock="Bottom"
                Padding="10"
                Margin="0,12,0,0"
                CornerRadius="4"
                Background="{DynamicResource SystemChromeLowColor}">
            <lunac:HintText x:Name="AttributionText" />
        </Border>

        <!-- Systems on the left, that system's games on the right - see
             EmuSen_Settings_Reference.md §4.14. -->
        <Grid ColumnDefinitions="2*,12,3*">

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Installed" FontWeight="Bold" Margin="0,0,0,4" />
                <lunac:LunaList x:TypeArguments="views:CheatSystemRow"
                               x:Name="SystemsList"
                               AutomationProperties.Name="Systems with cheat files"
                               SelectionChanged="OnSystemSelected" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="GamesHeaderText" Text="Games" FontWeight="Bold" Margin="0,0,0,4" />
                <lunac:FilterBar DockPanel.Dock="Top"
                                x:Name="GameFilter"
                                Placeholder="Filter games..."
                                Margin="0,0,0,6" />
                <Button DockPanel.Dock="Bottom"
                        x:Name="LoadGameButton"
                        Content="Load into Active Cheats"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,6,0,0"
                        IsEnabled="False"
                        Click="OnLoadGameClick" />
                <!-- Still a ListBox: LunaList<T> is where T : class and
                     CheatDatabaseEntry is a struct - see §4.11a. -->
                <ListBox x:Name="GamesList"
                         AutomationProperties.Name="Games in the selected system"
                         SelectionChanged="OnGameSelected"
                         DoubleTapped="OnGameActivated" />
            </DockPanel>

        </Grid>

    </DockPanel>

</luna:ToolWindow>
