<Project>
  <!-- The Rust cores' libraries in a publish for another platform: the host's dropped, each crate's prebuilt one taken from $(EmuSenNativePrebuilt)/<rid>/, or a warning - see Mars_Native.md §6.3, Mercury_Native.md §8.6. The platform library goes the same way, and is an error once a program cannot start without it - see EmuSen_RustPlatform.md §2.6. -->
  <Import Project="RustCores.props" Condition="'$(EmuSenRustCoresImported)' != 'true'" />
  <Import Project="..\..\Platform\Platform.props" Condition="'$(EmuSenPlatformImported)' != 'true'" />

  <PropertyGroup>
    <!-- A distribution's SDK names its host by distribution (fedora.44-x64); the portable name is what a publish asks for. -->
    <EmuSenNativeForeign Condition="'$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != '$(NETCoreSdkRuntimeIdentifier)' And '$(RuntimeIdentifier)' != '$(NETCoreSdkPortableRuntimeIdentifier)'">true</EmuSenNativeForeign>
    <EmuSenPublishLibraryPrefix Condition="!$(RuntimeIdentifier.StartsWith('win'))">lib</EmuSenPublishLibraryPrefix>
    <EmuSenPublishLibrarySuffix Condition="$(RuntimeIdentifier.StartsWith('win'))">.dll</EmuSenPublishLibrarySuffix>
    <EmuSenPublishLibrarySuffix Condition="$(RuntimeIdentifier.StartsWith('osx'))">.dylib</EmuSenPublishLibrarySuffix>
    <EmuSenPublishLibrarySuffix Condition="'$(EmuSenPublishLibrarySuffix)' == ''">.so</EmuSenPublishLibrarySuffix>
  </PropertyGroup>

  <Target Name="RustCoresForeignLibraries"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(EmuSenNative)' != 'false' And '$(EmuSenNativeForeign)' == 'true'">
    <PropertyGroup>
      <_EmuSenHostLibraryNames>;@(EmuSenRustCrate->'lib%(Identity).so;%(Identity).dll;lib%(Identity).dylib;lib%(Identity).so.core.json;%(Identity).dll.core.json;lib%(Identity).dylib.core.json');lib$(EmuSenPlatformLibraryName).so;$(EmuSenPlatformLibraryName).dll;lib$(EmuSenPlatformLibraryName).dylib;cores.manifest;</_EmuSenHostLibraryNames>
      <_EmuSenPlatformPublishFile>$(EmuSenPublishLibraryPrefix)$(EmuSenPlatformLibraryName)$(EmuSenPublishLibrarySuffix)</_EmuSenPlatformPublishFile>
      <_EmuSenPlatformForeign Condition="'$(EmuSenNativePrebuilt)' != ''">$(EmuSenNativePrebuilt)/$(RuntimeIdentifier)/$(_EmuSenPlatformPublishFile)</_EmuSenPlatformForeign>
      <_EmuSenPlatformForeignFound Condition="'$(_EmuSenPlatformForeign)' != '' And Exists('$(_EmuSenPlatformForeign)')">true</_EmuSenPlatformForeignFound>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$(_EmuSenHostLibraryNames.Contains(';%(Filename)%(Extension);'))" />
      <_EmuSenForeignLibrary Include="@(EmuSenRustCrate)" Condition="'%(EmuSenRustCrate.InDevelopment)' != 'true'">
        <PublishFile>$(EmuSenPublishLibraryPrefix)%(Identity)$(EmuSenPublishLibrarySuffix)</PublishFile>
      </_EmuSenForeignLibrary>
      <_EmuSenForeignLibrary Condition="'$(EmuSenNativePrebuilt)' != ''">
        <Prebuilt>$(EmuSenNativePrebuilt)/$(RuntimeIdentifier)/%(PublishFile)</Prebuilt>
      </_EmuSenForeignLibrary>
    </ItemGroup>
    <Warning Condition="('%(_EmuSenForeignLibrary.Prebuilt)' == '' Or !Exists('%(_EmuSenForeignLibrary.Prebuilt)')) And '%(_EmuSenForeignLibrary.Fallback)' != ''"
             Text="No %(_EmuSenForeignLibrary.Core) library for $(RuntimeIdentifier): this publish runs %(_EmuSenForeignLibrary.Console) on %(_EmuSenForeignLibrary.Fallback) alone. Build %(_EmuSenForeignLibrary.PublishFile) with the Rust cores workflow and pass -p:EmuSenNativePrebuilt=&lt;dir&gt; holding $(RuntimeIdentifier)/%(_EmuSenForeignLibrary.PublishFile)." />
    <Warning Condition="('%(_EmuSenForeignLibrary.Prebuilt)' == '' Or !Exists('%(_EmuSenForeignLibrary.Prebuilt)')) And '%(_EmuSenForeignLibrary.Fallback)' == ''"
             Text="No %(_EmuSenForeignLibrary.Core) library for $(RuntimeIdentifier): this publish has no engine for %(_EmuSenForeignLibrary.Console). Build %(_EmuSenForeignLibrary.PublishFile) with the Rust cores workflow and pass -p:EmuSenNativePrebuilt=&lt;dir&gt; holding $(RuntimeIdentifier)/%(_EmuSenForeignLibrary.PublishFile)." />
    <Error Condition="'$(_EmuSenPlatformForeignFound)' != 'true' And '$(EmuSenPlatformRequired)' == 'true'"
           Text="No $(_EmuSenPlatformPublishFile) for $(RuntimeIdentifier): the programs cannot start without the platform library. Build it with the Rust cores workflow and pass -p:EmuSenNativePrebuilt=&lt;dir&gt; holding $(RuntimeIdentifier)/$(_EmuSenPlatformPublishFile)." />
    <Message Condition="'$(_EmuSenPlatformForeignFound)' != 'true' And '$(EmuSenPlatformRequired)' != 'true'" Importance="high"
             Text="No $(_EmuSenPlatformPublishFile) for $(RuntimeIdentifier): this publish runs the platform components on their C# implementations. Build it with the Rust cores workflow and pass -p:EmuSenNativePrebuilt=&lt;dir&gt; holding $(RuntimeIdentifier)/$(_EmuSenPlatformPublishFile)." />
    <ItemGroup Condition="'$(_EmuSenPlatformForeignFound)' == 'true'">
      <ResolvedFileToPublish Include="$(_EmuSenPlatformForeign)" RelativePath="$(_EmuSenPlatformPublishFile)" CopyToPublishDirectory="PreserveNewest" AssetType="native" />
    </ItemGroup>
    <ItemGroup>
      <_EmuSenForeignPrebuilt Include="@(_EmuSenForeignLibrary->'%(Prebuilt)')" Condition="'%(_EmuSenForeignLibrary.Prebuilt)' != '' And Exists('%(_EmuSenForeignLibrary.Prebuilt)')" />
      <ResolvedFileToPublish Include="@(_EmuSenForeignPrebuilt)" RelativePath="%(_EmuSenForeignPrebuilt.PublishFile)" CopyToPublishDirectory="PreserveNewest" AssetType="native" />
      <!-- A core ABI v1 library's sidecar, <library>.core.json, beside it in the prebuilt folder as the workflow uploads it; discovery lists a v1 core by it alone - see EmuSen_CoreAPI.md §7.1. -->
      <_EmuSenForeignSidecarCandidate Include="@(_EmuSenForeignPrebuilt->'%(Identity).core.json')" />
      <_EmuSenForeignSidecar Include="@(_EmuSenForeignSidecarCandidate)" Condition="Exists('%(_EmuSenForeignSidecarCandidate.Identity)')" />
      <ResolvedFileToPublish Include="@(_EmuSenForeignSidecar)" RelativePath="%(_EmuSenForeignSidecar.PublishFile).core.json" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <!-- The host's cores.manifest names the host's libraries, so the publish carries one of the prebuilt ones instead - see EmuSen_Backend.md §27.5. -->
    <GetFileHash Condition="'@(_EmuSenForeignPrebuilt)' != ''" Files="@(_EmuSenForeignPrebuilt)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_EmuSenForeignHashed" />
    </GetFileHash>
    <ItemGroup>
      <_EmuSenForeignManifestLine Include="$([System.String]::Copy('%(_EmuSenForeignHashed.FileHash)').ToLowerInvariant())  %(_EmuSenForeignHashed.PublishFile)" Condition="'@(_EmuSenForeignHashed)' != ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(RuntimeIdentifier).cores.manifest" Lines="@(_EmuSenForeignManifestLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(IntermediateOutputPath)$(RuntimeIdentifier).cores.manifest" RelativePath="cores.manifest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
