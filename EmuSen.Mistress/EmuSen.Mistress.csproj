<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia GUI: a library of the ROM folder, the running game,
       save states, controller rebinding and per-console settings. Built as
       bug-testing tooling and, since 2026-09-21, being modelled on OpenEmu
       as the project's frontend - see EmuSen_Mistress_LibraryPlan.md §7 for
       that change and the earlier decision it replaced. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Precompiled at publish for a start ~360 ms sooner; the JIT still re-tiers hot code - see EmuSen_Settings_Reference.md §4.42. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- The crescent-and-E icon; its sources and build script are in Assets/Icon - see EmuSen_Settings_Reference.md §4.55. -->
    <ApplicationIcon>Assets\Icon\emusen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Icon\png\emusen-256.png" />
  </ItemGroup>

  <!-- Linux: the hicolor icons and a script that installs a desktop entry pointing at this build - see §4.55. -->
  <Target Name="MistressPublishDesktopIcons" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <ItemGroup>
      <_MistressIconSize Include="16;24;32;48;64;128;256;512" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets/Icon/png/emusen-%(_MistressIconSize.Identity).png"
          DestinationFiles="$(PublishDir)share/icons/hicolor/%(_MistressIconSize.Identity)x%(_MistressIconSize.Identity)/apps/emusen-mistress.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets/Icon/emusen.svg" DestinationFiles="$(PublishDir)share/icons/hicolor/scalable/apps/emusen-mistress.svg" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets/Icon/install-desktop-entry.sh" DestinationFolder="$(PublishDir)bin" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(PublishDir)bin/install-desktop-entry.sh&quot;" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- Views/InputSettingsWindow.axaml.cs names SDL.GamepadButton directly,
         so the bindings are referenced explicitly rather than leant on
         transitively via EmuSen.Endymion - the same convention
         EmuSen.Serenity's csproj follows. The native comes with that
         project reference; see EmuSen_Settings_Reference.md §4.9. -->
    <PackageReference Include="SDL3-CS" Version="3.4.2" />
    <!-- Native X11 backend, shipped in 12.1. Not picked up by
         UsePlatformDetect() automatically on a Wayland session - opted into
         explicitly in Program.cs (Linux only, see comments there). -->
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
    <!-- Only needed for the in-app dev inspector (Alt+Shift+F12 at runtime);
         excluded outside Debug builds so it doesn't ship in Release. Note:
         this replaces the old "Avalonia.Diagnostics" package, which was
         retired at 11.3.x and never got a 12.x release - this is its
         successor as of Avalonia 12. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls in the emulation core (Cores/Nintendo/Venus - SNES/*, Settings/*, etc).
         EmuSen.csproj is a pure library (no Main, no window ownership) - the Raylib
         console frontend's own Main/hotkey loop lives in the sibling
         EmuSen.Hotaru project instead, so this reference no longer drags
         in another frontend's Exe/window-ownership baggage, just the core. -->
    <ProjectReference Include="..\EmuSen\EmuSen.csproj" />
    <!-- GameFrameControl (see Views/MainWindow.axaml/.axaml.cs) - the same
         GPU-accelerated (Skia/Ganesh, when Avalonia negotiates a hardware
         context) presentation surface EmuSen.Hotaru's GameWindow uses,
         replacing the old CPU-side WriteableBitmap here. -->
    <ProjectReference Include="..\EmuSen.Serenity\EmuSen.Serenity.csproj" />
    <!-- AppSettings, and the ConfigFile that ControllerKeyMap/
         HotkeyBindingMap persist through - see EmuSen_Config_Reference.md. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
    <!-- AudioPlayer/GamepadManager/GamepadBindingMap and the shared
         config root - one copy for both frontends, see
         EmuSen_Settings_Reference.md §4.10. -->
    <ProjectReference Include="..\EmuSen.Endymion\EmuSen.Endymion.csproj" />
    <!-- The shared theme (App.axaml's one StyleInclude), the Avalonia
         bootstrap sequence Program.cs used to spell out, and the controls/
         window scaffolding Views/ is migrating onto - see EmuSen_LunaP.md. -->
    <!-- Now through LunaP.props, which names where it comes from. -->
  </ItemGroup>


  <!-- A published build's output directory is DianaOS's own root: the .NET
       app dir moves to /lib/EmuSen, /bin gets a launcher. See `man hier`. -->
  <Import Project="..\EmuSen.DianaOS\Publish\DianaOSPublishLayout.targets" />
  <Import Project="..\EmuSen\Cores\RustCoresPublish.targets" />

  <Import Project="..\LunaP.props" />

</Project>
