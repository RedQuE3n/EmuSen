# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command disasm
usage 1   disasm <space> <addr> [<n>]   disassemble <n> instructions (default 10)
usage 2   disasm <cpu> [<addr>] [<n>]   same, in that processor's own code space and ISA -
usage 3                                 with no <addr>, starts at where it is executing now
usage 4   ... [m8|m16] [x8|x16]         65816 only: force the starting operand widths

case spaces and processors
target fake
covers 1-4
$ disasm
out 44
Usage: disasm <space>|<cpu> <addr> [<count>]
status 0
action none
$ disasm CpuBus
out 38
Usage: disasm <space> <addr> [<count>]
status 0
action none
$ disasm CpuBus 8000
out 269
  008000: 20 10 80  JSR $8010
  008003: AD 42 00  LDA $0042
  008006: 8D 43 00  STA $0043
  008009: 4C 00 80  JMP $8000
  00800C: EA        NOP
  00800D: EA        NOP
  00800E: EA        NOP
  00800F: EA        NOP
  008010: AD 43 00  LDA $0043
  008013: 60        NOP
status 0
action none
$ disasm CpuBus 8000 4
out 119
  008000: 20 10 80  JSR $8010
  008003: AD 42 00  LDA $0042
  008006: 8D 43 00  STA $0043
  008009: 4C 00 80  JMP $8000
status 0
action none
$ disasm cpu
out 263
  008003: AD 42 00  LDA $0042
  008006: 8D 43 00  STA $0043
  008009: 4C 00 80  JMP $8000
  00800C: EA        NOP
  00800D: EA        NOP
  00800E: EA        NOP
  00800F: EA        NOP
  008010: AD 43 00  LDA $0043
  008013: 60        NOP
  008014: EA        NOP
status 0
action none
$ disasm cpu 8009 2
out 53
  008009: 4C 00 80  JMP $8000
  00800C: EA        NOP
status 0
action none
$ disasm gsu
out 245
  000020: A0        NOP
  000021: AD BA C7  LDA $C7BA
  000024: D4        NOP
  000025: E1        NOP
  000026: EE        NOP
  000027: FB        NOP
  000028: 08        NOP
  000029: 15        NOP
  00002A: 22        NOP
  00002B: 2F        NOP
status 0
action none
$ disasm gsu 0 3
out 71
  000000: 00        NOP
  000001: 0D        NOP
  000002: 1A        NOP
status 0
action none
$ disasm ROM 0 6
out 167
  000000: 20 10 80  JSR $8010
  000003: AD 42 00  LDA $0042
  000006: 8D 43 00  STA $0043
  000009: 4C 00 80  JMP $8000
  00000C: EA        NOP
  00000D: EA        NOP
status 0
action none
$ disasm NOPE 0
out 83
Error: No memory space named 'NOPE'. Available: RAM, ROM, VRAM, IO, UNSIZED, CpuBus
status 1
action none
$ disasm CpuBus 8000 4 m8
out 140
  ; decoding with m8
  008000: 20 10 80  JSR $8010
  008003: AD 42 00  LDA $0042
  008006: 8D 43 00  STA $0043
  008009: 4C 00 80  JMP $8000
status 0
action none
$ disasm CpuBus 8000 2 m16 x8
out 84
  ; decoding with m16 x8
  008000: 20 10 80  JSR $8010
  008003: AD 42 00  LDA $0042
status 0
action none
$ label add 8010 sub fixed comment
out 21
$008010 is now 'sub'.
status 0
action none
$ disasm CpuBus 8000 6
out 176
  008000: 20 10 80  JSR $8010  ; <sub>
  008003: AD 42 00  LDA $0042
  008006: 8D 43 00  STA $0043
  008009: 4C 00 80  JMP $8000
  00800C: EA        NOP
  00800D: EA        NOP
status 0
action none
$ disasm UNSIZED 0
out 59
GOLDEN target has no disassembler, or nothing was returned.
status 0
action none
end

case a bare target
target bare
covers 1
$ disasm RAM 0 2
out 47
  000000: 03        NOP
  000001: 0A        NOP
status 0
action none
$ disasm cpu
out 38
Usage: disasm <space> <addr> [<count>]
status 0
action none
end

case with no target
target none
covers 1
$ disasm RAM 0
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
end

case on venusrt
target venusrt
covers 2-3
$ disasm cpu
out 239
  00ED30: EA        NOP
  00ED31: EA        NOP
  00ED32: EA        NOP
  00ED33: EA        NOP
  00ED34: EA        NOP
  00ED35: EA        NOP
  00ED36: EA        NOP
  00ED37: EA        NOP
  00ED38: EA        NOP
  00ED39: EA        NOP
status 0
action none
$ disasm cpu 0 4
out 115
  000000: 00 00     BRK #$00
  000002: 00 00     BRK #$00
  000004: 00 00     BRK #$00
  000006: 00 00     BRK #$00
status 0
action none
end

