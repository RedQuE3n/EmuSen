<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Shaderc's and Vulkan's bindings are pointers, as they are for Mars's GPU path - see EmuSen_Serenity.md §7.3. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- FramePresenter/GameFrameControl drive a real Avalonia window +
         Skia-backed rendering directly - see those files' own comments.
         What's shared here is the core-agnostic INPUT contract (byte[]
         rgba, width, height, via ICore) and the built-in shader source,
         so any frontend consuming this project gets the same effects/
         behavior instead of a hand-copied duplicate. Package versions
         match EmuSen.Mistress's own Avalonia references exactly.
         Avalonia.Skia/SkiaSharp are referenced explicitly (not left
         purely transitive via Avalonia.Desktop) since GameFrameControl
         calls directly into ISkiaSharpApiLeaseFeature/SKCanvas/
         SKRuntimeEffect. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- RetroArch's slang presets are Vulkan GLSL: Shaderc (glslang, Apache-2.0 natives, MIT binding) compiles them at run
         time, and they run on Vulkan, the same two packages and versions Mars and its tests already take - see
         EmuSen_Serenity.md §7.3. Their reflection is read from the SPIR-V here rather than taking SPIRV-Cross as well. -->
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <!-- The compiled SPIR-V cache is program-written data, so SQLite (EmuSen_Stack.md §2.3). The same two packages and
         versions as EmuSen, which every consumer of this project already references, so no program gains a
         library; Serenity is not a leaf in §2.3's sense and takes no project reference to reach them - see
         EmuSen_Serenity.md §9.4. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied, so the cache has no file of its own to be missing - see EmuSen_Serenity.md §9.4. -->
    <EmbeddedResource Include="Slang\spirv-cache-schema.sql" LogicalName="EmuSen.Serenity.Slang.spirv-cache-schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- GraphicsConfig, which GraphicsSettings maps to and from - see
         EmuSen_Config_Reference.md §3.3. The only reference this
         presentation-layer project has. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
    <!-- Dashboards/CoretopWindow.cs is a LunaP PollingWindow reading Cauldron's
         read-only telemetry contracts. It lived in the toolkit until the
         toolkit had to stop naming anything of EmuSen's - see EmuSen_LunaP.md
         §16 and §19.3. Both are core-free: Cauldron is a dependency-free leaf
         and LunaP now references nothing but Avalonia, so this stays the
         core-agnostic layer it already was. -->
    <!-- Now through LunaP.props, which names where it comes from. -->
    <ProjectReference Include="..\EmuSen.Cauldron\EmuSen.Cauldron.csproj" />
  </ItemGroup>

  <Import Project="..\LunaP.props" />

</Project>
