# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command mute
usage 1   mute <index> <on|off>         mute/unmute one audio channel - channel's own playback state still advances, it's just excluded from the mix

case muting and unmuting
target fake
covers 1
$ mute
out 140
  mute <index> <on|off>         mute/unmute one audio channel - channel's own playback state still advances, it's just excluded from the mix
status 0
action none
$ mute 1
out 140
  mute <index> <on|off>         mute/unmute one audio channel - channel's own playback state still advances, it's just excluded from the mix
status 0
action none
$ mute x on
out 140
  mute <index> <on|off>         mute/unmute one audio channel - channel's own playback state still advances, it's just excluded from the mix
status 0
action none
$ mute 1 on
out 16
Channel 1 muted.
status 0
action none
$ channels
out 200
[0] VOICE0   active=True  level=  0 muted=False 
[1] VOICE1   active=False level= 25 muted=True  
[2] VOICE2   active=True  level= 50 muted=False 
[3] VOICE3   active=False level= 75 muted=False noise
status 0
action none
$ mute 1 off
out 18
Channel 1 unmuted.
status 0
action none
$ mute 1 sideways
out 18
Channel 1 unmuted.
status 0
action none
$ mute 9 on
out 16
Channel 9 muted.
status 0
action none
$ mute -1 on
out 17
Channel -1 muted.
status 0
action none
$ channels
out 200
[0] VOICE0   active=True  level=  0 muted=False 
[1] VOICE1   active=False level= 25 muted=False 
[2] VOICE2   active=True  level= 50 muted=False 
[3] VOICE3   active=False level= 75 muted=False noise
status 0
action none
end

case with no target
target none
covers 1
$ mute 1 on
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
end

case on venusrt
target venusrt
covers 1
$ mute 0 on
out 16
Channel 0 muted.
status 0
action none
$ channels
out 37
(this core reports no audio channels)
status 0
action none
end

case on moonrt
target moonrt
covers 1
$ mute 0 on
out 16
Channel 0 muted.
status 0
action none
$ channels
out 425
[0] Pulse 1  active=False level=  0 muted=False Duty=0 Period=0 Vol=0 Len=0 Sweep=False
[1] Pulse 2  active=False level=  0 muted=False Duty=0 Period=0 Vol=0 Len=0 Sweep=False
[2] Triangle active=False level=  0 muted=False Period=0 Len=0 Halt=False
[3] Noise    active=False level=  0 muted=False PeriodIndex=0 Vol=0 Len=0 Short=False
[4] DMC      active=False level=  0 muted=False Rate=0 Out=0 Addr=0xC000 Len=0 Loop=False
status 0
action none
end

case on mercuryrt
target mercuryrt
covers 1
$ mute 0 on
out 16
Channel 0 muted.
status 0
action none
$ channels
out 321
[0] Pulse 1  active=False level=  0 muted=False Duty=0 Freq=0 Vol=0 Len=0 Sweep=0/0+
[1] Pulse 2  active=False level=  0 muted=False Duty=0 Freq=0 Vol=0 Len=0
[2] Wave     active=False level=  0 muted=False Freq=0 Vol=0 Len=0 Dac=False
[3] Noise    active=False level=  0 muted=False Shift=0 Div=0 Short=False Vol=0 Len=0
status 0
action none
end

case on nephrite
target nephrite
covers 1
$ mute 0 on
out 16
Channel 0 muted.
status 0
action none
$ channels
out 37
(this core reports no audio channels)
status 0
action none
end
