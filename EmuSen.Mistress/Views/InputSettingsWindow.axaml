<luna:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Windowing;assembly=EmuSen.LunaP"
        xmlns:lunac="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        x:Class="EmuSen.Mistress.Views.InputSettingsWindow"
        Title="Controller Settings"
        Width="1100" Height="800"
        MinWidth="760" MinHeight="480"
        CanResize="True">

    <!-- General first, then one tab per console - see EmuSen_Input.md §5.1. -->
    <DockPanel Margin="16">

        <!-- The words change with what the window is doing - see EmuSen_Settings_Reference.md §4.81. -->
        <TextBlock DockPanel.Dock="Top"
                   x:Name="HelpText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="ConflictText"
                           Foreground="{DynamicResource LunaWarning}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <lunac:ButtonBar Grid.Column="1">
                    <ToggleButton x:Name="TestToggle" Content="Test Buttons" Click="OnTestToggleClick"
                                  AutomationProperties.HelpText="While on, every press lights up on the drawing and nothing else happens" />
                    <Button x:Name="ResetButton" Content="Reset to Defaults" Click="OnResetClick" />
                    <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick" IsCancel="False" />
                </lunac:ButtonBar>
            </Grid>
        </Border>

        <!-- The player selector stands in the tab strip's empty right end, so the drawing keeps its height - see EmuSen_Input.md §8.4. -->
        <Grid>
        <lunac:Tabs x:Name="Tabs">

            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Spacing="4" Margin="0,8,0,0">

                        <!-- The pad's settings beside player 1's pad as SDL reads it, whose sticks show the deadzone as a ring - see EmuSen_Settings_Reference.md §4.81. -->
                        <Grid x:Name="GamepadSection" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" MaxWidth="520">
                                <TextBlock Text="Gamepad" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock x:Name="ControllerStatusText" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <lunac:LunaSwitch x:Name="AnalogStickAsDpadCheckBox"
                                          Label="Use the left stick as a d-pad"
                                          IsCheckedChanged="OnAnalogStickAsDpadChanged" />
                                <lunac:HintText Text="On a console with no stick of its own, the left stick then presses the d-pad."
                                               Margin="24,2,0,8" />
                                <Grid ColumnDefinitions="Auto,200,Auto" Margin="24,0,0,0">
                                    <TextBlock Grid.Column="0" Text="Stick deadzone" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <!-- Named for a screen reader, which has no reason to connect the text to its left to it - LunaP.md §24.2. -->
                                    <Slider Grid.Column="1"
                                            x:Name="DeadzoneSlider"
                                            AutomationProperties.Name="Stick deadzone"
                                            AutomationProperties.HelpText="How far the stick must travel before it counts as a direction."
                                            Minimum="0.05" Maximum="0.95"
                                            SmallChange="0.05" LargeChange="0.1"
                                            ValueChanged="OnDeadzoneChanged" />
                                    <TextBlock Grid.Column="2" x:Name="DeadzoneText" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <lunac:HintText Text="How far the stick must travel before it counts as a direction; the dashed ring on each stick of the drawing. Raise it if your stick drifts."
                                               Margin="24,2,0,0" />
                            </StackPanel>
                            <lunac:ControllerDiagram Grid.Column="1" x:Name="RawDiagram" Layout="Gamepad" IsInteractive="False" ShowsLabels="False"
                                                     Height="260" Margin="16,0,0,0" MinWidth="280"
                                                     AutomationProperties.Name="Your controller"
                                                     AutomationProperties.HelpText="Player 1's pad as it is read: every button, both sticks and both triggers." />
                        </Grid>

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="Emulator Hotkeys" FontWeight="Bold" Margin="0,0,0,2" />
                        <lunac:HintText Text="Actions on the emulator itself, shared by every console. Fast Forward and Rewind apply while held; the rest fire once per press."
                                       Margin="0,0,0,6" />
                        <Grid x:Name="HotkeyHeaderRow" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Text="Action" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Keyboard" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel x:Name="HotkeysPanel" Spacing="6" />

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="Player 2" FontWeight="Bold" Margin="0,0,0,6" />
                        <lunac:LunaSwitch x:Name="MirrorPlayer1ToPlayer2CheckBox"
                                  Label="Mirror Player 1 input to Player 2"
                                  IsCheckedChanged="OnMirrorPlayer1ToPlayer2Changed" />
                        <lunac:HintText Text="Compatibility option for games that read Controller 2 instead of Controller 1 (e.g. Super Mario All-Stars' classic Mario games). Leave off for real two-player sessions."
                                       Margin="24,2,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Console tabs are appended here by BuildConsoleTabs, so a new core needs no XAML. -->

        </lunac:Tabs>
        <StackPanel x:Name="PlayerBar" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

    </DockPanel>

</luna:ToolWindow>
