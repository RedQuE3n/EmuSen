<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real VenusCore + SnesDebugTarget/DebugCommandProcessor, run
         headless (no window/audio) and driven by a script of commands
         instead of a human at the F4 prompt. -->
    <ProjectReference Include="..\EmuSen\EmuSen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>


  <!-- A published build's output directory is DianaOS's own root: the .NET
       app dir moves to /lib/EmuSen, /bin gets a launcher. See `man hier`. -->
  <Import Project="..\EmuSen.DianaOS\Publish\DianaOSPublishLayout.targets" />


  <!-- The dictionary ships as SQL, never as a built .db: a binary in git cannot be
       reviewed, and reviewability is the whole point of a proof requirement - see §3.49. -->
  <ItemGroup>
    <None Include="Reference\Dictionary\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
