<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cores, the core manager, as a tool library: needs only LunaP, Galaxia and the platform library, the runtime handed in by its host - see EmuSen_LibraryTools.md §1b and EmuSen_Cores.md §3.4. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EmuSen.Tools.Cores</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmuSen.WiseMan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

  <Import Project="..\LunaP.props" />

</Project>
