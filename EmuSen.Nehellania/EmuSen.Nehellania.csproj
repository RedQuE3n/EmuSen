<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDL3 gamepad layer both GUI frontends sit on: polling and the
       rebindable pad map. Audio output moved out to EmuSen.Endymion; this
       project is now a leaf like EmuSen.Serenity - see EmuSen_Input.md §4. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL3 bindings (gamepad input) and the SDL3 binary itself - see
         EmuSen_Settings_Reference.md §4.9. -->
    <PackageReference Include="SDL3-CS" Version="3.4.2" />
    <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- PadButton and ConfigFile, which GamepadBindingMap is keyed by and
         persists through. The only reference this project has - no core, no
         Avalonia. See EmuSen_Input.md §4. -->
    <ProjectReference Include="..\EmuSen.Galaxia\EmuSen.Galaxia.csproj" />
  </ItemGroup>

</Project>
