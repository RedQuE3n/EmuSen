  ABORT        $00FFE8 -> $00EAEA
  NMI          $00FFEA -> $00EAEA
  IRQ          $00FFEE -> $00EAEA
Emulation (E=1):
  COP          $00FFF4 -> $00EAEA
  ABORT        $00FFF8 -> $00EAEA
  NMI          $00FFFA -> $00EAEA
  RESET        $00FFFC -> $008000
  IRQ/BRK      $00FFFE -> $00EAEA
