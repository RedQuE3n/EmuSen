# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command cp
usage 1   cp [-r] <src> <dst>           copy a file (-r: copy a directory and everything in it; dst may be an existing directory)

case files and directories
target none
covers 1
file a.txt 6
alpha

$ cp a.txt b.txt
out 0

status 0
action none
$ cat b.txt
out 5
alpha
status 0
action none
$ cp a.txt Logs
out 0

status 0
action none
$ ls Logs
out 5
a.txt
status 0
action none
$ cp Logs Copy
out 54
cp: 'Logs' is a directory (use -r to copy directories)
status 1
action none
$ cp -r Logs Copy
out 0

status 0
action none
$ ls Copy
out 5
a.txt
status 0
action none
$ cp
out 30
cp: usage: cp [-r] <src> <dst>
status 1
action none
$ cp a.txt
out 30
cp: usage: cp [-r] <src> <dst>
status 1
action none
$ cp nosuch x
out 37
cp: no such file or directory: nosuch
status 1
action none
$ cp /../x y
out 51
cp: '/../x' is outside the project sandbox (<ROOT>)
status 1
action none
$ cp a.txt /../y
out 51
cp: '/../y' is outside the project sandbox (<ROOT>)
status 1
action none
$ cp -r
out 30
cp: usage: cp [-r] <src> <dst>
status 1
action none
$ cp a.txt a.txt
out 98
cp: The process cannot access the file '<ROOT>/a.txt' because it is being used by another process.
status 1
action none
end
