<!-- The reference theme "EmuSen" as a package in the resources, which the theme host loads as it loads any theme (EmuSen_Qt.md §3.4). -->
<RCC>
    <qresource prefix="/emusen/themes/emusen">
        <file alias="parts/CoverFan.qml">../themes/emusen/parts/CoverFan.qml</file>
        <file alias="parts/EngineMark.qml">../themes/emusen/parts/EngineMark.qml</file>
        <file alias="parts/Faces.qml">../themes/emusen/parts/Faces.qml</file>
        <file alias="parts/Glyph.qml">../themes/emusen/parts/Glyph.qml</file>
        <file alias="screens/Consoles.qml">../themes/emusen/screens/Consoles.qml</file>
        <file alias="screens/Games.qml">../themes/emusen/screens/Games.qml</file>
        <file alias="screens/Home.qml">../themes/emusen/screens/Home.qml</file>
        <file alias="theme.json">../themes/emusen/theme.json</file>
    </qresource>
</RCC>
