<luna:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Windowing;assembly=EmuSen.LunaP"
        xmlns:lunac="clr-namespace:EmuSen.LunaP.Controls;assembly=EmuSen.LunaP"
        xmlns:lib="clr-namespace:EmuSen.Mistress.Library"
        x:Class="EmuSen.Mistress.Views.RomBrowserWindow"
        Title="Browse ROMs"
        Width="420" Height="480">

    <DockPanel Margin="16">

        <lunac:HintText DockPanel.Dock="Top"
                       x:Name="DirectoryText"
                       Margin="0,0,0,8" />

        <lunac:ButtonBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="OpenButton" Content="Open" Click="OnOpenClick" />
            <Button Content="Cancel" Click="OnCancelClick" />
        </lunac:ButtonBar>

        <lunac:LunaList x:TypeArguments="lib:RomEntry"
                       x:Name="RomList"
                       AutomationProperties.Name="ROMs in this folder"
                       DoubleTapped="OnRomListDoubleTapped" />

    </DockPanel>

</luna:ToolWindow>
