# DianaSh golden corpus. Recorded from the C# shell, byte for byte; EMUSEN_DIANASH_GOLDEN=record rewrites it - see EmuSen_DianaSh.md §13.4.
# Patterns: <ROOT> is the sandbox's real root, <TEMP> the corpus's real temporary folder, <INSTALL> the install's real directory;
# a 'match' block is a regular expression the whole output must match, written where a line prints a time or a measured number.
command load
usage 1   load <space> <addr> <file>    write home/Logs/<CoreName>/<file>'s raw bytes into <space> starting at <addr>

case bytes from a file
target fake
covers 1
file Logs/GOLDEN/in.bin 4

file top.bin 4
TOP!
$ load
out 33
Usage: load <space> <addr> <file>
status 0
action none
$ load RAM 10 in.bin
out 72
Loaded 4 bytes from <ROOT>/Logs/GOLDEN/in.bin into RAM starting at 0x10.
status 0
action none
$ mem RAM 10 4
out 85
RAM @ 0x10 (4 bytes):
  000010: 01 02 03 04                                      ....
status 0
action none
$ load ROM 0 in.bin
out 44
ROM is read-only - refusing to load into it.
status 0
action none
$ load RAM 0 nosuch.bin
out 41
No file at <ROOT>/Logs/GOLDEN/nosuch.bin.
status 0
action none
$ load NOPE 0 in.bin
out 83
Error: No memory space named 'NOPE'. Available: RAM, ROM, VRAM, IO, UNSIZED, CpuBus
status 1
action none
$ load RAM FE in.bin
out 72
Loaded 4 bytes from <ROOT>/Logs/GOLDEN/in.bin into RAM starting at 0xFE.
status 0
action none
$ echo $?
out 1
0
status 0
action none
$ mem RAM F0 10
out 98
RAM @ 0xF0 (16 bytes):
  0000F0: 93 9A A1 A8 AF B6 BD C4 CB D2 D9 E0 E7 EE 01 02  ................
status 0
action none
$ load RAM 0 ../../top.bin
out 60
Loaded 4 bytes from <ROOT>/top.bin into RAM starting at 0x0.
status 0
action none
$ mem RAM 0 4
out 84
RAM @ 0x0 (4 bytes):
  000000: 54 4F 50 21                                      TOP!
status 0
action none
end

case with no target
target none
covers 1
$ load RAM 0 x.bin
out 65
Error: No ROM loaded - this command needs an active debug target.
status 1
action none
end

case a file name that climbs out of the root
target fake
covers 1
file ../outside.bin 4
OUT!
$ load RAM 0 ../../../outside.bin
out 68
load: '../../../outside.bin' is outside the project sandbox (<ROOT>)
status 1
action none
$ load RAM 0 /Logs/GOLDEN/../../../outside.bin
out 81
load: '/Logs/GOLDEN/../../../outside.bin' is outside the project sandbox (<ROOT>)
status 1
action none
$ mem RAM 0 4
out 84
RAM @ 0x0 (4 bytes):
  000000: 03 0A 11 18                                      ....
status 0
action none
end
