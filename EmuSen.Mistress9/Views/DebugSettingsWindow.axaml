<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmuSen.Mistress9.Views.DebugSettingsWindow"
        Title="Debug Logging"
        Width="480" Height="560"
        MinWidth="420" MinHeight="360">

    <DockPanel Margin="16">

        <CheckBox x:Name="MasterLoggingCheckBox"
                  DockPanel.Dock="Top"
                  Content="Enable Logging (master switch)"
                  FontWeight="Bold"
                  Margin="0,0,0,4"
                  IsCheckedChanged="OnMasterLoggingChanged" />

        <TextBlock DockPanel.Dock="Top"
                   Text="Turns every flag below on/off at once without changing any of them individually - flip it back on to restore whatever was checked before. Individual flags are disabled while this is off."
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="11"
                   Margin="0,0,0,12" />

        <Button DockPanel.Dock="Bottom"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="OnCloseClick" />

        <ScrollViewer>
            <StackPanel x:Name="FlagsPanel" Spacing="4" />
        </ScrollViewer>

    </DockPanel>

</Window>
