# The registries over MoonRT on a loop that stores to RAM and calls a subroutine: watches, the call stack, steps to a
# depth, logpoints, data breakpoints, coverage, the profile, frame logs, freezes and labels with halts that resume.
log_switch 0
open $IMAGE
watch_add RAM $W 1 0
watch_add CPUBUS $W 1 2
watch_add RAM 0x40 8 1
frames 2
watch_events 1 4
watch_events 2 4
watch_events 3 4
watch_summary 1
watch_summary 2
watch_list
call_stack 0 4
profile_op 0 3 -
bp_add 4294967295 '{"address":$SUB}'
frames 2
halt_state 0
call_stack 0 4
call_stack 4294967295 1
profile_op 0 3 -
run_control 3 0 0
frames 1
halt_state 0
run_control 4 0 0
frames 1
halt_state 0
call_stack 0 4
run_control 2 0 1
frames 1
halt_state 0
bp_remove 0 1
bp_add 0 '{"address":$INC,"condition":"ppu.PPUCTRL == 0x10 && pulse1.Duty == 3"}'
bp_add 0 '{"address":$CALL,"log":"A, ppu.v, [$42], stackdepth"}'
run_control 1 0 0
frames 1
halt_state 0
bp_log 0 3
bp_list 0
bp_remove 0 2
run_control 1 0 0
frames 2
bp_log 0 3
bp_log 0 1
bp_remove 0 3
bp_add_data 0 '{"space":"RAM","address":$W}'
run_control 1 0 0
frames 2
halt_state 0
bp_list 0
bp_add_data 0 '{"space":"RAM","address":$W,"changed_only":true,"log":"A"}'
bp_remove 0 4
run_control 1 0 0
frames 3
bp_log 0 5
bp_list 0
bp_remove 0 5
run_control 1 0 0
frames 1
coverage_op 0 0 -
profile_op 0 0 -
frames 3
coverage_op 0 5 -
coverage_op 0 6 '{"address":32768,"length":64,"limit":8}'
coverage_op 0 8 '{"limit":4}'
coverage_op 4294967295 5 -
profile_op 0 3 -
profile_op 0 4 '{"limit":3}'
call_stack 0 4
framelog_add RAM $W 1
framelog_add CPUBUS 0x8000 2
frames 3
framelog_samples 1 5
framelog_samples 2 5
freeze_add RAM $W 0x55
frames 1
space_read RAM $W 1
freeze_list
watch_events 1 3
watch_summary 1
label_add 0x8000 Start "the loop"
label_add $SUB Sub -
label_list
label_at $SUB
label_save
bp_depth_guard 0 1
bp_forbid_range 0 $SUB $SUB
bp_list 0
run_control 1 0 0
frames 2
halt_state 0
bp_uninitialized 0 RAM 0x800
run_control 1 0 0
frames 2
halt_state 0
via table
bp_list 0
watch_list
framelog_list
freeze_list
coverage_op 0 5 -
profile_op 0 3 -
close
